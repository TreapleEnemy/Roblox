return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">Models</string><ProtectedString name="Source"><![CDATA[-- GladeSlayer: процедурные 3D-модели из Part/WedgePart/WeldConstraint — без мешей и ассетов.
-- Предметы (мечи, броня, амулеты, зелья, хлам), мобы (Слизень, Страж руин) и NPC (Скупщик, Кузнец).
-- Риги мобов/NPC используют имена суставов R6 (RootJoint, Neck, Right Shoulder...), поэтому их
-- анимирует тот же Animator, что и игроков. Все суставы без поворота в C0: поза задаётся в пространстве торса.
local Config = require(script.Parent:WaitForChild("Config"))

local Models = {}

local V3 = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local RAD = math.rad
local M = Enum.Material
local rgb = Color3.fromRGB

local function shade(color, factor)
	return Color3.new(math.clamp(color.R * factor, 0, 1), math.clamp(color.G * factor, 0, 1), math.clamp(color.B * factor, 0, 1))
end
Models.Shade = shade

-- Цилиндр Roblox вытянут по X: UPRIGHT ставит его вертикально, FACING — вдоль Z (вперёд).
local UPRIGHT = ANG(0, 0, RAD(90))
local FACING = ANG(0, RAD(90), 0)
Models.UPRIGHT = UPRIGHT
Models.FACING = FACING

local function make(className, model, name, size, cframe, color, material, props)
	local p = Instance.new(className)
	p.Name = name
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanTouch = false
	p.Massless = true
	if props then
		for key, value in pairs(props) do
			p[key] = value
		end
	end
	p.Parent = model
	return p
end

local function block(model, name, size, cframe, color, material, props)
	return make("Part", model, name, size, cframe, color, material, props)
end

local function wedge(model, name, size, cframe, color, material, props)
	return make("WedgePart", model, name, size, cframe, color, material, props)
end

local function ball(model, name, d, cframe, color, material, props)
	local p = make("Part", model, name, V3(d, d, d), cframe, color, material, props)
	p.Shape = Enum.PartType.Ball
	return p
end

local function cylinder(model, name, length, d, cframe, color, material, props)
	local p = make("Part", model, name, V3(length, d, d), cframe, color, material, props)
	p.Shape = Enum.PartType.Cylinder
	return p
end

local function weld(a, b)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = b
	return w
end
Models.Weld = weld

-- Приваривает все детали модели к опорной детали.
local function weldAll(model, root)
	for _, item in ipairs(model:GetDescendants()) do
		if item:IsA("BasePart") and item ~= root then
			weld(root, item)
		end
	end
end

-- Приваривает список деталей к одной (для частей рига, двигающихся вместе с конечностью).
local function weldGroup(list, anchor)
	for _, item in ipairs(list) do
		if item ~= anchor then
			weld(anchor, item)
		end
	end
end

local function motor(name, part0, part1, c0, c1)
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = part0
	m.Part1 = part1
	m.C0 = c0
	m.C1 = c1
	m.Parent = part0
	return m
end

-- Предметы -------------------------------------------------------------------------------------
local SWORDS = {
	OldSword = { Blade = rgb(132, 120, 104), Edge = rgb(160, 128, 96), Guard = rgb(92, 74, 56), Grip = rgb(88, 58, 38), Length = 3.2, Width = 0.32, Trail = rgb(200, 160, 120), Rust = true },
	IronSword = { Blade = rgb(196, 204, 214), Edge = rgb(236, 240, 246), Guard = rgb(110, 114, 124), Grip = rgb(70, 46, 30), Length = 3.8, Width = 0.36, Trail = rgb(220, 232, 255) },
	KnightBlade = { Blade = rgb(214, 224, 238), Edge = rgb(250, 252, 255), Guard = rgb(230, 186, 80), Grip = rgb(40, 52, 110), Length = 4.6, Width = 0.4, Trail = rgb(120, 180, 255), Gem = rgb(70, 140, 255) },
}

function Models.SwordTrailColor(itemId)
	local spec = SWORDS[itemId]
	return spec and spec.Trail or rgb(255, 255, 255)
end

-- Меч: рукоять в начале координат, клинок смотрит вдоль -Z (вперёд от кисти).
local function buildSword(itemId)
	local spec = SWORDS[itemId] or SWORDS.OldSword
	local model = Instance.new("Model")
	model.Name = itemId
	local handle = cylinder(model, "Handle", 1.1, 0.26, CF(0, 0, 0.1) * FACING, spec.Grip, M.Fabric)
	ball(model, "Pommel", 0.38, CF(0, 0, 0.72), spec.Guard, M.Metal)
	block(model, "Guard", V3(1.3, 0.22, 0.26), CF(0, 0, -0.5), spec.Guard, M.Metal)
	block(model, "GuardCore", V3(0.4, 0.34, 0.34), CF(0, 0, -0.5), shade(spec.Guard, 0.8), M.Metal)
	local length = spec.Length
	local bladeZ = -0.62 - length / 2
	local bladeMat = spec.Material or M.Metal
	local edgeMat = spec.EdgeMaterial or M.Metal
	local bladeProps = spec.Transparency and { Transparency = spec.Transparency } or nil
	if spec.Curve then
		-- Хопеш: клинок из наклонных сегментов, изгибающихся в сторону.
		local segs = 5
		local segLen = length / segs
		for i = 1, segs do
			local bend = (i / segs) ^ 2 * 0.9
			local z = -0.62 - segLen * (i - 0.5)
			local angle = RAD(-8 - i * 3)
			block(model, "Blade", V3(spec.Width, 0.08, segLen * 1.15), CF(bend, 0, z) * ANG(0, angle, 0), spec.Blade, bladeMat, bladeProps)
			block(model, "EdgeR", V3(0.06, 0.06, segLen * 1.15), CF(bend + spec.Width / 2, 0, z) * ANG(0, angle, 0), spec.Edge, edgeMat)
		end
		block(model, "CurveTip", V3(spec.Width * 0.7, 0.08, 0.5), CF(1.05, 0, -0.62 - length - 0.1) * ANG(0, RAD(-52), 0), spec.Edge, edgeMat)
	else
		block(model, "Blade", V3(spec.Width, 0.08, length), CF(0, 0, bladeZ), spec.Blade, bladeMat, bladeProps)
		block(model, "Fuller", V3(spec.Width * 0.3, 0.1, length * 0.8), CF(0, 0, bladeZ + length * 0.05), shade(spec.Blade, 0.75), bladeMat, bladeProps)
		block(model, "EdgeL", V3(0.06, 0.06, length), CF(-spec.Width / 2, 0, bladeZ), spec.Edge, edgeMat)
		block(model, "EdgeR", V3(0.06, 0.06, length), CF(spec.Width / 2, 0, bladeZ), spec.Edge, edgeMat)
	end
	if spec.Glow then
		block(model, "GlowCore", V3(spec.Width * 0.22, 0.12, length * 0.9), CF(0, 0, bladeZ), spec.Glow, M.Neon)
	end
	if spec.Teeth then
		for i = 1, 4 do
			block(model, "Tooth", V3(0.12, 0.1, 0.28), CF(spec.Width / 2 + 0.07, 0, -0.9 - i * length / 5) * ANG(0, RAD(30), 0), spec.Blade, bladeMat)
		end
	end
	if spec.Runes then
		for i = 1, 5 do
			block(model, "Rune", V3(spec.Width * 0.5, 0.13, 0.16), CF(0, 0, -1.0 - i * length / 6.5) * ANG(0, RAD(i % 2 * 40 - 20), 0), spec.Runes[i % #spec.Runes + 1], M.Neon)
		end
		for _, side in ipairs({ -1, 1 }) do
			wedge(model, "Wing", V3(0.1, 0.5, 0.9), CF(side * 0.85, 0, -0.5) * ANG(0, 0, RAD(side * 90)), spec.Edge, spec.EdgeMaterial or M.Metal)
		end
	end
	if not spec.Curve then
		wedge(model, "TipL", V3(0.08, spec.Width / 2, 0.6), CF(-spec.Width / 4, 0, -0.62 - length - 0.3) * ANG(0, 0, RAD(90)), spec.Edge, edgeMat)
		wedge(model, "TipR", V3(0.08, spec.Width / 2, 0.6), CF(spec.Width / 4, 0, -0.62 - length - 0.3) * ANG(0, 0, RAD(-90)), spec.Edge, edgeMat)
	end
	if spec.Rust then
		for i = 1, 3 do
			block(model, "Rust", V3(spec.Width * 0.55, 0.1, 0.35), CF((i % 2 - 0.5) * 0.08, 0, -1.0 - i * 0.75), rgb(140, 78, 40), M.CorrodedMetal)
		end
		wedge(model, "Notch", V3(0.1, 0.16, 0.22), CF(spec.Width / 2, 0, -2.1) * ANG(0, 0, RAD(90)), rgb(60, 50, 44), M.Metal)
	end
	if spec.Gem then
		ball(model, "Gem", 0.3, CF(0, 0, -0.5), spec.Gem, M.Neon)
		block(model, "GuardTipL", V3(0.24, 0.24, 0.24), CF(-0.66, 0, -0.5) * ANG(0, RAD(45), 0), spec.Guard, M.Metal)
		block(model, "GuardTipR", V3(0.24, 0.24, 0.24), CF(0.66, 0, -0.5) * ANG(0, RAD(45), 0), spec.Guard, M.Metal)
	end
	model.PrimaryPart = handle
	weldAll(model, handle)
	model:SetAttribute("ItemId", itemId)
	return model
end

SWORDS.DuneBlade = { Blade = rgb(240, 208, 135), Edge = rgb(255, 245, 210), Guard = rgb(170, 116, 42), Grip = rgb(85, 60, 40), Length = 4.7, Width = 0.48, Trail = rgb(255, 221, 105), Gem = rgb(255, 216, 90) }
SWORDS.ObsidianBlade = { Blade = rgb(45, 35, 63), Edge = rgb(235, 96, 62), Guard = rgb(85, 65, 100), Grip = rgb(40, 28, 35), Length = 5, Width = 0.52, Trail = rgb(255, 100, 55), Gem = rgb(255, 80, 30) }
SWORDS.Cataclysm = { Blade = rgb(94, 48, 40), Edge = rgb(255, 211, 92), Guard = rgb(246, 181, 52), Grip = rgb(64, 26, 35), Length = 5.4, Width = 0.6, Trail = rgb(255, 194, 54), Gem = rgb(255, 234, 126) }
SWORDS.BoneCleaver = { Blade = rgb(228, 222, 204), Edge = rgb(250, 246, 232), Guard = rgb(120, 108, 92), Grip = rgb(70, 54, 40), Length = 3.6, Width = 0.95, Trail = rgb(235, 230, 210), Teeth = true }
SWORDS.PharaohKhopesh = { Blade = rgb(236, 190, 60), Edge = rgb(255, 240, 160), Guard = rgb(40, 90, 160), Grip = rgb(60, 40, 90), Length = 4.2, Width = 0.5, Trail = rgb(255, 214, 90), Curve = true, Gem = rgb(60, 200, 255) }
SWORDS.ForgeBlade = { Blade = rgb(40, 36, 44), Edge = rgb(255, 120, 30), Guard = rgb(70, 60, 66), Grip = rgb(34, 24, 24), Length = 5.0, Width = 0.58, Trail = rgb(255, 130, 40), EdgeMaterial = M.Neon, Gem = rgb(255, 150, 40) }
SWORDS.FrostBlade = { Blade = rgb(150, 215, 255), Edge = rgb(225, 248, 255), Guard = rgb(110, 170, 220), Grip = rgb(36, 60, 100), Length = 5.2, Width = 0.58, Trail = rgb(140, 220, 255), Material = M.Glass, Transparency = 0.35, EdgeMaterial = M.Neon, Glow = rgb(120, 220, 255), Gem = rgb(160, 240, 255) }
SWORDS.EternalWinter = { Blade = rgb(214, 240, 255), Edge = rgb(255, 255, 255), Guard = rgb(130, 200, 255), Grip = rgb(30, 40, 90), Length = 6.2, Width = 0.7, Trail = rgb(255, 150, 240), Material = M.Glass, Transparency = 0.25, EdgeMaterial = M.Neon, Glow = rgb(150, 235, 255), Gem = rgb(255, 110, 220), Runes = { rgb(255, 110, 220), rgb(110, 240, 255) } }
local ARMORS = {
	BeggarRags = { Main = rgb(150, 126, 96), Trim = rgb(110, 84, 56), Material = M.Fabric, Belt = rgb(170, 140, 90), Patches = true },
	LeatherVest = { Main = rgb(120, 74, 42), Trim = rgb(84, 50, 28), Material = M.Leather, Belt = rgb(60, 40, 26), Pads = rgb(100, 62, 36) },
	ChainMail = { Main = rgb(150, 156, 166), Trim = rgb(110, 116, 128), Material = M.DiamondPlate, Belt = rgb(70, 50, 34), Pads = rgb(190, 196, 206) },
	AshenPlate = { Main = rgb(30, 28, 34), Trim = rgb(60, 52, 58), Material = M.Basalt, Belt = rgb(255, 110, 30), Pads = rgb(48, 42, 52), Glow = rgb(255, 110, 30), Spikes = true },
	CitadelPlate = { Main = rgb(70, 110, 170), Trim = rgb(150, 190, 235), Material = M.DiamondPlate, Belt = rgb(40, 56, 96), Pads = rgb(110, 160, 220), Glow = rgb(120, 220, 255), Emblem = true },
}

-- Броня: «Handle» совпадает с центром торса (torsoSize — размер торса/UpperTorso носителя).
local function buildArmor(itemId, torsoSize)
	local spec = ARMORS[itemId] or ARMORS.BeggarRags
	local t = torsoSize or V3(2, 2, 1)
	local model = Instance.new("Model")
	model.Name = itemId
	local handle = block(model, "Handle", V3(t.X + 0.12, t.Y * 0.92, t.Z + 0.12), CF(0, 0, 0), spec.Main, spec.Material)
	block(model, "Belt", V3(t.X + 0.18, t.Y * 0.14, t.Z + 0.18), CF(0, -t.Y * 0.32, 0), spec.Belt, M.Leather)
	block(model, "Buckle", V3(0.36, t.Y * 0.16, 0.1), CF(0, -t.Y * 0.32, -t.Z / 2 - 0.1), rgb(200, 170, 90), M.Metal)
	block(model, "Collar", V3(t.X * 0.6, t.Y * 0.1, t.Z + 0.16), CF(0, t.Y * 0.44, 0), spec.Trim, spec.Material)
	if spec.Patches then
		block(model, "Patch", V3(0.5, 0.5, 0.06), CF(-t.X * 0.22, t.Y * 0.1, -t.Z / 2 - 0.08) * ANG(0, 0, RAD(12)), rgb(120, 140, 110), M.Fabric)
		block(model, "Patch", V3(0.4, 0.36, 0.06), CF(t.X * 0.25, -t.Y * 0.08, -t.Z / 2 - 0.08) * ANG(0, 0, RAD(-8)), rgb(170, 110, 90), M.Fabric)
		block(model, "Rope", V3(0.1, t.Y * 0.4, 0.08), CF(t.X * 0.1, -t.Y * 0.5, -t.Z / 2 - 0.12), rgb(196, 170, 120), M.Fabric)
	end
	if spec.Pads then
		for _, side in ipairs({ -1, 1 }) do
			block(model, "Pauldron", V3(t.X * 0.42, t.Y * 0.2, t.Z + 0.4), CF(side * t.X * 0.52, t.Y * 0.46, 0) * ANG(0, 0, RAD(-side * 14)), spec.Pads, M.Metal)
		end
	end
	if spec.Spikes then
		for _, side in ipairs({ -1, 1 }) do
			wedge(model, "Spike", V3(0.2, t.Y * 0.32, 0.3), CF(side * t.X * 0.6, t.Y * 0.66, 0) * ANG(0, 0, RAD(-side * 20)), spec.Trim, M.Metal)
		end
	end
	if spec.Glow then
		block(model, "GlowVein", V3(0.1, t.Y * 0.5, 0.06), CF(0, t.Y * 0.05, -t.Z / 2 - 0.1), spec.Glow, M.Neon)
		block(model, "GlowBar", V3(t.X * 0.55, 0.1, 0.06), CF(0, t.Y * 0.18, -t.Z / 2 - 0.1), spec.Glow, M.Neon)
	end
	if spec.Emblem then
		for _, side in ipairs({ -1, 1 }) do
			block(model, "Plate", V3(t.X * 0.38, t.Y * 0.4, 0.08), CF(side * t.X * 0.24, -t.Y * 0.05, -t.Z / 2 - 0.1), spec.Trim, M.Metal)
		end
	end
	model.PrimaryPart = handle
	weldAll(model, handle)
	model:SetAttribute("ItemId", itemId)
	return model
end

local AMULETS = {
	BeggarAmulet = { Chain = rgb(150, 120, 80), Medal = rgb(120, 100, 70), Stone = rgb(90, 110, 80) },
	HunterCharm = { Chain = rgb(230, 190, 80), Medal = rgb(240, 206, 110), Stone = rgb(170, 90, 255), Fang = true },
	BoneCharm = { Chain = rgb(150, 130, 100), Medal = rgb(200, 190, 170), Stone = rgb(110, 255, 140), Skull = true },
	SandKingMask = { Chain = rgb(230, 190, 80), Medal = rgb(240, 200, 90), Stone = rgb(80, 220, 255), Mask = true },
	WinterRune = { Chain = rgb(170, 210, 240), Medal = rgb(120, 170, 220), Stone = rgb(150, 235, 255), Crystal = true },
}

-- Амулет висит на груди: «Handle» — центр торса, медальон спереди.
local function buildAccessory(itemId, torsoSize)
	local spec = AMULETS[itemId] or AMULETS.BeggarAmulet
	local t = torsoSize or V3(2, 2, 1)
	local model = Instance.new("Model")
	model.Name = itemId
	local handle = block(model, "Handle", V3(0.2, 0.2, 0.2), CF(0, 0, 0), spec.Chain, M.Metal, { Transparency = 1 })
	local front = -t.Z / 2 - 0.12
	block(model, "ChainL", V3(0.08, t.Y * 0.45, 0.08), CF(-t.X * 0.16, t.Y * 0.22, front) * ANG(0, 0, RAD(-24)), spec.Chain, M.Metal)
	block(model, "ChainR", V3(0.08, t.Y * 0.45, 0.08), CF(t.X * 0.16, t.Y * 0.22, front) * ANG(0, 0, RAD(24)), spec.Chain, M.Metal)
	cylinder(model, "Medal", 0.1, 0.62, CF(0, -0.02, front) * FACING, spec.Medal, M.Metal)
	ball(model, "Stone", 0.26, CF(0, -0.02, front - 0.08), spec.Stone, M.Neon)
	if spec.Skull then
		ball(model, "Skull", 0.5, CF(0, -0.02, front - 0.2), rgb(236, 230, 212), M.SmoothPlastic)
		block(model, "Jaw", V3(0.3, 0.14, 0.26), CF(0, -0.26, front - 0.2), rgb(220, 214, 196), M.SmoothPlastic)
		block(model, "SocketL", V3(0.12, 0.12, 0.06), CF(-0.1, 0, front - 0.43), rgb(20, 18, 20), M.SmoothPlastic)
		block(model, "SocketR", V3(0.12, 0.12, 0.06), CF(0.1, 0, front - 0.43), rgb(20, 18, 20), M.SmoothPlastic)
	end
	if spec.Mask then
		block(model, "MaskFace", V3(0.9, 1.0, 0.1), CF(0, -0.1, front - 0.1), spec.Medal, M.Metal)
		block(model, "MaskStripeA", V3(0.9, 0.12, 0.12), CF(0, 0.2, front - 0.16), rgb(40, 90, 170), M.Metal)
		block(model, "MaskStripeB", V3(0.9, 0.12, 0.12), CF(0, -0.15, front - 0.16), rgb(40, 90, 170), M.Metal)
		block(model, "EyeL", V3(0.16, 0.08, 0.06), CF(-0.2, 0.05, front - 0.2), spec.Stone, M.Neon)
		block(model, "EyeR", V3(0.16, 0.08, 0.06), CF(0.2, 0.05, front - 0.2), spec.Stone, M.Neon)
		wedge(model, "Beard", V3(0.2, 0.6, 0.12), CF(0, -0.8, front - 0.12) * ANG(RAD(180), 0, 0), spec.Medal, M.Metal)
	end
	if spec.Crystal then
		for i = -1, 1 do
			wedge(model, "IceShard", V3(0.16, 0.5 + (1 - math.abs(i)) * 0.35, 0.2), CF(i * 0.2, 0.05 + (1 - math.abs(i)) * 0.1, front - 0.2) * ANG(0, 0, RAD(-i * 14)), spec.Stone, M.Glass, { Transparency = 0.25 })
		end
	end
	if spec.Fang then
		wedge(model, "Fang", V3(0.12, 0.42, 0.16), CF(0, -0.46, front) * ANG(RAD(180), 0, 0), rgb(240, 236, 220), M.SmoothPlastic)
		cylinder(model, "Inner", 0.15, 0.66, CF(0, -0.02, front + 0.02) * FACING, rgb(190, 146, 52), M.Metal)
	end
	model.PrimaryPart = handle
	weldAll(model, handle)
	model:SetAttribute("ItemId", itemId)
	return model
end

local POTIONS = {
	CoinPotion = rgb(255, 204, 70),
	RagePotion = rgb(255, 70, 70),
	WisdomPotion = rgb(90, 140, 255),
}

local function buildPotion(itemId)
	local color = POTIONS[itemId] or rgb(200, 200, 200)
	local model = Instance.new("Model")
	model.Name = itemId
	local handle = ball(model, "Handle", 0.9, CF(0, 0, 0), rgb(220, 240, 255), M.Glass, { Transparency = 0.45 })
	ball(model, "Liquid", 0.72, CF(0, -0.05, 0), color, M.Neon)
	cylinder(model, "Neck", 0.4, 0.3, CF(0, 0.55, 0) * UPRIGHT, rgb(220, 240, 255), M.Glass, { Transparency = 0.45 })
	cylinder(model, "Cork", 0.22, 0.26, CF(0, 0.82, 0) * UPRIGHT, rgb(150, 100, 60), M.Wood)
	model.PrimaryPart = handle
	weldAll(model, handle)
	model:SetAttribute("ItemId", itemId)
	return model
end

local function buildTrash(itemId)
	local model = Instance.new("Model")
	model.Name = itemId
	local handle
	if itemId == "SlimeGel" then
		handle = ball(model, "Handle", 0.7, CF(0, 0, 0), rgb(110, 220, 90), M.Glass, { Transparency = 0.2 })
		ball(model, "Drop", 0.36, CF(0.28, -0.12, 0.1), rgb(130, 240, 110), M.Glass, { Transparency = 0.2 })
	elseif itemId == "MossyPebble" then
		handle = ball(model, "Handle", 0.7, CF(0, 0, 0), rgb(120, 120, 116), M.Slate)
		block(model, "Moss", V3(0.5, 0.12, 0.5), CF(0, 0.3, 0), rgb(90, 150, 60), M.Grass)
	elseif itemId == "GuardianShard" then
		handle = wedge(model, "Handle", V3(0.3, 0.9, 0.6), CF(0, 0, 0), rgb(110, 116, 126), M.Slate)
		block(model, "Rune", V3(0.32, 0.3, 0.08), CF(0, -0.1, 0.05), rgb(90, 220, 255), M.Neon)
	elseif itemId == "BoneDust" then
		handle = ball(model, "Handle", 0.7, CF(0, -0.1, 0), rgb(170, 168, 162), M.Sand)
		ball(model, "Mound", 0.5, CF(0.25, -0.2, 0.1), rgb(150, 148, 142), M.Sand)
		ball(model, "Mound", 0.4, CF(-0.25, -0.22, -0.1), rgb(186, 184, 176), M.Sand)
		block(model, "Splinter", V3(0.08, 0.08, 0.4), CF(0, 0.25, 0) * ANG(RAD(20), RAD(40), 0), rgb(232, 226, 210), M.SmoothPlastic)
	elseif itemId == "FrostShard" then
		handle = wedge(model, "Handle", V3(0.36, 1.0, 0.36), CF(0, 0, 0), rgb(160, 225, 255), M.Glass, { Transparency = 0.2 })
		wedge(model, "Side", V3(0.26, 0.6, 0.26), CF(0.22, -0.2, 0.05) * ANG(0, RAD(60), RAD(-18)), rgb(190, 240, 255), M.Glass, { Transparency = 0.25 })
		block(model, "Glint", V3(0.1, 0.4, 0.1), CF(0, 0, -0.15), rgb(220, 250, 255), M.Neon, { Transparency = 0.3 })
	elseif itemId == "GlacialHeart" then
		handle = ball(model, "Handle", 0.95, CF(0, 0, 0), rgb(180, 230, 255), M.Ice, { Transparency = 0.45 })
		ball(model, "Core", 0.5, CF(0, 0, 0), rgb(60, 150, 255), M.Neon)
		wedge(model, "Spike", V3(0.2, 0.5, 0.2), CF(0, 0.6, 0), rgb(200, 240, 255), M.Ice, { Transparency = 0.3 })
		wedge(model, "Spike", V3(0.2, 0.4, 0.2), CF(0.45, 0.3, 0) * ANG(0, 0, RAD(-50)), rgb(200, 240, 255), M.Ice, { Transparency = 0.3 })
	elseif itemId == "VoidEssence" then
		handle = ball(model, "Handle", 0.95, CF(0, 0, 0), rgb(220, 200, 255), M.Glass, { Transparency = 0.55 })
		ball(model, "Orb", 0.52, CF(0, 0, 0), rgb(150, 50, 230), M.Neon)
		ball(model, "Mote", 0.14, CF(0.25, 0.2, 0.15), rgb(230, 170, 255), M.Neon)
		cylinder(model, "Base", 0.14, 0.7, CF(0, -0.5, 0) * UPRIGHT, rgb(60, 40, 90), M.Metal)
	else
		handle = cylinder(model, "Handle", 0.12, 0.66, CF(0, 0, 0) * FACING, rgb(214, 170, 60), M.Metal)
		cylinder(model, "Inner", 0.15, 0.66, CF() * FACING, rgb(190, 146, 52), M.Metal)
		block(model, "CrownBase", V3(0.34, 0.08, 0.17), CF(0, -0.06, 0), rgb(240, 206, 110), M.Metal)
		for i = -1, 1 do
			block(model, "CrownTooth", V3(0.07, 0.16, 0.17), CF(i * 0.13, 0.05, 0), rgb(240, 206, 110), M.Metal)
		end
	end
	model.PrimaryPart = handle
	weldAll(model, handle)
	model:SetAttribute("ItemId", itemId)
	return model
end

-- Публичный API предметов ----------------------------------------------------------------
function Models.BuildItem(itemId, torsoSize)
	local def = Config.Items[itemId]
	if not def then
		return nil
	end
	if def.Kind == "Gear" then
		if def.Slot == "Weapon" then
			return buildSword(itemId)
		elseif def.Slot == "Armor" then
			return buildArmor(itemId, torsoSize)
		end
		return buildAccessory(itemId, torsoSize)
	end
	if def.Kind == "Potion" then
		return buildPotion(itemId)
	end
	return buildTrash(itemId)
end

-- Все части модели неподвижные и не мешают физике (для витрин и декора).
function Models.Anchor(model)
	for _, item in ipairs(model:GetDescendants()) do
		if item:IsA("BasePart") then
			item.Anchored = true
			item.CanCollide = false
			item.CanQuery = false
			item.CanTouch = false
		end
	end
	return model
end

-- Риги ----------------------------------------------------------------------------------------
local function newRig(name, rootSize)
	local model = Instance.new("Model")
	model.Name = name
	local root = block(model, "HumanoidRootPart", rootSize, CF(0, 0, 0), rgb(255, 255, 255), M.SmoothPlastic, { Transparency = 1, Massless = false, CanCollide = true })
	model.PrimaryPart = root
	return model, root
end

local function addHumanoid(model, hipHeight, displayName)
	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.HipHeight = hipHeight
	humanoid.DisplayName = displayName or model.Name
	humanoid.Parent = model
	local animator = Instance.new("Animator")
	animator.Parent = humanoid
	return humanoid
end

-- Гуманоидный риг с суставами R6. spec: Scale, Skin, Shirt, Pants, Name. Возвращает model, parts.
local function humanoidRig(name, spec)
	local s = spec.Scale or 1
	local torsoSize = V3(2, 2, 1) * s
	local model, root = newRig(name, torsoSize)
	local torso = block(model, "Torso", torsoSize, CF(0, 0, 0), spec.Shirt, spec.ShirtMaterial or M.Fabric)
	local head = block(model, "Head", V3(1.2, 1.2, 1.2) * s, CF(0, 1.6 * s, 0), spec.Skin, spec.SkinMaterial or M.SmoothPlastic)
	local armSize = V3(1, 2, 1) * s
	local legSize = V3(1, 2, 1) * s
	local rightArm = block(model, "Right Arm", armSize, CF(1.5 * s, 0, 0), spec.Sleeve or spec.Shirt, spec.ShirtMaterial or M.Fabric)
	local leftArm = block(model, "Left Arm", armSize, CF(-1.5 * s, 0, 0), spec.Sleeve or spec.Shirt, spec.ShirtMaterial or M.Fabric)
	local rightLeg = block(model, "Right Leg", legSize, CF(0.5 * s, -2 * s, 0), spec.Pants, spec.PantsMaterial or M.Fabric)
	local leftLeg = block(model, "Left Leg", legSize, CF(-0.5 * s, -2 * s, 0), spec.Pants, spec.PantsMaterial or M.Fabric)
	motor("RootJoint", root, torso, CF(), CF())
	motor("Neck", torso, head, CF(0, 1 * s, 0), CF(0, -0.6 * s, 0))
	motor("Right Shoulder", torso, rightArm, CF(1 * s, 0.5 * s, 0), CF(-0.5 * s, 0.5 * s, 0))
	motor("Left Shoulder", torso, leftArm, CF(-1 * s, 0.5 * s, 0), CF(0.5 * s, 0.5 * s, 0))
	motor("Right Hip", torso, rightLeg, CF(0.5 * s, -1 * s, 0), CF(0, 1 * s, 0))
	motor("Left Hip", torso, leftLeg, CF(-0.5 * s, -1 * s, 0), CF(0, 1 * s, 0))
	return model, {
		Root = root, Torso = torso, Head = head, RightArm = rightArm, LeftArm = leftArm,
		RightLeg = rightLeg, LeftLeg = leftLeg, Scale = s,
	}
end

local function face(head, s, eyeColor, browColor)
	local eyes = {}
	for _, side in ipairs({ -1, 1 }) do
		table.insert(eyes, block(head.Parent, "Eye", V3(0.16, 0.2, 0.05) * s, head.CFrame * CF(side * 0.25 * s, 0.1 * s, -0.6 * s), eyeColor, M.SmoothPlastic))
		if browColor then
			table.insert(eyes, block(head.Parent, "Brow", V3(0.3, 0.08, 0.05) * s, head.CFrame * CF(side * 0.25 * s, 0.3 * s, -0.6 * s) * ANG(0, 0, RAD(side * -10)), browColor, M.SmoothPlastic))
		end
	end
	return eyes
end

-- Мобы ----------------------------------------------------------------------------------------
-- Слизень: невидимый корень + желейное тело на суставе «Body» со SpecialMesh «SquashMesh» (сжатие/растяжение).
local function buildSlime(modelId, def, scale)
	local k = scale or 1
	local model, root = newRig(modelId, V3(2.6, 2.2, 2.6) * k)
	local green = rgb(96, 206, 92)
	local king = def.Boss == true
	if king then
		green = rgb(110, 214, 120)
	end
	local body = block(model, "Body", V3(3.4, 2.6, 3.4) * k, CF(0, 0.1 * k, 0), green, M.Glass, { Transparency = 0.18 })
	local mesh = Instance.new("SpecialMesh")
	mesh.Name = "SquashMesh"
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = body
	motor("Body", root, body, CF(0, 0.1 * k, 0), CF())
	local coreColor = king and rgb(255, 214, 80) or shade(green, 0.6)
	local parts = {
		ball(model, "Core", 1.2 * k, CF(0, -0.1 * k, 0.2 * k), coreColor, M.Neon, { Transparency = king and 0.15 or 0.4 }),
		ball(model, "EyeL", 0.62 * k, CF(-0.55 * k, 0.45 * k, -1.35 * k), rgb(255, 255, 255), M.SmoothPlastic),
		ball(model, "EyeR", 0.62 * k, CF(0.55 * k, 0.45 * k, -1.35 * k), rgb(255, 255, 255), M.SmoothPlastic),
		ball(model, "PupilL", 0.3 * k, CF(-0.55 * k, 0.42 * k, -1.62 * k), rgb(20, 24, 20), M.SmoothPlastic),
		ball(model, "PupilR", 0.3 * k, CF(0.55 * k, 0.42 * k, -1.62 * k), rgb(20, 24, 20), M.SmoothPlastic),
		block(model, "Mouth", V3(0.7, 0.12, 0.1) * k, CF(0, -0.15 * k, -1.62 * k), rgb(30, 70, 30), M.SmoothPlastic),
	}
	if king then
		local gold = rgb(255, 205, 60)
		table.insert(parts, cylinder(model, "CrownBand", 0.5 * k, 1.9 * k, CF(0, 1.35 * k, 0) * UPRIGHT, gold, M.Metal))
		for i = 0, 5 do
			local a = i / 6 * math.pi * 2
			table.insert(parts, wedge(model, "CrownSpike", V3(0.3, 0.7, 0.3) * k, CF(math.cos(a) * 0.85 * k, 1.95 * k, math.sin(a) * 0.85 * k) * ANG(0, -a, 0), gold, M.Metal))
		end
		table.insert(parts, ball(model, "CrownGem", 0.4 * k, CF(0, 1.4 * k, -0.95 * k), rgb(255, 60, 90), M.Neon))
	else
		table.insert(parts, ball(model, "Leaf", 0.5 * k, CF(0.3 * k, 1.3 * k, 0.1 * k), rgb(70, 140, 50), M.Grass))
		table.insert(parts, block(model, "Stem", V3(0.12, 0.4, 0.12) * k, CF(0.2 * k, 1.25 * k, 0.1 * k) * ANG(0, 0, RAD(20)), rgb(90, 70, 40), M.Wood))
	end
	weldGroup(parts, body)
	addHumanoid(model, def.HipHeight, def.Name)
	return model
end

-- Страж руин: каменный голем с мхом и светящимися рунами.
local function buildGuardian(modelId, def, scale)
	local stone = rgb(118, 122, 128)
	local model, p = humanoidRig(modelId, {
		Scale = 1.5 * (scale or 1),
		Skin = shade(stone, 1.05), SkinMaterial = M.Slate,
		Shirt = stone, ShirtMaterial = M.Slate,
		Pants = shade(stone, 0.85), PantsMaterial = M.Slate,
	})
	local s = p.Scale
	local rune = rgb(90, 220, 255)
	local moss = rgb(86, 140, 60)
	local torsoParts = {
		block(model, "Chest", V3(2.3, 1.2, 1.3) * s, p.Torso.CFrame * CF(0, 0.4 * s, 0), shade(stone, 1.1), M.Slate),
		block(model, "RuneChest", V3(0.5, 0.5, 0.06) * s, p.Torso.CFrame * CF(0, 0.35 * s, -0.66 * s) * ANG(0, 0, RAD(45)), rune, M.Neon),
		block(model, "MossBack", V3(1.6, 0.3, 0.6) * s, p.Torso.CFrame * CF(0, 1.0 * s, 0.4 * s), moss, M.Grass),
		block(model, "Belt", V3(2.1, 0.3, 1.1) * s, p.Torso.CFrame * CF(0, -0.85 * s, 0), shade(stone, 0.7), M.Cobblestone),
	}
	weldGroup(torsoParts, p.Torso)
	local headParts = {
		block(model, "Brow", V3(1.3, 0.3, 0.4) * s, p.Head.CFrame * CF(0, 0.3 * s, -0.5 * s), shade(stone, 0.8), M.Slate),
		block(model, "EyeL", V3(0.3, 0.14, 0.08) * s, p.Head.CFrame * CF(-0.28 * s, 0.05 * s, -0.62 * s), rune, M.Neon),
		block(model, "EyeR", V3(0.3, 0.14, 0.08) * s, p.Head.CFrame * CF(0.28 * s, 0.05 * s, -0.62 * s), rune, M.Neon),
		wedge(model, "HornL", V3(0.2, 0.6, 0.3) * s, p.Head.CFrame * CF(-0.5 * s, 0.75 * s, 0) * ANG(0, 0, RAD(20)), shade(stone, 0.7), M.Slate),
		wedge(model, "HornR", V3(0.2, 0.6, 0.3) * s, p.Head.CFrame * CF(0.5 * s, 0.75 * s, 0) * ANG(0, 0, RAD(-20)), shade(stone, 0.7), M.Slate),
	}
	weldGroup(headParts, p.Head)
	for _, arm in ipairs({ p.RightArm, p.LeftArm }) do
		local side = arm == p.RightArm and 1 or -1
		weldGroup({
			block(model, "Shoulder", V3(1.4, 0.8, 1.4) * s, arm.CFrame * CF(side * 0.1 * s, 0.75 * s, 0), shade(stone, 1.1), M.Slate),
			block(model, "Fist", V3(1.4, 1.0, 1.4) * s, arm.CFrame * CF(0, -1.05 * s, 0), shade(stone, 0.9), M.Slate),
			block(model, "RuneArm", V3(0.06, 0.4, 0.4) * s, arm.CFrame * CF(side * 0.52 * s, 0, 0), rune, M.Neon),
			block(model, "Moss", V3(0.9, 0.2, 0.9) * s, arm.CFrame * CF(0, 1.2 * s, 0), moss, M.Grass),
		}, arm)
	end
	for _, leg in ipairs({ p.RightLeg, p.LeftLeg }) do
		weldGroup({ block(model, "Foot", V3(1.2, 0.5, 1.5) * s, leg.CFrame * CF(0, -0.8 * s, -0.15 * s), shade(stone, 0.75), M.Slate) }, leg)
	end
	local glow = Instance.new("PointLight")
	glow.Color = rune
	glow.Range = 8
	glow.Brightness = 1.2
	glow.Parent = p.Torso
	addHumanoid(model, def.HipHeight, def.Name)
	return model
end

-- NPC -----------------------------------------------------------------------------------------
local function buildMerchant()
	local model, p = humanoidRig("Merchant", {
		Skin = rgb(234, 190, 150),
		Shirt = rgb(70, 110, 80), Sleeve = rgb(60, 96, 70),
		Pants = rgb(80, 64, 52),
	})
	face(p.Head, 1, rgb(30, 30, 30), rgb(120, 80, 50))
	local headParts = {
		cylinder(model, "HatBrim", 0.12, 2.0, p.Head.CFrame * CF(0, 0.62, 0) * UPRIGHT, rgb(110, 76, 44), M.Fabric),
		cylinder(model, "HatTop", 0.6, 1.2, p.Head.CFrame * CF(0, 0.95, 0) * UPRIGHT, rgb(120, 84, 50), M.Fabric),
		block(model, "HatBand", V3(1.22, 0.14, 1.22), p.Head.CFrame * CF(0, 0.75, 0), rgb(200, 60, 50), M.Fabric),
		block(model, "Beard", V3(1.0, 0.6, 0.3), p.Head.CFrame * CF(0, -0.45, -0.5), rgb(130, 90, 60), M.Fabric),
	}
	for _, item in ipairs(p.Head.Parent:GetChildren()) do
		if item.Name == "Eye" or item.Name == "Brow" then
			table.insert(headParts, item)
		end
	end
	weldGroup(headParts, p.Head)
	weldGroup({
		block(model, "Vest", V3(2.1, 1.6, 1.1), p.Torso.CFrame * CF(0, 0.15, 0), rgb(150, 100, 60), M.Leather),
		block(model, "CoinPouch", V3(0.6, 0.6, 0.4), p.Torso.CFrame * CF(0.6, -0.8, -0.6), rgb(200, 160, 70), M.Fabric),
		block(model, "Sash", V3(2.15, 0.3, 1.15), p.Torso.CFrame * CF(0, -0.75, 0), rgb(200, 60, 50), M.Fabric),
	}, p.Torso)
	-- Якорим только корень: конечности должны оставаться подвижными для Motor6D-анимаций.
	p.Root.Anchored = true
	p.Root.CanCollide = false
	model:SetAttribute("NPC", "Merchant")
	return model
end

local function buildBlacksmith()
	local model, p = humanoidRig("Blacksmith", {
		Scale = 1.1,
		Skin = rgb(206, 156, 116),
		Shirt = rgb(150, 70, 50), Sleeve = rgb(206, 156, 116),
		Pants = rgb(60, 54, 50),
	})
	local s = p.Scale
	face(p.Head, s, rgb(30, 30, 30), rgb(60, 40, 30))
	local headParts = {
		block(model, "Beard", V3(1.1, 0.8, 0.35) * s, p.Head.CFrame * CF(0, -0.5 * s, -0.5 * s), rgb(70, 46, 30), M.Fabric),
		block(model, "Bandana", V3(1.26, 0.3, 1.26) * s, p.Head.CFrame * CF(0, 0.5 * s, 0), rgb(40, 40, 46), M.Fabric),
	}
	for _, item in ipairs(model:GetChildren()) do
		if item.Name == "Eye" or item.Name == "Brow" then
			table.insert(headParts, item)
		end
	end
	weldGroup(headParts, p.Head)
	weldGroup({
		block(model, "Apron", V3(1.8, 2.4, 0.12) * s, p.Torso.CFrame * CF(0, -0.3 * s, -0.56 * s), rgb(90, 60, 40), M.Leather),
		block(model, "ApronPocket", V3(0.8, 0.5, 0.06) * s, p.Torso.CFrame * CF(0, -0.6 * s, -0.64 * s), rgb(70, 46, 30), M.Leather),
	}, p.Torso)
	-- Молот в правой руке: рукоять вдоль руки, боёк на конце.
	local a = p.RightArm
	weldGroup({
		block(model, "HammerHandle", V3(0.22, 0.22, 2.2) * s, a.CFrame * CF(0, -1.0 * s, -0.9 * s), rgb(110, 76, 44), M.Wood),
		block(model, "HammerHead", V3(0.6, 0.6, 1.0) * s, a.CFrame * CF(0, -1.0 * s, -2.0 * s) * ANG(0, RAD(90), 0), rgb(70, 72, 80), M.Metal),
		block(model, "Glove", V3(1.05, 0.5, 1.05) * s, a.CFrame * CF(0, -0.8 * s, 0), rgb(80, 56, 36), M.Leather),
	}, a)
	-- Якорим только корень: конечности должны оставаться подвижными для Motor6D-анимаций.
	p.Root.Anchored = true
	p.Root.CanCollide = false
	model:SetAttribute("NPC", "Blacksmith")
	return model
end

local function buildExpansionMob(mobId, def)
 local volcanic = mobId == "EmberKnight" or mobId == "ObsidianGuard" or mobId == "AshOverlord"
 local s = def.Scale or (def.Boss and 3.5 or 1.25)
 local stone = volcanic and rgb(46, 38, 57) or rgb(196, 160, 104)
 local glowColor = volcanic and rgb(255, 92, 38) or rgb(255, 222, 106)
 local model, p = humanoidRig(mobId, {
  Scale = s, Skin = shade(stone, 1.1), SkinMaterial = M.Slate,
  Shirt = stone, ShirtMaterial = volcanic and M.Basalt or M.Sandstone,
  Pants = shade(stone, 0.75), PantsMaterial = M.Slate,
 })
 weldGroup({
  block(model, "ChestPlate", V3(2.2, 1.4, 1.25)*s, p.Torso.CFrame*CF(0, 0.15*s, 0), shade(stone, 1.2), M.Metal),
  block(model, "HeartRune", V3(0.6, 0.6, 0.14)*s, p.Torso.CFrame*CF(0, 0.3*s, -0.69*s)*ANG(0,0,RAD(45)), glowColor, M.Neon),
  block(model, "Belt", V3(2.15, 0.25, 1.15)*s, p.Torso.CFrame*CF(0,-0.85*s,0), glowColor, M.Metal),
 }, p.Torso)
 local headParts = face(p.Head, s, glowColor, shade(stone, 0.6))
 table.insert(headParts, block(model, "CrownBand", V3(1.4,0.25,1.4)*s, p.Head.CFrame*CF(0,0.5*s,0), glowColor, M.Metal))
 for i=-1,1 do
  table.insert(headParts, wedge(model, "CrownSpike", V3(0.3,def.Boss and 1.4 or 0.6,0.4)*s, p.Head.CFrame*CF(i*0.45*s,1*s,0), glowColor, M.Neon))
 end
 weldGroup(headParts, p.Head)
 for _, arm in ipairs({p.RightArm,p.LeftArm}) do
  weldGroup({
   block(model, "Pauldron", V3(1.45,0.65,1.45)*s, arm.CFrame*CF(0,0.8*s,0), shade(stone,1.4), M.Metal),
   block(model, "FistGuard", V3(1.15,0.6,1.15)*s, arm.CFrame*CF(0,-0.8*s,0), glowColor, M.Metal),
  }, arm)
 end
 if mobId == "SandSentinel" or mobId == "EmberKnight" then
  local blade = block(model,"ArmBlade",V3(0.18,2.8,0.7)*s,p.RightArm.CFrame*CF(0,-1.6*s,-0.55*s),glowColor,M.Metal)
  weld(p.RightArm,blade)
 end
 local light = Instance.new("PointLight")
 light.Color = glowColor
 light.Brightness = def.Boss and 2 or 0.8
 light.Range = def.Boss and 22 or 8
 light.Parent = p.Torso
 addHumanoid(model, def.HipHeight, def.Name)
 return model
end

local function addLight(parent, color, range, brightness)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Parent = parent
	return light
end

local function setTransparency(list, value)
	for _, item in ipairs(list) do
		item.Transparency = value
	end
end

-- Ледяной призрак: парящее полупрозрачное тело, рваный хвост мантии вместо ног, длинные когти.
local function buildFrostWraith(modelId, def)
	local s = def.Scale or 1
	local ice = rgb(170, 220, 255)
	local model, p = humanoidRig(modelId, {
		Scale = s, Skin = rgb(205, 238, 255), SkinMaterial = M.Glass,
		Shirt = ice, ShirtMaterial = M.Glass, Pants = shade(ice, 0.8), PantsMaterial = M.Glass,
	})
	setTransparency({ p.Torso, p.Head, p.RightArm, p.LeftArm }, 0.4)
	setTransparency({ p.RightLeg, p.LeftLeg }, 1)
	p.RightLeg.Size = p.RightLeg.Size * 0.3
	p.LeftLeg.Size = p.LeftLeg.Size * 0.3
	local cyan = rgb(90, 240, 255)
	local tail = {}
	for i = 1, 5 do
		local w = (2.1 - i * 0.32) * s
		table.insert(tail, block(model, "RobeTail", V3(w, 0.8 * s, 0.9 * s * (1 - i * 0.12)), p.Torso.CFrame * CF((i % 2 - 0.5) * 0.15 * s, (-1.2 - i * 0.7) * s, 0.12 * i * s) * ANG(RAD(8 * i), 0, RAD((i % 2 - 0.5) * 12)), ice, M.Glass, { Transparency = 0.35 + i * 0.1 }))
	end
	for _, side in ipairs({ -1, 1 }) do
		table.insert(tail, wedge(model, "Rag", V3(0.15, 1.6, 0.8) * s, p.Torso.CFrame * CF(side * 0.8 * s, (-1.4) * s, 0.2 * s) * ANG(RAD(180), 0, RAD(side * 10)), shade(ice, 0.9), M.Glass, { Transparency = 0.5 }))
	end
	weldGroup(tail, p.Torso)
	local headParts = {
		block(model, "EyeL", V3(0.2, 0.12, 0.06) * s, p.Head.CFrame * CF(-0.25 * s, 0.1 * s, -0.62 * s), cyan, M.Neon),
		block(model, "EyeR", V3(0.2, 0.12, 0.06) * s, p.Head.CFrame * CF(0.25 * s, 0.1 * s, -0.62 * s), cyan, M.Neon),
		block(model, "Mouth", V3(0.4, 0.3, 0.06) * s, p.Head.CFrame * CF(0, -0.28 * s, -0.62 * s), rgb(20, 60, 90), M.SmoothPlastic),
		wedge(model, "IceCrown", V3(0.25, 0.8, 0.3) * s, p.Head.CFrame * CF(0, 0.95 * s, 0), cyan, M.Glass, { Transparency = 0.3 }),
		wedge(model, "IceCrown", V3(0.2, 0.55, 0.25) * s, p.Head.CFrame * CF(0.4 * s, 0.85 * s, 0) * ANG(0, 0, RAD(-20)), cyan, M.Glass, { Transparency = 0.3 }),
		wedge(model, "IceCrown", V3(0.2, 0.55, 0.25) * s, p.Head.CFrame * CF(-0.4 * s, 0.85 * s, 0) * ANG(0, 0, RAD(20)), cyan, M.Glass, { Transparency = 0.3 }),
	}
	weldGroup(headParts, p.Head)
	for _, arm in ipairs({ p.RightArm, p.LeftArm }) do
		local claws = {}
		for i = -1, 1 do
			table.insert(claws, wedge(model, "Claw", V3(0.1, 1.3, 0.14) * s, arm.CFrame * CF(i * 0.3 * s, -1.55 * s, -0.1 * s) * ANG(RAD(180), 0, RAD(i * -8)), rgb(225, 248, 255), M.Glass, { Transparency = 0.15 }))
		end
		table.insert(claws, block(model, "Frost", V3(1.1, 0.35, 1.1) * s, arm.CFrame * CF(0, -0.9 * s, 0), cyan, M.Neon, { Transparency = 0.6 }))
		weldGroup(claws, arm)
	end
	weldGroup({ block(model, "Core", V3(0.6, 0.6, 0.2) * s, p.Torso.CFrame * CF(0, 0.3 * s, -0.5 * s) * ANG(0, 0, RAD(45)), cyan, M.Neon, { Transparency = 0.2 }) }, p.Torso)
	addLight(p.Torso, cyan, 12, 1.6)
	addHumanoid(model, def.HipHeight, def.Name)
	return model
end

-- Морозный маг: мантия с капюшоном, ледяной посох с кристаллом «CastPoint» на конце.
local function buildFrostMage(modelId, def)
	local s = def.Scale or 1
	local robe = rgb(52, 78, 150)
	local model, p = humanoidRig(modelId, {
		Scale = s, Skin = rgb(190, 214, 235),
		Shirt = robe, ShirtMaterial = M.Fabric, Sleeve = shade(robe, 0.85),
		Pants = shade(robe, 0.7), PantsMaterial = M.Fabric,
	})
	local cyan = rgb(110, 230, 255)
	weldGroup({
		block(model, "RobeSkirt", V3(2.3, 2.4, 1.4) * s, p.Torso.CFrame * CF(0, -1.5 * s, 0), shade(robe, 0.9), M.Fabric),
		block(model, "RobeHem", V3(2.5, 0.25, 1.55) * s, p.Torso.CFrame * CF(0, -2.6 * s, 0), cyan, M.Fabric),
		block(model, "Sash", V3(2.1, 0.3, 1.1) * s, p.Torso.CFrame * CF(0, -0.75 * s, 0), rgb(220, 235, 255), M.Fabric),
		block(model, "RuneA", V3(0.5, 0.12, 0.06) * s, p.Torso.CFrame * CF(0, 0.5 * s, -0.52 * s), cyan, M.Neon),
		block(model, "RuneB", V3(0.12, 0.7, 0.06) * s, p.Torso.CFrame * CF(0, 0.2 * s, -0.52 * s), cyan, M.Neon),
		block(model, "RuneC", V3(0.4, 0.4, 0.06) * s, p.Torso.CFrame * CF(0, -1.7 * s, -0.72 * s) * ANG(0, 0, RAD(45)), cyan, M.Neon),
		block(model, "Mantle", V3(2.5, 0.5, 1.4) * s, p.Torso.CFrame * CF(0, 1.0 * s, 0), shade(robe, 1.2), M.Fabric),
	}, p.Torso)
	local headParts = {
		block(model, "HoodBack", V3(1.4, 1.4, 0.4) * s, p.Head.CFrame * CF(0, 0.05 * s, 0.55 * s), shade(robe, 0.8), M.Fabric),
		block(model, "HoodTop", V3(1.4, 0.35, 1.4) * s, p.Head.CFrame * CF(0, 0.7 * s, 0), shade(robe, 0.8), M.Fabric),
		block(model, "HoodL", V3(0.25, 1.3, 1.3) * s, p.Head.CFrame * CF(-0.68 * s, 0.05 * s, 0), shade(robe, 0.8), M.Fabric),
		block(model, "HoodR", V3(0.25, 1.3, 1.3) * s, p.Head.CFrame * CF(0.68 * s, 0.05 * s, 0), shade(robe, 0.8), M.Fabric),
		wedge(model, "HoodTip", V3(0.5, 0.7, 0.6) * s, p.Head.CFrame * CF(0, 1.0 * s, 0.35 * s) * ANG(0, RAD(180), 0), shade(robe, 0.7), M.Fabric),
		block(model, "Shadow", V3(1.0, 0.9, 0.1) * s, p.Head.CFrame * CF(0, 0, -0.58 * s), rgb(14, 20, 40), M.SmoothPlastic),
		block(model, "EyeL", V3(0.2, 0.1, 0.05) * s, p.Head.CFrame * CF(-0.25 * s, 0.08 * s, -0.64 * s), cyan, M.Neon),
		block(model, "EyeR", V3(0.2, 0.1, 0.05) * s, p.Head.CFrame * CF(0.25 * s, 0.08 * s, -0.64 * s), cyan, M.Neon),
	}
	weldGroup(headParts, p.Head)
	local a = p.RightArm
	local staffParts = {
		block(model, "Staff", V3(0.2, 5.2, 0.2) * s, a.CFrame * CF(0, 0.7 * s, -0.6 * s), rgb(120, 160, 200), M.Ice),
		block(model, "StaffRing", V3(0.5, 0.2, 0.5) * s, a.CFrame * CF(0, 3.1 * s, -0.6 * s), rgb(220, 240, 255), M.Metal),
		wedge(model, "StaffClawL", V3(0.12, 0.7, 0.2) * s, a.CFrame * CF(-0.25 * s, 3.45 * s, -0.6 * s) * ANG(0, 0, RAD(15)), rgb(200, 235, 255), M.Ice),
		wedge(model, "StaffClawR", V3(0.12, 0.7, 0.2) * s, a.CFrame * CF(0.25 * s, 3.45 * s, -0.6 * s) * ANG(0, 0, RAD(-15)), rgb(200, 235, 255), M.Ice),
		block(model, "Glove", V3(1.05, 0.5, 1.05) * s, a.CFrame * CF(0, -0.8 * s, 0), shade(robe, 0.7), M.Fabric),
		ball(model, "CastPoint", 0.8 * s, a.CFrame * CF(0, 3.5 * s, -0.6 * s), cyan, M.Neon),
	}
	weldGroup(staffParts, a)
	addLight(p.Torso, cyan, 10, 1.1)
	addHumanoid(model, def.HipHeight, def.Name)
	return model
end

-- Морозный голем: глыба льда и камня с огромными кулаками, кристаллами на спине и светящимся ядром.
local function buildFrostGolem(modelId, def)
	local s = def.Scale or 1
	local rock = rgb(98, 128, 160)
	local iceColor = rgb(170, 225, 255)
	local cyan = rgb(80, 220, 255)
	local model, p = humanoidRig(modelId, {
		Scale = s, Skin = shade(rock, 1.1), SkinMaterial = M.Glacier,
		Shirt = rock, ShirtMaterial = M.Slate, Sleeve = shade(rock, 0.95),
		Pants = shade(rock, 0.8), PantsMaterial = M.Slate,
	})
	local torsoParts = {
		block(model, "Chest", V3(2.5, 1.5, 1.4) * s, p.Torso.CFrame * CF(0, 0.35 * s, 0), iceColor, M.Ice, { Transparency = 0.15 }),
		block(model, "Core", V3(0.7, 0.7, 0.16) * s, p.Torso.CFrame * CF(0, 0.35 * s, -0.74 * s) * ANG(0, 0, RAD(45)), cyan, M.Neon),
		block(model, "CoreFrame", V3(1.0, 1.0, 0.1) * s, p.Torso.CFrame * CF(0, 0.35 * s, -0.7 * s) * ANG(0, 0, RAD(45)), shade(rock, 0.6), M.Slate),
		block(model, "Belt", V3(2.2, 0.4, 1.2) * s, p.Torso.CFrame * CF(0, -0.85 * s, 0), shade(rock, 0.65), M.Slate),
	}
	for i = -2, 2 do
		table.insert(torsoParts, wedge(model, "BackCrystal", V3(0.4, 1.4 + (2 - math.abs(i)) * 0.5, 0.45) * s, p.Torso.CFrame * CF(i * 0.45 * s, (1.2 + (2 - math.abs(i)) * 0.15) * s, 0.7 * s) * ANG(RAD(-14), RAD(i * 12), RAD(-i * 9)), iceColor, M.Glass, { Transparency = 0.2 }))
	end
	weldGroup(torsoParts, p.Torso)
	local headParts = {
		block(model, "Brow", V3(1.4, 0.3, 0.5) * s, p.Head.CFrame * CF(0, 0.3 * s, -0.5 * s), shade(rock, 0.7), M.Slate),
		block(model, "EyeL", V3(0.3, 0.14, 0.08) * s, p.Head.CFrame * CF(-0.28 * s, 0.05 * s, -0.64 * s), cyan, M.Neon),
		block(model, "EyeR", V3(0.3, 0.14, 0.08) * s, p.Head.CFrame * CF(0.28 * s, 0.05 * s, -0.64 * s), cyan, M.Neon),
		wedge(model, "IceHornL", V3(0.3, 0.9, 0.35) * s, p.Head.CFrame * CF(-0.45 * s, 0.9 * s, 0) * ANG(0, 0, RAD(18)), iceColor, M.Ice),
		wedge(model, "IceHornR", V3(0.3, 0.9, 0.35) * s, p.Head.CFrame * CF(0.45 * s, 0.9 * s, 0) * ANG(0, 0, RAD(-18)), iceColor, M.Ice),
	}
	weldGroup(headParts, p.Head)
	for _, arm in ipairs({ p.RightArm, p.LeftArm }) do
		local side = arm == p.RightArm and 1 or -1
		weldGroup({
			block(model, "Boulder", V3(1.8, 1.2, 1.8) * s, arm.CFrame * CF(side * 0.1 * s, 0.85 * s, 0) * ANG(0, RAD(20), RAD(side * 10)), shade(rock, 1.15), M.Glacier),
			block(model, "Fist", V3(1.9, 1.5, 1.9) * s, arm.CFrame * CF(0, -1.2 * s, 0), iceColor, M.Ice, { Transparency = 0.1 }),
			wedge(model, "Knuckle", V3(0.3, 0.5, 0.4) * s, arm.CFrame * CF(-0.5 * s, -2.1 * s, -0.7 * s) * ANG(RAD(180), 0, 0), cyan, M.Neon),
			wedge(model, "Knuckle", V3(0.3, 0.5, 0.4) * s, arm.CFrame * CF(0.5 * s, -2.1 * s, -0.7 * s) * ANG(RAD(180), 0, 0), cyan, M.Neon),
			block(model, "RuneArm", V3(0.06, 0.5, 0.4) * s, arm.CFrame * CF(side * 0.52 * s, 0, 0), cyan, M.Neon),
		}, arm)
	end
	for _, leg in ipairs({ p.RightLeg, p.LeftLeg }) do
		weldGroup({
			block(model, "Foot", V3(1.5, 0.7, 1.8) * s, leg.CFrame * CF(0, -0.8 * s, -0.2 * s), shade(rock, 0.75), M.Glacier),
			wedge(model, "ShinSpike", V3(0.25, 0.7, 0.3) * s, leg.CFrame * CF(0, 0.3 * s, -0.6 * s) * ANG(RAD(-90), 0, 0), iceColor, M.Ice),
		}, leg)
	end
	addLight(p.Torso, cyan, 14, 1.4)
	addHumanoid(model, def.HipHeight, def.Name)
	return model
end

-- Страж цитадели: тяжёлый рыцарь в синей стали, башенный щит слева, алебарда справа.
local function buildCitadelSentinel(modelId, def)
	local s = def.Scale or 1
	local steel = rgb(72, 104, 156)
	local trim = rgb(190, 215, 245)
	local cyan = rgb(110, 225, 255)
	local model, p = humanoidRig(modelId, {
		Scale = s, Skin = steel, SkinMaterial = M.Metal,
		Shirt = steel, ShirtMaterial = M.DiamondPlate, Sleeve = shade(steel, 0.9),
		Pants = shade(steel, 0.7), PantsMaterial = M.Metal,
	})
	weldGroup({
		block(model, "Breastplate", V3(2.2, 1.5, 1.25) * s, p.Torso.CFrame * CF(0, 0.15 * s, 0), shade(steel, 1.2), M.Metal),
		block(model, "Tabard", V3(1.1, 1.8, 0.1) * s, p.Torso.CFrame * CF(0, -0.4 * s, -0.68 * s), rgb(230, 238, 250), M.Fabric),
		block(model, "TabardEmblem", V3(0.4, 0.4, 0.06) * s, p.Torso.CFrame * CF(0, 0.1 * s, -0.75 * s) * ANG(0, 0, RAD(45)), cyan, M.Neon),
		block(model, "Belt", V3(2.15, 0.28, 1.15) * s, p.Torso.CFrame * CF(0, -0.85 * s, 0), trim, M.Metal),
	}, p.Torso)
	local headParts = {
		block(model, "Helm", V3(1.45, 1.45, 1.45) * s, p.Head.CFrame * CF(0, 0.1 * s, 0), shade(steel, 1.15), M.Metal),
		block(model, "Visor", V3(1.2, 0.18, 0.1) * s, p.Head.CFrame * CF(0, 0.05 * s, -0.74 * s), rgb(10, 14, 26), M.SmoothPlastic),
		block(model, "VisorGlow", V3(0.9, 0.06, 0.06) * s, p.Head.CFrame * CF(0, 0.05 * s, -0.76 * s), cyan, M.Neon),
		block(model, "Crest", V3(0.2, 0.3, 1.2) * s, p.Head.CFrame * CF(0, 0.9 * s, 0), trim, M.Metal),
	}
	for i = 0, 3 do
		table.insert(headParts, wedge(model, "Plume", V3(0.22, 0.7, 0.5) * s, p.Head.CFrame * CF(0, (1.15 + i * 0.05) * s, (0.45 + i * 0.3) * s) * ANG(RAD(-15 * i), RAD(180), 0), rgb(235, 245, 255), M.Fabric))
	end
	weldGroup(headParts, p.Head)
	for _, arm in ipairs({ p.RightArm, p.LeftArm }) do
		weldGroup({
			block(model, "Pauldron", V3(1.6, 0.7, 1.6) * s, arm.CFrame * CF(0, 0.8 * s, 0), trim, M.Metal),
			block(model, "Gauntlet", V3(1.2, 0.7, 1.2) * s, arm.CFrame * CF(0, -0.75 * s, 0), shade(steel, 0.8), M.Metal),
		}, arm)
	end
	for _, leg in ipairs({ p.RightLeg, p.LeftLeg }) do
		weldGroup({
			block(model, "Greave", V3(1.2, 0.9, 1.2) * s, leg.CFrame * CF(0, -0.3 * s, 0), shade(steel, 1.1), M.Metal),
			block(model, "Boot", V3(1.2, 0.5, 1.6) * s, leg.CFrame * CF(0, -0.8 * s, -0.2 * s), shade(steel, 0.6), M.Metal),
		}, leg)
	end
	local la = p.LeftArm
	weldGroup({
		block(model, "Shield", V3(0.3, 3.4, 2.1) * s, la.CFrame * CF(-0.75 * s, 0.1 * s, -0.2 * s), shade(steel, 1.1), M.DiamondPlate),
		block(model, "ShieldRim", V3(0.38, 3.6, 0.2) * s, la.CFrame * CF(-0.75 * s, 0.1 * s, -1.25 * s), trim, M.Metal),
		block(model, "ShieldRim", V3(0.38, 3.6, 0.2) * s, la.CFrame * CF(-0.75 * s, 0.1 * s, 0.85 * s), trim, M.Metal),
		block(model, "ShieldCrest", V3(0.12, 1.1, 0.8) * s, la.CFrame * CF(-0.95 * s, 0.4 * s, -0.2 * s), cyan, M.Neon),
		wedge(model, "ShieldTip", V3(0.3, 0.7, 2.1) * s, la.CFrame * CF(-0.75 * s, -1.95 * s, -0.2 * s) * ANG(RAD(180), 0, 0), trim, M.Metal),
	}, la)
	local ra = p.RightArm
	weldGroup({
		block(model, "HalberdPole", V3(0.2, 6.4, 0.2) * s, ra.CFrame * CF(0, 1.2 * s, -0.6 * s), rgb(110, 84, 60), M.Wood),
		block(model, "HalberdAxe", V3(0.14, 1.3, 1.5) * s, ra.CFrame * CF(0, 3.8 * s, -1.35 * s), trim, M.Metal),
		wedge(model, "HalberdBlade", V3(0.14, 0.9, 0.8) * s, ra.CFrame * CF(0, 3.9 * s, -2.4 * s) * ANG(0, RAD(180), 0), trim, M.Metal),
		wedge(model, "HalberdSpike", V3(0.2, 1.1, 0.2) * s, ra.CFrame * CF(0, 4.9 * s, -0.6 * s), trim, M.Metal),
		block(model, "HalberdGem", V3(0.3, 0.3, 0.3) * s, ra.CFrame * CF(0, 3.2 * s, -0.6 * s), cyan, M.Neon),
	}, ra)
	addLight(p.Torso, cyan, 8, 0.7)
	addHumanoid(model, def.HipHeight, def.Name)
	return model
end

-- Колдун бездны: фиолетовая мантия, рога, парящие сферы пустоты вокруг головы и посох с «CastPoint».
local function buildVoidWarlock(modelId, def)
	local s = def.Scale or 1
	local robe = rgb(54, 24, 86)
	local void = rgb(190, 90, 255)
	local model, p = humanoidRig(modelId, {
		Scale = s, Skin = rgb(120, 96, 150),
		Shirt = robe, ShirtMaterial = M.Fabric, Sleeve = shade(robe, 0.8),
		Pants = shade(robe, 0.6), PantsMaterial = M.Fabric,
	})
	weldGroup({
		block(model, "RobeSkirt", V3(2.3, 2.4, 1.4) * s, p.Torso.CFrame * CF(0, -1.5 * s, 0), shade(robe, 0.85), M.Fabric),
		block(model, "RobeHem", V3(2.5, 0.25, 1.55) * s, p.Torso.CFrame * CF(0, -2.6 * s, 0), void, M.Neon),
		block(model, "Collar", V3(2.6, 0.9, 1.5) * s, p.Torso.CFrame * CF(0, 0.9 * s, 0.1 * s), shade(robe, 1.3), M.Fabric),
		block(model, "SigilA", V3(0.8, 0.1, 0.06) * s, p.Torso.CFrame * CF(0, 0.2 * s, -0.52 * s), void, M.Neon),
		block(model, "SigilB", V3(0.1, 0.8, 0.06) * s, p.Torso.CFrame * CF(0, 0.2 * s, -0.52 * s), void, M.Neon),
		block(model, "SigilC", V3(0.5, 0.5, 0.06) * s, p.Torso.CFrame * CF(0, 0.2 * s, -0.54 * s) * ANG(0, 0, RAD(45)), void, M.Neon),
	}, p.Torso)
	local headParts = {
		block(model, "Cowl", V3(1.35, 0.5, 1.35) * s, p.Head.CFrame * CF(0, 0.55 * s, 0.05 * s), shade(robe, 0.7), M.Fabric),
		block(model, "EyeL", V3(0.2, 0.12, 0.05) * s, p.Head.CFrame * CF(-0.25 * s, 0.05 * s, -0.62 * s), void, M.Neon),
		block(model, "EyeR", V3(0.2, 0.12, 0.05) * s, p.Head.CFrame * CF(0.25 * s, 0.05 * s, -0.62 * s), void, M.Neon),
	}
	for _, side in ipairs({ -1, 1 }) do
		table.insert(headParts, wedge(model, "HornLow", V3(0.3, 0.8, 0.4) * s, p.Head.CFrame * CF(side * 0.7 * s, 0.7 * s, 0) * ANG(0, 0, RAD(side * -35)), rgb(30, 20, 36), M.Slate))
		table.insert(headParts, wedge(model, "HornTip", V3(0.22, 0.7, 0.3) * s, p.Head.CFrame * CF(side * 1.0 * s, 1.25 * s, 0) * ANG(0, 0, RAD(side * 10)), rgb(30, 20, 36), M.Slate))
	end
	for i = 0, 2 do
		local angle = i / 3 * math.pi * 2
		table.insert(headParts, ball(model, "VoidOrb", 0.55 * s, p.Head.CFrame * CF(math.cos(angle) * 1.7 * s, (1.0 + i * 0.25) * s, math.sin(angle) * 1.7 * s), void, M.Neon, { Transparency = 0.2 }))
		table.insert(headParts, ball(model, "VoidCore", 0.25 * s, p.Head.CFrame * CF(math.cos(angle) * 1.7 * s, (1.0 + i * 0.25) * s, math.sin(angle) * 1.7 * s), rgb(20, 4, 36), M.SmoothPlastic))
	end
	weldGroup(headParts, p.Head)
	local a = p.RightArm
	weldGroup({
		block(model, "Staff", V3(0.22, 5.0, 0.22) * s, a.CFrame * CF(0, 0.6 * s, -0.6 * s), rgb(36, 28, 44), M.Wood),
		cylinder(model, "StaffRing", 0.15 * s, 0.9 * s, a.CFrame * CF(0, 3.2 * s, -0.6 * s) * UPRIGHT, rgb(150, 110, 190), M.Metal),
		wedge(model, "StaffHornL", V3(0.15, 0.8, 0.2) * s, a.CFrame * CF(-0.4 * s, 3.4 * s, -0.6 * s) * ANG(0, 0, RAD(20)), rgb(30, 20, 36), M.Slate),
		wedge(model, "StaffHornR", V3(0.15, 0.8, 0.2) * s, a.CFrame * CF(0.4 * s, 3.4 * s, -0.6 * s) * ANG(0, 0, RAD(-20)), rgb(30, 20, 36), M.Slate),
		block(model, "Glove", V3(1.05, 0.5, 1.05) * s, a.CFrame * CF(0, -0.8 * s, 0), shade(robe, 0.6), M.Fabric),
		ball(model, "CastPoint", 0.85 * s, a.CFrame * CF(0, 3.45 * s, -0.6 * s), void, M.Neon),
	}, a)
	addLight(p.Torso, void, 12, 1.4)
	addHumanoid(model, def.HipHeight, def.Name)
	return model
end

-- Скелет-воин: тонкие кости вместо конечностей, рёбра, череп с зелёными глазами, ржавый меч и круглый щит.
local function buildSkeletonWarrior(modelId, def)
	local s = def.Scale or 1
	local bone = rgb(228, 222, 200)
	local green = rgb(110, 255, 130)
	local model, p = humanoidRig(modelId, {
		Scale = s, Skin = bone, Shirt = bone, ShirtMaterial = M.SmoothPlastic, Pants = bone, PantsMaterial = M.SmoothPlastic,
	})
	setTransparency({ p.Torso, p.RightArm, p.LeftArm, p.RightLeg, p.LeftLeg }, 1)
	local torsoParts = {
		block(model, "Spine", V3(0.22, 2.0, 0.22) * s, p.Torso.CFrame * CF(0, 0, 0.2 * s), bone, M.SmoothPlastic),
		block(model, "Sternum", V3(0.2, 1.3, 0.1) * s, p.Torso.CFrame * CF(0, 0.2 * s, -0.4 * s), bone, M.SmoothPlastic),
		block(model, "Pelvis", V3(1.5, 0.35, 0.8) * s, p.Torso.CFrame * CF(0, -0.9 * s, 0), shade(bone, 0.9), M.SmoothPlastic),
		block(model, "Collarbone", V3(2.0, 0.16, 0.2) * s, p.Torso.CFrame * CF(0, 0.85 * s, -0.1 * s), bone, M.SmoothPlastic),
	}
	for i = 0, 4 do
		local width = (1.9 - i * 0.12) * s
		table.insert(torsoParts, block(model, "Rib", V3(width, 0.1, 0.85) * s, p.Torso.CFrame * CF(0, (0.55 - i * 0.28) * s, -0.05 * s), bone, M.SmoothPlastic))
	end
	weldGroup(torsoParts, p.Torso)
	local headParts = {
		block(model, "Jaw", V3(0.9, 0.3, 0.9) * s, p.Head.CFrame * CF(0, -0.5 * s, -0.1 * s), shade(bone, 0.92), M.SmoothPlastic),
		block(model, "SocketL", V3(0.3, 0.3, 0.06) * s, p.Head.CFrame * CF(-0.28 * s, 0.1 * s, -0.61 * s), rgb(14, 12, 14), M.SmoothPlastic),
		block(model, "SocketR", V3(0.3, 0.3, 0.06) * s, p.Head.CFrame * CF(0.28 * s, 0.1 * s, -0.61 * s), rgb(14, 12, 14), M.SmoothPlastic),
		ball(model, "EyeL", 0.14 * s, p.Head.CFrame * CF(-0.28 * s, 0.1 * s, -0.64 * s), green, M.Neon),
		ball(model, "EyeR", 0.14 * s, p.Head.CFrame * CF(0.28 * s, 0.1 * s, -0.64 * s), green, M.Neon),
		block(model, "Nose", V3(0.12, 0.2, 0.06) * s, p.Head.CFrame * CF(0, -0.15 * s, -0.61 * s), rgb(14, 12, 14), M.SmoothPlastic),
	}
	for i = -2, 2 do
		table.insert(headParts, block(model, "Tooth", V3(0.1, 0.14, 0.06) * s, p.Head.CFrame * CF(i * 0.16 * s, -0.4 * s, -0.58 * s), rgb(245, 240, 225), M.SmoothPlastic))
	end
	weldGroup(headParts, p.Head)
	for _, arm in ipairs({ p.RightArm, p.LeftArm }) do
		weldGroup({
			block(model, "Humerus", V3(0.28, 1.0, 0.28) * s, arm.CFrame * CF(0, 0.5 * s, 0), bone, M.SmoothPlastic),
			ball(model, "Elbow", 0.4 * s, arm.CFrame * CF(0, 0, 0), bone, M.SmoothPlastic),
			block(model, "Forearm", V3(0.24, 0.9, 0.24) * s, arm.CFrame * CF(0, -0.5 * s, 0), bone, M.SmoothPlastic),
			block(model, "Hand", V3(0.4, 0.3, 0.3) * s, arm.CFrame * CF(0, -1.0 * s, 0), shade(bone, 0.92), M.SmoothPlastic),
			ball(model, "Shoulder", 0.45 * s, arm.CFrame * CF(0, 0.95 * s, 0), bone, M.SmoothPlastic),
		}, arm)
	end
	for _, leg in ipairs({ p.RightLeg, p.LeftLeg }) do
		weldGroup({
			block(model, "Femur", V3(0.3, 1.0, 0.3) * s, leg.CFrame * CF(0, 0.5 * s, 0), bone, M.SmoothPlastic),
			ball(model, "Knee", 0.42 * s, leg.CFrame * CF(0, 0, 0), bone, M.SmoothPlastic),
			block(model, "Shin", V3(0.24, 0.9, 0.24) * s, leg.CFrame * CF(0, -0.5 * s, 0), bone, M.SmoothPlastic),
			block(model, "Foot", V3(0.5, 0.2, 0.9) * s, leg.CFrame * CF(0, -0.95 * s, -0.25 * s), shade(bone, 0.9), M.SmoothPlastic),
		}, leg)
	end
	local rust = rgb(140, 90, 52)
	local ra = p.RightArm
	weldGroup({
		block(model, "SwordGrip", V3(0.16, 0.16, 0.7) * s, ra.CFrame * CF(0, -1.0 * s, -0.2 * s), rgb(70, 50, 36), M.Fabric),
		block(model, "SwordGuard", V3(0.8, 0.14, 0.14) * s, ra.CFrame * CF(0, -1.0 * s, -0.65 * s), rgb(100, 80, 60), M.CorrodedMetal),
		block(model, "SwordBlade", V3(0.3, 0.07, 2.4) * s, ra.CFrame * CF(0, -1.0 * s, -1.9 * s), rust, M.CorrodedMetal),
		block(model, "SwordEdge", V3(0.06, 0.07, 2.3) * s, ra.CFrame * CF(0.15 * s, -1.0 * s, -1.9 * s), rgb(170, 160, 150), M.Metal),
		wedge(model, "SwordTip", V3(0.07, 0.3, 0.5) * s, ra.CFrame * CF(0, -1.0 * s, -3.35 * s) * ANG(0, 0, RAD(90)), rust, M.CorrodedMetal),
	}, ra)
	local la = p.LeftArm
	weldGroup({
		cylinder(model, "Shield", 0.18 * s, 1.9 * s, la.CFrame * CF(-0.7 * s, -0.2 * s, 0), rgb(110, 76, 44), M.Wood),
		cylinder(model, "ShieldRim", 0.24 * s, 2.0 * s, la.CFrame * CF(-0.66 * s, -0.2 * s, 0), rgb(110, 100, 94), M.CorrodedMetal, { Transparency = 0.3 }),
		ball(model, "ShieldBoss", 0.5 * s, la.CFrame * CF(-0.85 * s, -0.2 * s, 0), rgb(150, 140, 130), M.Metal),
	}, la)
	addLight(p.Head, green, 6, 0.6)
	addHumanoid(model, def.HipHeight, def.Name)
	return model
end

-- Император Вечной Мерзлоты (мировой босс): ледяная корона, плащ, наплечники с кристаллами и огромный ледяной двуручник.
local function buildFrostEmperor(modelId, def)
	local s = def.Scale or 1
	local iceColor = rgb(176, 230, 255)
	local deep = rgb(34, 58, 118)
	local cyan = rgb(100, 235, 255)
	local model, p = humanoidRig(modelId, {
		Scale = s, Skin = rgb(205, 232, 250), SkinMaterial = M.Ice,
		Shirt = deep, ShirtMaterial = M.DiamondPlate, Sleeve = shade(deep, 1.1),
		Pants = shade(deep, 0.8), PantsMaterial = M.Metal,
	})
	local torsoParts = {
		block(model, "Breastplate", V3(2.25, 1.5, 1.25) * s, p.Torso.CFrame * CF(0, 0.2 * s, 0), iceColor, M.Ice, { Transparency = 0.1 }),
		block(model, "ChestRune", V3(0.6, 0.6, 0.12) * s, p.Torso.CFrame * CF(0, 0.3 * s, -0.68 * s) * ANG(0, 0, RAD(45)), cyan, M.Neon),
		block(model, "RuneBarV", V3(0.1, 1.2, 0.08) * s, p.Torso.CFrame * CF(0, 0.3 * s, -0.66 * s), cyan, M.Neon),
		block(model, "Belt", V3(2.2, 0.35, 1.2) * s, p.Torso.CFrame * CF(0, -0.85 * s, 0), rgb(230, 245, 255), M.Metal),
		block(model, "BeltGem", V3(0.4, 0.4, 0.1) * s, p.Torso.CFrame * CF(0, -0.85 * s, -0.62 * s) * ANG(0, 0, RAD(45)), cyan, M.Neon),
		block(model, "Tasset", V3(1.6, 0.9, 1.2) * s, p.Torso.CFrame * CF(0, -1.35 * s, 0), deep, M.Fabric),
	}
	local capeColor = rgb(24, 44, 100)
	for i = 1, 4 do
		table.insert(torsoParts, block(model, "Cape", V3(2.5 - i * 0.12, 1.2, 0.14) * s, p.Torso.CFrame * CF(0, (1.0 - i * 1.15) * s, (0.72 + i * 0.12) * s) * ANG(RAD(-7 * i), 0, 0), capeColor, M.Fabric))
	end
	table.insert(torsoParts, block(model, "CapeTrim", V3(2.3, 0.2, 0.18) * s, p.Torso.CFrame * CF(0, -3.8 * s, 1.2 * s) * ANG(RAD(-28), 0, 0), iceColor, M.Ice))
	table.insert(torsoParts, block(model, "CapeCollar", V3(2.8, 0.8, 0.5) * s, p.Torso.CFrame * CF(0, 1.15 * s, 0.55 * s), shade(capeColor, 1.4), M.Fabric))
	weldGroup(torsoParts, p.Torso)
	local headParts = face(p.Head, s, cyan, rgb(120, 170, 210))
	table.insert(headParts, cylinder(model, "CrownBand", 0.3 * s, 1.5 * s, p.Head.CFrame * CF(0, 0.6 * s, 0) * UPRIGHT, rgb(225, 245, 255), M.Metal))
	local heights = { 1.1, 1.7, 2.3, 1.7, 1.1 }
	for i = -2, 2 do
		table.insert(headParts, wedge(model, "CrownSpike", V3(0.3, heights[i + 3], 0.34) * s, p.Head.CFrame * CF(i * 0.34 * s, (0.75 + heights[i + 3] / 2 - 0.1) * s, 0) * ANG(0, 0, RAD(-i * 6)), iceColor, M.Glass, { Transparency = 0.15 }))
	end
	for _, side in ipairs({ -1, 1 }) do
		table.insert(headParts, wedge(model, "CrownSide", V3(0.26, 1.0, 0.3) * s, p.Head.CFrame * CF(side * 0.85 * s, 0.9 * s, 0.1 * s) * ANG(0, 0, RAD(side * -25)), iceColor, M.Glass, { Transparency = 0.15 }))
	end
	table.insert(headParts, cylinder(model, "FrostHalo", 0.1 * s, 3.6 * s, p.Head.CFrame * CF(0, 0.3 * s, 0.9 * s) * FACING, cyan, M.Neon, { Transparency = 0.55 }))
	table.insert(headParts, ball(model, "CrownGem", 0.35 * s, p.Head.CFrame * CF(0, 0.65 * s, -0.75 * s), rgb(255, 120, 230), M.Neon))
	weldGroup(headParts, p.Head)
	for _, arm in ipairs({ p.RightArm, p.LeftArm }) do
		local side = arm == p.RightArm and 1 or -1
		weldGroup({
			block(model, "Pauldron", V3(1.7, 0.75, 1.7) * s, arm.CFrame * CF(side * 0.1 * s, 0.8 * s, 0), rgb(220, 240, 255), M.Metal),
			wedge(model, "PauldronCrystal", V3(0.4, 1.3, 0.45) * s, arm.CFrame * CF(side * 0.45 * s, 1.5 * s, 0) * ANG(0, 0, RAD(-side * 22)), iceColor, M.Glass, { Transparency = 0.15 }),
			wedge(model, "PauldronCrystal", V3(0.3, 0.9, 0.35) * s, arm.CFrame * CF(side * -0.1 * s, 1.35 * s, 0.1 * s) * ANG(0, 0, RAD(side * 8)), cyan, M.Neon),
			block(model, "Vambrace", V3(1.2, 0.8, 1.2) * s, arm.CFrame * CF(0, -0.7 * s, 0), iceColor, M.Ice),
			block(model, "RuneArm", V3(0.06, 0.5, 0.4) * s, arm.CFrame * CF(side * 0.52 * s, 0.1 * s, 0), cyan, M.Neon),
		}, arm)
	end
	for _, leg in ipairs({ p.RightLeg, p.LeftLeg }) do
		weldGroup({
			block(model, "Greave", V3(1.2, 1.0, 1.2) * s, leg.CFrame * CF(0, -0.3 * s, 0), iceColor, M.Ice),
			block(model, "Boot", V3(1.25, 0.55, 1.7) * s, leg.CFrame * CF(0, -0.8 * s, -0.2 * s), shade(deep, 0.7), M.Metal),
			block(model, "RuneLeg", V3(0.4, 0.06, 0.4) * s, leg.CFrame * CF(0, 0.2 * s, -0.62 * s), cyan, M.Neon),
		}, leg)
	end
	local ra = p.RightArm
	weldGroup({
		block(model, "SwordGrip", V3(0.28, 0.28, 1.2) * s, ra.CFrame * CF(0, -1.0 * s, -0.1 * s), rgb(30, 40, 90), M.Fabric),
		block(model, "SwordGuard", V3(2.0, 0.3, 0.3) * s, ra.CFrame * CF(0, -1.0 * s, -0.85 * s), rgb(230, 245, 255), M.Metal),
		block(model, "SwordGem", V3(0.4, 0.4, 0.4) * s, ra.CFrame * CF(0, -1.0 * s, -0.85 * s), rgb(255, 120, 230), M.Neon),
		block(model, "SwordBlade", V3(0.7, 0.14, 4.4) * s, ra.CFrame * CF(0, -1.0 * s, -3.1 * s), iceColor, M.Glass, { Transparency = 0.2 }),
		block(model, "SwordCore", V3(0.2, 0.16, 4.2) * s, ra.CFrame * CF(0, -1.0 * s, -3.1 * s), cyan, M.Neon),
		block(model, "SwordEdgeL", V3(0.08, 0.1, 4.4) * s, ra.CFrame * CF(-0.36 * s, -1.0 * s, -3.1 * s), rgb(240, 252, 255), M.Neon),
		block(model, "SwordEdgeR", V3(0.08, 0.1, 4.4) * s, ra.CFrame * CF(0.36 * s, -1.0 * s, -3.1 * s), rgb(240, 252, 255), M.Neon),
		wedge(model, "SwordTipL", V3(0.14, 0.35, 1.0) * s, ra.CFrame * CF(-0.18 * s, -1.0 * s, -5.8 * s) * ANG(0, 0, RAD(90)), iceColor, M.Glass, { Transparency = 0.2 }),
		wedge(model, "SwordTipR", V3(0.14, 0.35, 1.0) * s, ra.CFrame * CF(0.18 * s, -1.0 * s, -5.8 * s) * ANG(0, 0, RAD(-90)), iceColor, M.Glass, { Transparency = 0.2 }),
		block(model, "Glove", V3(1.2, 0.55, 1.2) * s, ra.CFrame * CF(0, -0.8 * s, 0), deep, M.Metal),
	}, ra)
	addLight(p.Torso, cyan, 26, 2.5)
	addHumanoid(model, def.HipHeight, def.Name)
	return model
end

local SPECIAL_BUILDERS = {
	FrostWraith = buildFrostWraith,
	FrostMage = buildFrostMage,
	FrostGolem = buildFrostGolem,
	CitadelSentinel = buildCitadelSentinel,
	VoidWarlock = buildVoidWarlock,
	SkeletonWarrior = buildSkeletonWarrior,
	FrostEmperor = buildFrostEmperor,
}

-- Модель строится по def.Model (или самому id); Name модели = id модели, по нему клиент выбирает анимации.
function Models.BuildMob(mobId)
	local def = Config.Mobs[mobId]
	if not def then
		return nil
	end
	local modelId = def.Model or mobId
	if modelId == "Slime" then
		return buildSlime(modelId, def, def.Scale)
	elseif modelId == "Guardian" then
		return buildGuardian(modelId, def, def.Scale)
	elseif SPECIAL_BUILDERS[modelId] then
		return SPECIAL_BUILDERS[modelId](modelId, def)
	end
	return buildExpansionMob(modelId, def)
end

function Models.BuildNPC(kind)
	if kind == "Merchant" then
		return buildMerchant()
	end
	return buildBlacksmith()
end

return Models
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">Rules</string><ProtectedString name="Source"><![CDATA[-- GladeSlayer: чистые игровые правила (без Instance и сервисов). Сервер меняет профиль только через эти
-- функции, клиент использует их для форматирования. Модуль покрыт tests/rules_spec.lua.
local Config = require(script.Parent:WaitForChild("Config"))

local Rules = {}

-- Вспомогательные проверки ---------------------------------------------------------------------
local function clamp(value, low, high)
	if value < low then
		return low
	end
	if value > high then
		return high
	end
	return value
end

local function finite(value)
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function isInteger(value, low, high)
	return finite(value) and math.floor(value) == value and value >= low and value <= high
end

local function whole(value, low, high)
	return clamp(math.floor(value), low, high)
end

local function itemDef(itemId)
	if type(itemId) ~= "string" then
		return nil
	end
	return Config.Items[itemId]
end

Rules.Clamp = clamp
Rules.IsInteger = isInteger
Rules.ItemDef = itemDef

-- Прогрессия -----------------------------------------------------------------------------------
function Rules.XPRequired(level)
	local n = math.max(0, (level or 1) - 1)
	return Config.XPBase + Config.XPLinear * n + Config.XPQuadratic * n * n
end

function Rules.StatValue(statId, level)
	local def = Config.Stats[statId]
	if not def then
		return 0
	end
	local value = def.Base + def.PerLevel * (level or 0)
	local scale = 10 ^ def.Decimals
	return math.floor(value * scale + 0.5) / scale
end

function Rules.UpgradeCost(level)
	return 1 + math.floor(level / Config.UpgradeCostStep)
end

function Rules.NewProfile()
	local profile = {
		Version = Config.SchemaVersion,
		Coins = 0,
		Level = 1,
		XP = 0,
		SkillPoints = Config.StartSkillPoints,
		Kills = 0,
		Stats = {},
		Inventory = {},
		Equipped = {},
		Buffs = {},
		Tutorial = 1,
		TutorialProgress = 0,
	}
	for _, statId in ipairs(Config.StatOrder) do
		profile.Stats[statId] = 0
	end
	return profile
end

-- Превращает запись DataStore в живой профиль. Структурно битые записи отклоняются,
-- чтобы сервер не перезаписал чужой прогресс пустым; диапазоны и устаревшие предметы чистятся.
function Rules.Decode(record, now)
	now = now or 0
	if type(record) ~= "table" then
		return nil, "Профиль повреждён."
	end
	if record.Version ~= Config.SchemaVersion then
		return nil, "Профиль сохранён неизвестной версией игры."
	end
	for _, key in ipairs({ "Coins", "Level", "XP", "SkillPoints", "Kills" }) do
		if not finite(record[key]) then
			return nil, "Повреждено поле " .. key .. "."
		end
	end
	if type(record.Stats) ~= "table" or type(record.Inventory) ~= "table" then
		return nil, "Повреждены характеристики или инвентарь."
	end

	local profile = Rules.NewProfile()
	profile.Coins = whole(record.Coins, 0, Config.MaxCoins)
	profile.Level = whole(record.Level, 1, Config.MaxLevel)
	if profile.Level >= Config.MaxLevel then
		profile.XP = 0
	else
		profile.XP = whole(record.XP, 0, Rules.XPRequired(profile.Level) - 1)
	end
	profile.SkillPoints = whole(record.SkillPoints, 0, Config.MaxSkillPoints)
	profile.Kills = whole(record.Kills, 0, Config.MaxKills)

	for _, statId in ipairs(Config.StatOrder) do
		local level = record.Stats[statId]
		if level ~= nil and not finite(level) then
			return nil, "Повреждена характеристика " .. statId .. "."
		end
		if level ~= nil then
			profile.Stats[statId] = whole(level, 0, Config.Stats[statId].MaxLevel)
		end
	end

	for itemId, count in pairs(record.Inventory) do
		if itemDef(itemId) and finite(count) then
			local amount = whole(count, 0, Config.MaxStack)
			if amount > 0 then
				profile.Inventory[itemId] = amount
			end
		end
	end

	if type(record.Equipped) == "table" then
		for _, slot in ipairs(Config.Slots) do
			local itemId = record.Equipped[slot]
			local def = itemDef(itemId)
			if def and def.Kind == "Gear" and def.Slot == slot and (profile.Inventory[itemId] or 0) > 0 then
				profile.Equipped[slot] = itemId
			end
		end
	end

	if type(record.Buffs) == "table" then
		for _, buffId in ipairs(Config.BuffOrder) do
			local remaining = record.Buffs[buffId]
			if finite(remaining) and remaining >= 1 then
				profile.Buffs[buffId] = now + math.min(math.floor(remaining), Config.BuffMaxSeconds)
			end
		end
	end
	-- Поля гайда необязательны: старые сохранения той же версии схемы остаются валидными.
	local doneStep = #Config.Tutorial.Steps + 1
	if finite(record.Tutorial) then
		profile.Tutorial = whole(record.Tutorial, 1, doneStep)
		profile.TutorialProgress = finite(record.TutorialProgress) and whole(record.TutorialProgress, 0, 1000) or 0
	else
		profile.Tutorial = (profile.Level >= 3 or profile.Kills >= 10) and doneStep or 1
	end
	return profile
end

-- Снимок для DataStore: баффы хранятся как «остаток секунд», поэтому офлайн их таймер стоит.
function Rules.Snapshot(profile, now)
	local record = {
		Version = Config.SchemaVersion,
		Coins = profile.Coins,
		Level = profile.Level,
		XP = profile.XP,
		SkillPoints = profile.SkillPoints,
		Kills = profile.Kills,
		Stats = {},
		Inventory = {},
		Equipped = {},
		Buffs = {},
		Tutorial = profile.Tutorial or (#Config.Tutorial.Steps + 1),
		TutorialProgress = profile.TutorialProgress or 0,
	}
	for _, statId in ipairs(Config.StatOrder) do
		record.Stats[statId] = profile.Stats[statId]
	end
	for itemId, count in pairs(profile.Inventory) do
		record.Inventory[itemId] = count
	end
	for _, slot in ipairs(Config.Slots) do
		record.Equipped[slot] = profile.Equipped[slot]
	end
	for _, buffId in ipairs(Config.BuffOrder) do
		local remaining = math.floor(Rules.BuffRemaining(profile, buffId, now))
		if remaining >= 1 then
			record.Buffs[buffId] = remaining
		end
	end
	return record
end

function Rules.CopyRecord(record)
	local copy = {}
	for key, value in pairs(record) do
		if type(value) == "table" then
			copy[key] = Rules.CopyRecord(value)
		else
			copy[key] = value
		end
	end
	return copy
end

-- Баффы (в живом профиле — абсолютное время окончания по часам сервера) ------------------------------
function Rules.BuffRemaining(profile, buffId, now)
	local endsAt = profile.Buffs[buffId]
	if not finite(endsAt) then
		return 0
	end
	return math.max(0, endsAt - (now or 0))
end

function Rules.BuffMultiplier(profile, buffId, now)
	local def = Config.Buffs[buffId]
	if def and Rules.BuffRemaining(profile, buffId, now) > 0 then
		return def.Multiplier
	end
	return 1
end

-- Удаляет истёкшие баффы. Возвращает true, если что-то изменилось (нужно отправить состояние).
function Rules.PruneBuffs(profile, now)
	local changed = false
	for _, buffId in ipairs(Config.BuffOrder) do
		if profile.Buffs[buffId] ~= nil and Rules.BuffRemaining(profile, buffId, now) <= 0 then
			profile.Buffs[buffId] = nil
			changed = true
		end
	end
	return changed
end

-- Характеристики -------------------------------------------------------------------------------
function Rules.GearBonus(profile)
	local damage, health = 0, 0
	for _, slot in ipairs(Config.Slots) do
		local def = itemDef(profile.Equipped[slot])
		if def then
			damage = damage + (def.Damage or 0)
			health = health + (def.Health or 0)
		end
	end
	return damage, health
end

function Rules.Derived(profile)
	local gearDamage, gearHealth = Rules.GearBonus(profile)
	local fist = Rules.StatValue("Damage", profile.Stats.Damage)
	return {
		FistDamage = fist,
		Damage = fist + gearDamage,
		MaxHealth = Rules.StatValue("Health", profile.Stats.Health) + gearHealth,
		Regen = Rules.StatValue("Regen", profile.Stats.Regen),
		WalkSpeed = Rules.StatValue("Speed", profile.Stats.Speed),
		GearDamage = gearDamage,
		GearHealth = gearHealth,
		Weapon = profile.Equipped.Weapon,
	}
end

function Rules.Upgrade(profile, statId)
	local def = Config.Stats[statId]
	if not def then
		return false, "Неизвестная характеристика."
	end
	local level = profile.Stats[statId] or 0
	if level >= def.MaxLevel then
		return false, def.Name .. ": уже максимальный уровень."
	end
	local cost = Rules.UpgradeCost(level)
	if profile.SkillPoints < cost then
		return false, "Не хватает очков навыков (нужно " .. cost .. ")."
	end
	profile.SkillPoints = profile.SkillPoints - cost
	profile.Stats[statId] = level + 1
	return true, level + 1
end

-- Опыт и монеты ---------------------------------------------------------------------------------
-- Возвращает (сколько уровней получено, сколько очков навыков начислено).
function Rules.AddXP(profile, amount)
	if not finite(amount) or amount <= 0 or profile.Level >= Config.MaxLevel then
		return 0, 0
	end
	profile.XP = profile.XP + math.floor(amount)
	local levels, points = 0, 0
	while profile.Level < Config.MaxLevel and profile.XP >= Rules.XPRequired(profile.Level) do
		profile.XP = profile.XP - Rules.XPRequired(profile.Level)
		profile.Level = profile.Level + 1
		levels = levels + 1
		local before = profile.SkillPoints
		profile.SkillPoints = math.min(Config.MaxSkillPoints, before + Config.LevelUpSkillPoints)
		points = points + (profile.SkillPoints - before)
	end
	if profile.Level >= Config.MaxLevel then
		profile.XP = 0
	end
	return levels, points
end

-- Возвращает, сколько монет реально добавлено (кошелёк ограничен MaxCoins).
function Rules.AddCoins(profile, amount)
	if not finite(amount) or amount <= 0 then
		return 0
	end
	local before = profile.Coins
	profile.Coins = math.min(Config.MaxCoins, before + math.floor(amount))
	return profile.Coins - before
end

-- Инвентарь -------------------------------------------------------------------------------------
function Rules.Count(profile, itemId)
	return profile.Inventory[itemId] or 0
end

-- Сколько штук можно продать/потратить: надетый экземпляр не считается.
function Rules.FreeCount(profile, itemId)
	local count = Rules.Count(profile, itemId)
	local def = itemDef(itemId)
	if def and def.Kind == "Gear" and profile.Equipped[def.Slot] == itemId then
		count = count - 1
	end
	return math.max(0, count)
end

-- Возвращает, сколько штук реально добавлено (стак ограничен MaxStack).
function Rules.AddItem(profile, itemId, amount)
	amount = amount or 1
	if not itemDef(itemId) or not isInteger(amount, 1, 1000000000) then
		return 0
	end
	local before = Rules.Count(profile, itemId)
	local after = math.min(Config.MaxStack, before + amount)
	if after > 0 then
		profile.Inventory[itemId] = after
	end
	return after - before
end

function Rules.RemoveItem(profile, itemId, amount)
	amount = amount or 1
	if not itemDef(itemId) or not isInteger(amount, 1, Config.MaxStack) then
		return false
	end
	local count = Rules.Count(profile, itemId)
	if count < amount then
		return false
	end
	local left = count - amount
	if left > 0 then
		profile.Inventory[itemId] = left
	else
		profile.Inventory[itemId] = nil
		local def = itemDef(itemId)
		if def.Kind == "Gear" and profile.Equipped[def.Slot] == itemId then
			profile.Equipped[def.Slot] = nil
		end
	end
	return true
end

function Rules.Equip(profile, itemId)
	local def = itemDef(itemId)
	if not def or def.Kind ~= "Gear" then
		return false, "Этот предмет нельзя надеть."
	end
	if Rules.Count(profile, itemId) < 1 then
		return false, "Предмета нет в инвентаре."
	end
	if profile.Equipped[def.Slot] == itemId then
		return false, "Уже надето."
	end
	profile.Equipped[def.Slot] = itemId
	return true, def.Slot
end

function Rules.Unequip(profile, slot)
	if type(slot) ~= "string" or not Config.SlotNames[slot] then
		return false, "Неизвестный слот."
	end
	if not profile.Equipped[slot] then
		return false, "Слот уже пуст."
	end
	profile.Equipped[slot] = nil
	return true, slot
end

-- Скупщик ---------------------------------------------------------------------------------------
function Rules.IsJunk(itemId)
	local def = itemDef(itemId)
	return def ~= nil and (def.Kind == "Trash" or def.Junk == true)
end

-- Возвращает (true, монеты) или (false, причина).
function Rules.Sell(profile, itemId, amount)
	local def = itemDef(itemId)
	if not def or not def.Sell then
		return false, "Скупщик это не берёт."
	end
	if not isInteger(amount, 1, Config.MaxStack) then
		return false, "Неверное количество."
	end
	if Rules.FreeCount(profile, itemId) < amount then
		if Rules.Count(profile, itemId) >= amount then
			return false, "Сначала сними надетый предмет."
		end
		return false, "Не хватает предметов."
	end
	Rules.RemoveItem(profile, itemId, amount)
	return true, Rules.AddCoins(profile, def.Sell * amount)
end

-- Стоимость и количество всего хлама (надетое не учитывается).
function Rules.JunkValue(profile)
	local value, count = 0, 0
	for _, itemId in ipairs(Config.ItemOrder) do
		if Rules.IsJunk(itemId) then
			local free = Rules.FreeCount(profile, itemId)
			if free > 0 then
				value = value + free * Config.Items[itemId].Sell
				count = count + free
			end
		end
	end
	return value, count
end

-- Возвращает (true, монеты, штук) или (false, причина).
function Rules.SellAllJunk(profile)
	local value, count = Rules.JunkValue(profile)
	if count <= 0 then
		return false, "Хлама для продажи нет."
	end
	for _, itemId in ipairs(Config.ItemOrder) do
		if Rules.IsJunk(itemId) then
			local free = Rules.FreeCount(profile, itemId)
			if free > 0 then
				Rules.RemoveItem(profile, itemId, free)
			end
		end
	end
	return true, Rules.AddCoins(profile, value), count
end

-- Кузнец ----------------------------------------------------------------------------------------
function Rules.InShop(itemId)
	return table.find(Config.ShopOrder, itemId) ~= nil
end

-- Возвращает (true, цена) или (false, причина).
function Rules.Buy(profile, itemId)
	local def = itemDef(itemId)
	if not def or not def.Price or not Rules.InShop(itemId) then
		return false, "Кузнец это не продаёт."
	end
	if Rules.Count(profile, itemId) >= Config.MaxStack then
		return false, "Инвентарь переполнен этим предметом."
	end
	if profile.Coins < def.Price then
		return false, "Не хватает монет (нужно " .. Rules.FormatNumber(def.Price) .. ")."
	end
	profile.Coins = profile.Coins - def.Price
	Rules.AddItem(profile, itemId, 1)
	return true, def.Price
end

function Rules.UsePotion(profile, itemId, now)
	local def = itemDef(itemId)
	if not def or def.Kind ~= "Potion" then
		return false, "Это не зелье."
	end
	if Rules.Count(profile, itemId) < 1 then
		return false, "Зелья нет в инвентаре."
	end
	local remaining = Rules.BuffRemaining(profile, def.Buff, now)
	if remaining + def.Duration > Config.BuffMaxSeconds then
		return false, "Эффект уже почти на максимуме (60 мин)."
	end
	Rules.RemoveItem(profile, itemId, 1)
	profile.Buffs[def.Buff] = now + remaining + def.Duration
	return true, def.Buff
end

-- Награда за моба. roll() -> число в [0, 1).
function Rules.Reward(profile, mobId, roll, now)
	local def = Config.Mobs[mobId]
	local result = { Coins = 0, XP = 0, Items = {}, Levels = 0, Points = 0 }
	if not def then
		return result
	end
	local low, high = def.Coins[1], def.Coins[2]
	local base = math.min(high, low + math.floor(roll() * (high - low + 1)))
	result.Coins = Rules.AddCoins(profile, base * Rules.BuffMultiplier(profile, "Coins", now))
	if profile.Level < Config.MaxLevel then
		result.XP = math.floor(def.XP * Rules.BuffMultiplier(profile, "XP", now) + 0.5)
		result.Levels, result.Points = Rules.AddXP(profile, result.XP)
	end
	for _, entry in ipairs(def.Loot) do
		if roll() < entry.Chance and Rules.AddItem(profile, entry.Item, 1) > 0 then
			table.insert(result.Items, entry.Item)
		end
	end
	profile.Kills = math.min(Config.MaxKills, profile.Kills + 1)
	return result
end

-- Состояние для клиента: снимок + готовые производные числа (клиент ничего не пересчитывает).
function Rules.ClientState(profile, now)
	local state = Rules.Snapshot(profile, now)
	state.XPRequired = Rules.XPRequired(profile.Level)
	state.Derived = Rules.Derived(profile)
	state.JunkValue, state.JunkCount = Rules.JunkValue(profile)
	return state
end

-- Форматирование -------------------------------------------------------------------------------
local SUFFIXES = { "", "K", "M", "B", "T" }

function Rules.FormatNumber(value)
	value = tonumber(value) or 0
	local negative = value < 0
	value = math.abs(value)
	local index = 1
	while value >= 1000 and index < #SUFFIXES do
		value = value / 1000
		index = index + 1
	end
	local text
	if index == 1 then
		text = tostring(math.floor(value))
	elseif value >= 100 then
		text = string.format("%d", math.floor(value)) .. SUFFIXES[index]
	else
		text = string.format("%.1f", math.floor(value * 10) / 10):gsub("%.0$", "") .. SUFFIXES[index]
	end
	if negative then
		return "-" .. text
	end
	return text
end

function Rules.FormatTime(seconds)
	seconds = math.max(0, math.floor(tonumber(seconds) or 0))
	local hours = math.floor(seconds / 3600)
	local minutes = math.floor((seconds % 3600) / 60)
	local rest = seconds % 60
	if hours > 0 then
		return string.format("%d:%02d:%02d", hours, minutes, rest)
	end
	return string.format("%d:%02d", minutes, rest)
end

function Rules.FormatStat(statId, value)
	local def = Config.Stats[statId]
	if not def then
		return tostring(value)
	end
	return string.format("%." .. def.Decimals .. "f", value) .. def.Suffix
end

-- Короткое описание бонуса предмета для карточек UI.
function Rules.BonusText(itemId)
	local def = itemDef(itemId)
	if not def then
		return ""
	end
	if def.Kind == "Gear" then
		local parts = {}
		if (def.Damage or 0) > 0 then
			table.insert(parts, "+" .. def.Damage .. " урона")
		end
		if (def.Health or 0) > 0 then
			table.insert(parts, "+" .. def.Health .. " ХП")
		end
		return table.concat(parts, ", ")
	elseif def.Kind == "Potion" then
		local buff = Config.Buffs[def.Buff]
		return buff.Short .. " на " .. math.floor(def.Duration / 60) .. " мин"
	end
	return "Продажа: " .. def.Sell .. " монет"
end

-- Teleports share this pure server-side level check with the UI.
function Rules.CanTeleport(profile, islandId)
 local island = type(islandId) == "string" and Config.Islands[islandId]
 if not island then return false, "Неизвестный остров." end
 if profile.Level < island.Level then return false, "Нужен уровень " .. island.Level .. "." end
 return true, island.Name
end

-- Deliberately discard only low-value junk; rare trade materials are protected.
function Rules.DiscardJunk(profile)
 local removed = 0
 for _, itemId in ipairs(Config.ItemOrder) do
  local def = Config.Items[itemId]
  if def.Rarity == "Junk" or def.Junk == true then
   local amount = Rules.FreeCount(profile, itemId)
   if amount > 0 then
    Rules.RemoveItem(profile, itemId, amount)
    removed = removed + amount
   end
  end
 end
 return removed > 0, removed > 0 and ("Удалено мусора: " .. removed .. ".") or "Нет мусора для удаления."
end

-- Гайд новичка ----------------------------------------------------------------------------------
function Rules.TutorialActive(profile)
	return (profile.Tutorial or 1) <= #Config.Tutorial.Steps
end

function Rules.TutorialStep(profile)
	if not Rules.TutorialActive(profile) then
		return nil
	end
	return Config.Tutorial.Steps[profile.Tutorial], profile.Tutorial
end

local function tutorialSatisfied(profile, stepId, event, data)
	if stepId == "Slimes" then
		return event == "Kill" and data == "Slime"
	elseif stepId == "Equip" then
		return (event == "Equip" and itemDef(data) ~= nil and itemDef(data).Slot == "Weapon") or (event == "Enter" and profile.Equipped.Weapon ~= nil)
	elseif stepId == "Upgrade" then
		return event == "Upgrade"
	elseif stepId == "Sell" then
		return event == "Sell"
	end
	return false
end

local function finishTutorial(profile)
	profile.Tutorial = #Config.Tutorial.Steps + 1
	profile.TutorialProgress = 0
	local coins = Rules.AddCoins(profile, Config.Tutorial.RewardCoins)
	local added = Rules.AddItem(profile, Config.Tutorial.RewardItem, 1)
	return coins, added > 0 and Config.Tutorial.RewardItem or nil
end

-- Применяет событие к гайду. Возвращает таблицу { Changed, Advanced, Finished, Coins, Item, Granted } или nil.
-- Granted — предметы, выданные гайдом (гарантированный Старый меч и немного хлама для шага продажи).
function Rules.TutorialEvent(profile, event, data)
	local step = Rules.TutorialStep(profile)
	if not step or not tutorialSatisfied(profile, step.Id, event, data) then
		return nil
	end
	local result = { Changed = true, Advanced = false, Finished = false, Granted = {} }
	profile.TutorialProgress = (profile.TutorialProgress or 0) + 1
	while step and profile.TutorialProgress >= (step.Goal or 1) do
		result.Advanced = true
		if step.Id == "Slimes" then
			if Rules.Count(profile, "OldSword") <= 0 and Rules.AddItem(profile, "OldSword", 1) > 0 then
				table.insert(result.Granted, "OldSword")
			end
			if Rules.FreeCount(profile, "SlimeGel") <= 0 and Rules.AddItem(profile, "SlimeGel", 2) > 0 then
				table.insert(result.Granted, "SlimeGel")
			end
		end
		profile.Tutorial = profile.Tutorial + 1
		profile.TutorialProgress = 0
		step = Rules.TutorialStep(profile)
		if not step then
			result.Finished = true
			result.Coins, result.Item = finishTutorial(profile)
		elseif tutorialSatisfied(profile, step.Id, "Enter", nil) then
			profile.TutorialProgress = step.Goal or 1
		end
	end
	return result
end

function Rules.TutorialSkip(profile)
	if not Rules.TutorialActive(profile) then
		return false, "Гайд уже пройден."
	end
	profile.Tutorial = #Config.Tutorial.Steps + 1
	profile.TutorialProgress = 0
	return true, "Гайд пропущен. Удачной охоты!"
end

-- Подземелья ------------------------------------------------------------------------------------
function Rules.CanEnterDungeon(profile, dungeonId)
	local def = type(dungeonId) == "string" and Config.Dungeons[dungeonId]
	if not def then
		return false, "Неизвестное подземелье."
	end
	if profile.Level < def.Level then
		return false, "Нужен уровень " .. def.Level .. "."
	end
	return true, def.Name
end

-- Награда сундука после победы над боссом подземелья. roll() -> [0, 1).
function Rules.DungeonChest(profile, dungeonId, roll, now)
	local def = Config.Dungeons[dungeonId]
	local result = { Coins = 0, XP = 0, Items = {}, Levels = 0, Points = 0 }
	if not def then
		return result
	end
	local chest = def.Chest
	local low, high = chest.Coins[1], chest.Coins[2]
	local base = math.min(high, low + math.floor(roll() * (high - low + 1)))
	result.Coins = Rules.AddCoins(profile, base * Rules.BuffMultiplier(profile, "Coins", now))
	if profile.Level < Config.MaxLevel then
		result.XP = math.floor(chest.XP * Rules.BuffMultiplier(profile, "XP", now) + 0.5)
		result.Levels, result.Points = Rules.AddXP(profile, result.XP)
	end
	for _, entry in ipairs(chest.Loot) do
		if roll() < entry.Chance and Rules.AddItem(profile, entry.Item, 1) > 0 then
			table.insert(result.Items, entry.Item)
		end
	end
	return result
end
return Rules
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000016"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00000015"><Properties><string name="Name">GladeSlayerServer</string></Properties><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">CharacterService</string><ProtectedString name="Source"><![CDATA[-- GladeSlayer: персонаж игрока на сервере — MaxHealth/WalkSpeed из прокачки и снаряжения,
-- регенерация ХП (стандартный скрипт Health заменён пустым), 3D-снаряжение на теле, урон от мобов.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GladeSlayer")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("Rules"))
local Models = require(Shared:WaitForChild("Models"))

local CharacterService = {}
local DataService = nil

local function parts(character)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return humanoid, root
end

local function limb(character, slot)
	if slot == "Weapon" then
		return character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	end
	return character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
end

local function gearFolder(character)
	local folder = character:FindFirstChild("GladeGear")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "GladeGear"
		folder.Parent = character
	end
	return folder
end

-- Пересобирает 3D-модель в слоте, только если предмет поменялся.
local function attach(character, slot, itemId)
	local folder = gearFolder(character)
	local current = folder:FindFirstChild(slot)
	if current and current:GetAttribute("ItemId") == itemId then
		return
	end
	if current then
		current:Destroy()
	end
	if not itemId then
		return
	end
	local part0 = limb(character, slot)
	if not part0 then
		return
	end
	local model = Models.BuildItem(itemId, part0.Size)
	if not model or not model.PrimaryPart then
		return
	end
	model.Name = slot
	for _, item in ipairs(model:GetDescendants()) do
		if item:IsA("BasePart") then
			item.Anchored = false
			item.CanCollide = false
			item.CanQuery = false
			item.CanTouch = false
			item.Massless = true
		end
	end
	local offset = CFrame.new()
	if slot == "Weapon" then
		-- Рукоять в кулаке, клинок вперёд: при взмахе рукой клинок описывает дугу.
		offset = CFrame.new(0, -part0.Size.Y * 0.45, 0)
	end
	model:PivotTo(part0.CFrame * offset)
	local weld = Instance.new("Weld")
	weld.Name = "GladeGearWeld"
	weld.Part0 = part0
	weld.Part1 = model.PrimaryPart
	weld.C0 = offset
	weld.Parent = model.PrimaryPart
	model.Parent = folder
end

function CharacterService.Apply(player, heal)
	local profile = DataService.Get(player)
	local character = player.Character
	local humanoid = parts(character)
	if not profile or not humanoid then
		return
	end
	local derived = Rules.Derived(profile)
	local ratio = humanoid.MaxHealth > 0 and humanoid.Health / humanoid.MaxHealth or 1
	humanoid.MaxHealth = derived.MaxHealth
	if heal then
		humanoid.Health = derived.MaxHealth
	elseif humanoid.Health > 0 then
		humanoid.Health = math.clamp(derived.MaxHealth * ratio, 1, derived.MaxHealth)
	end
	humanoid.WalkSpeed = derived.WalkSpeed
	character:SetAttribute("Weapon", profile.Equipped.Weapon or "")
	character:SetAttribute("Level", profile.Level)
	for _, slot in ipairs(Config.Slots) do
		attach(character, slot, profile.Equipped[slot])
	end
end

-- Урон игроку от моба. Возвращает true, если удар прошёл.
function CharacterService.Damage(player, amount)
	local humanoid = parts(player.Character)
	if not humanoid or humanoid.Health <= 0 then
		return false
	end
	humanoid:TakeDamage(amount)
	return true
end

function CharacterService.Init(dataService)
	DataService = dataService
	DataService.OnChanged(function(player)
		CharacterService.Apply(player, false)
	end)
end

local function onCharacter(player, character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid then
		return
	end
	-- Ждём R15/R6-части, чтобы снаряжение было к чему приварить.
	character:WaitForChild("HumanoidRootPart", 10)
	task.wait(0.2)
	if DataService.Get(player) then
		CharacterService.Apply(player, true)
	end
	humanoid.Died:Connect(function()
		DataService.Toast(player, "Ты пал! Возрождение через " .. Players.RespawnTime .. " с.", "error")
	end)
end

function CharacterService.Start()
	local function hook(player)
		player.CharacterAdded:Connect(function(character)
			onCharacter(player, character)
		end)
		if player.Character then
			task.spawn(onCharacter, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(hook)
	for _, player in ipairs(Players:GetPlayers()) do
		hook(player)
	end

	-- Регенерация и защита от падения за карту: раз в секунду.
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in ipairs(Players:GetPlayers()) do
				local profile = DataService.Get(player)
				local humanoid, root = parts(player.Character)
				if profile and humanoid and humanoid.Health > 0 then
					if humanoid.Health < humanoid.MaxHealth then
						local regen = Rules.Derived(profile).Regen
						humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + regen)
					end
					if root and root.Position.Y < Config.FallResetY then
						root.AssemblyLinearVelocity = Vector3.zero
						player.Character:PivotTo(CFrame.new(Config.SpawnPosition + Vector3.new(0, 4, 0)))
					end
				end
			end
		end
	end)
end

return CharacterService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">CombatService</string><ProtectedString name="Source"><![CDATA[-- GladeSlayer: серверная боёвка. Клиент сообщает только «я ударил» (без аргументов) — кулдаун, хитбокс,
-- дистанцию, линию видимости, урон и криты считает сервер. Подменить цель или урон с клиента нельзя.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GladeSlayer")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("Rules"))

local CombatService = {}
local DataService, MobService, Remotes
local rng = Random.new()
local buckets = {}
local lastSwing = {}
local combo = {}

-- Токен-бакет: не больше AttackBurst событий подряд и AttackRefillPerSecond в секунду.
local function allow(player)
	local combat = Config.Combat
	local now = os.clock()
	local bucket = buckets[player]
	if not bucket then
		bucket = { Tokens = combat.AttackBurst, Updated = now }
		buckets[player] = bucket
	end
	bucket.Tokens = math.min(combat.AttackBurst, bucket.Tokens + (now - bucket.Updated) * combat.AttackRefillPerSecond)
	bucket.Updated = now
	if bucket.Tokens < 1 then
		return false
	end
	bucket.Tokens = bucket.Tokens - 1
	return true
end

local function alive(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and root and humanoid.Health > 0 then
		return character, humanoid, root
	end
	return nil
end

local function clearLine(character, origin, target)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character, MobService.GetFolder() }
	params.IgnoreWater = true
	pcall(function()
		params.RespectCanCollide = true
	end)
	local result = workspace:Raycast(origin, target - origin, params)
	return result == nil or not result.Instance.CanCollide
end

-- Разрешение удара в момент «импакта» анимации: бокс перед игроком только по папке мобов.
local function resolve(player, sword)
	local profile = DataService.Get(player)
	local character, _, root = alive(player)
	if not profile or not character then
		return
	end
	local combat = Config.Combat
	local reach = sword and combat.SwordReach or combat.FistReach
	local maxTargets = sword and combat.SwordMaxTargets or 1

	local boxCFrame = root.CFrame * CFrame.new(0, 0, -reach / 2)
	local boxSize = Vector3.new(combat.HitboxWidth, combat.HitboxHeight, reach + 2)
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Include
	overlap.FilterDescendantsInstances = { MobService.GetFolder() }
	local parts = workspace:GetPartBoundsInBox(boxCFrame, boxSize, overlap)

	local seen, candidates = {}, {}
	local origin = root.Position
	for _, part in ipairs(parts) do
		local mob = MobService.FromPart(part)
		if mob and not seen[mob] and not mob.Dead then
			seen[mob] = true
			local offset = mob.Root.Position - origin
			local flat = Vector3.new(offset.X, 0, offset.Z).Magnitude - mob.Def.Radius
			-- Дистанция пересчитывается по корню моба: клиент не может «дотянуться» дальше разрешённого.
			if flat <= reach + combat.ExtraReachTolerance and math.abs(offset.Y) <= combat.HitboxHeight + mob.Def.HipHeight then
				if clearLine(character, origin, mob.Root.Position) then
					table.insert(candidates, { Mob = mob, Distance = flat })
				end
			end
		end
	end
	if #candidates == 0 then
		return
	end
	table.sort(candidates, function(a, b)
		return a.Distance < b.Distance
	end)

	local now = os.clock()
	local derived = Rules.Derived(profile)
	local base = derived.Damage * Rules.BuffMultiplier(profile, "Damage", now)
	for index = 1, math.min(maxTargets, #candidates) do
		local crit = rng:NextNumber() < combat.CritChance
		local amount = base
		if crit then
			amount = amount * combat.CritMultiplier
		end
		amount = math.max(1, math.floor(amount + 0.5))
		MobService.Damage(candidates[index].Mob, player, amount, crit)
	end
end

local function onAttack(player)
	if not allow(player) then
		return
	end
	local profile = DataService.Get(player)
	local character = alive(player)
	if not profile or not character then
		return
	end
	local combat = Config.Combat
	local sword = profile.Equipped.Weapon ~= nil
	local cooldown = sword and combat.SwordCooldown or combat.FistCooldown
	local now = os.clock()
	local last = lastSwing[player]
	if last and now - last < cooldown * combat.CooldownTolerance then
		return
	end
	lastSwing[player] = now
	combo[player] = (combo[player] or 0) + 1
	local odd = combo[player] % 2 == 1
	local style
	if sword then
		style = odd and "SwordSlash1" or "SwordSlash2"
	else
		style = odd and "PunchRight" or "PunchLeft"
	end
	Remotes.FX:FireAllClients("Swing", character, style)
	task.delay(sword and combat.SwordImpactDelay or combat.FistImpactDelay, function()
		local ok, err = pcall(resolve, player, sword)
		if not ok then
			warn("[GladeSlayer] Удар: " .. tostring(err))
		end
	end)
end

function CombatService.Init(dataService, mobService, remotes)
	DataService = dataService
	MobService = mobService
	Remotes = remotes
	remotes.Attack.OnServerEvent:Connect(function(player)
		local ok, err = pcall(onAttack, player)
		if not ok then
			warn("[GladeSlayer] Атака: " .. tostring(err))
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
		lastSwing[player] = nil
		combo[player] = nil
	end)
end

return CombatService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- GladeSlayer: профили игроков в DataStore с «арендой» сессии (защита от дюпа при перескоке между серверами)
-- и безопасным фоллбэком в память, если плейс не опубликован или API DataStore выключен в Studio.
-- Запись в хранилище: { Data = Rules.Snapshot(...), Lease = { Job = JobId, Expires = os.time() + LeaseSeconds } }.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GladeSlayer")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("Rules"))

local DataService = {}

local hooks = {}
local profiles = {}
local listeners = {}
local saving = {}
local memoryStore = {}
local store = nil
local useMemory = false
local jobId = game.JobId ~= "" and game.JobId or ("studio-" .. tostring(math.random(1, 1000000000)))

local function keyFor(player)
	return "Player_" .. player.UserId
end

local function openStore()
	local studio = RunService:IsStudio()
	if studio and (Config.StudioForceMemory or game.PlaceId == 0) then
		useMemory = true
		warn("[GladeSlayer] DataStore: Studio без опубликованного плейса — прогресс хранится только в памяти.")
		return
	end
	local name = Config.DataStoreName .. (studio and Config.StudioStoreSuffix or "")
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(name)
	end)
	if ok and result then
		store = result
	else
		useMemory = true
		warn("[GladeSlayer] DataStore недоступен (" .. tostring(result) .. ") — прогресс только в памяти.")
	end
end

-- UpdateAsync с повторами. transform(old) -> new | nil (nil = отмена записи).
local function update(key, transform)
	if useMemory then
		local old = memoryStore[key] and Rules.CopyRecord(memoryStore[key]) or nil
		local new = transform(old)
		if new ~= nil then
			memoryStore[key] = Rules.CopyRecord(new)
		end
		return true, new
	end
	local lastError = nil
	for attempt = 1, Config.SaveAttempts do
		local ok, result = pcall(function()
			return store:UpdateAsync(key, transform)
		end)
		if ok then
			return true, result
		end
		lastError = result
		task.wait(attempt * 1.5)
	end
	-- Ошибка API в Studio (например, «API Services» выключены): переходим в память, чтобы игра продолжалась.
	if RunService:IsStudio() and tostring(lastError):find("403") then
		useMemory = true
		warn("[GladeSlayer] DataStore запрещён в Studio — переключаюсь на память.")
		return update(key, transform)
	end
	return false, lastError
end

local function leaseFree(record)
	local lease = type(record) == "table" and record.Lease or nil
	return type(lease) ~= "table" or lease.Job == jobId or (tonumber(lease.Expires) or 0) <= os.time()
end

function DataService.Init(hookTable)
	hooks = hookTable or {}
	openStore()
end

function DataService.Toast(player, text, kind)
	if hooks.Toast then
		hooks.Toast(player, text, kind)
	end
end

function DataService.Get(player)
	return profiles[player]
end

function DataService.OnChanged(callback)
	table.insert(listeners, callback)
end

function DataService.Changed(player)
	if not profiles[player] then
		return
	end
	for _, callback in ipairs(listeners) do
		task.spawn(callback, player)
	end
end

function DataService.IsMemory()
	return useMemory
end

-- Загружает профиль, захватывая аренду. Возвращает true, если игрок может играть.
function DataService.Load(player)
	local key = keyFor(player)
	local deadline = os.clock() + Config.LeaseSeconds + Config.LeaseSafetySeconds
	local profile, problem = nil, nil
	while player.Parent and os.clock() < deadline do
		local busy = false
		problem = nil
		local ok, result = update(key, function(old)
			busy = false
			problem = nil
			if old ~= nil and not leaseFree(old) then
				busy = true
				return nil
			end
			local record = type(old) == "table" and old or {}
			if record.Data ~= nil then
				local decoded, reason = Rules.Decode(record.Data, os.clock())
				if not decoded then
					problem = reason
					return nil
				end
			end
			record.Lease = { Job = jobId, Expires = os.time() + Config.LeaseSeconds }
			return record
		end)
		if not ok then
			problem = "DataStore не отвечает: " .. tostring(result)
			break
		end
		if problem then
			break
		end
		if not busy then
			if type(result) == "table" and result.Data ~= nil then
				profile = Rules.Decode(result.Data, os.clock())
			else
				profile = Rules.NewProfile()
			end
			break
		end
		DataService.Toast(player, "Прошлая сессия ещё сохраняется, ждём…", "info")
		task.wait(5)
	end
	if not player.Parent then
		return false
	end
	if not profile then
		-- Не выдаём пустой профиль поверх существующего: лучше переподключение, чем потерянный прогресс.
		player:Kick("Не удалось загрузить прогресс. " .. tostring(problem or "Сессия занята.") .. " Зайди ещё раз через минуту.")
		return false
	end
	profiles[player] = profile
	if useMemory then
		DataService.Toast(player, "Studio: сохранение в памяти — прогресс сбросится после остановки.", "info")
	end
	return true
end

-- Сохраняет профиль. release = true снимает аренду (выход игрока / закрытие сервера).
function DataService.Save(player, release)
	local profile = profiles[player]
	if not profile then
		return false
	end
	if saving[player] then
		return false
	end
	saving[player] = true
	local snapshot = Rules.Snapshot(profile, os.clock())
	local lost = false
	local ok, err = update(keyFor(player), function(old)
		if old ~= nil and not leaseFree(old) then
			lost = true
			return nil
		end
		local record = type(old) == "table" and old or {}
		record.Data = snapshot
		if release then
			record.Lease = nil
		else
			record.Lease = { Job = jobId, Expires = os.time() + Config.LeaseSeconds }
		end
		return record
	end)
	saving[player] = nil
	if not ok then
		warn("[GladeSlayer] Сохранение " .. player.Name .. ": " .. tostring(err))
		return false
	end
	if lost then
		warn("[GladeSlayer] Аренда профиля " .. player.Name .. " перехвачена другим сервером — запись пропущена.")
		return false
	end
	return true
end

function DataService.Unload(player)
	if not profiles[player] then
		return
	end
	local deadline = os.clock() + 10
	while saving[player] and os.clock() < deadline do
		task.wait(0.1)
	end
	DataService.Save(player, true)
	profiles[player] = nil
end

function DataService.Shutdown()
	local pending = 0
	for player in pairs(profiles) do
		pending = pending + 1
		task.spawn(function()
			pcall(DataService.Save, player, true)
			pending = pending - 1
		end)
	end
	local deadline = os.clock() + 25
	while pending > 0 and os.clock() < deadline do
		task.wait(0.1)
	end
end

function DataService.Start()
	-- Автосохранение (продлевает аренду).
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			for player in pairs(profiles) do
				task.spawn(DataService.Save, player, false)
			end
		end
	end)
	-- Истечение баффов зелий.
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.clock()
			for player, profile in pairs(profiles) do
				if Rules.PruneBuffs(profile, now) then
					DataService.Changed(player)
					DataService.Toast(player, "Действие зелья закончилось.", "info")
				end
			end
		end
	end)
	-- Страховка: если игрок ушёл, а Unload не вызван (ошибка в обработчике), всё равно сохраняем.
	Players.PlayerRemoving:Connect(function(player)
		task.delay(15, function()
			if profiles[player] and not player.Parent then
				DataService.Unload(player)
			end
		end)
	end)
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">DungeonService</string><ProtectedString name="Source"><![CDATA[-- GladeSlayer: подземелья. Каждый забег — отдельная арена (DungeonWorld) в своём слоте далеко от островов:
-- обратный отсчёт → 3 волны усиленных мобов → босс подземелья → сундук с наградой и портал на Поляну.
-- Общий таймер забега; смерть, выход из игры или истечение времени — провал. Всё решает сервер.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("GladeSlayer")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("Rules"))

local DungeonWorld = require(script.Parent:WaitForChild("DungeonWorld"))

local DungeonService = {}
local DataService, MobService, Remotes
local byPlayer = {}
local slots = {}
local container = nil
local nextRun = 0
local rng = Random.new()

local MAX_SLOTS = 8
local VICTORY_STAY = 120

function DungeonService.InDungeon(player)
	return byPlayer[player] ~= nil
end

local function payload(run)
	local def = Config.Dungeons[run.Id]
	return {
		Active = true,
		Id = run.Id,
		Name = def.Name,
		Stage = run.Stage,
		Wave = run.Wave,
		Waves = #def.Waves + 1,
		Remaining = run.Remaining,
		Total = run.Total,
		TimeLeft = math.max(0, math.floor((run.Deadline - os.clock()) + 0.5)),
	}
end

local function sendState(run)
	if run.Player.Parent then
		Remotes.Dungeon:FireClient(run.Player, payload(run))
	end
end

local function toast(player, text, kind)
	if player.Parent then
		Remotes.Toast:FireClient(player, text, kind or "info")
	end
end

local function rootOf(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and root and humanoid.Health > 0 then
		return root, character
	end
	return nil
end

local function sendHome(player)
	local root, character = rootOf(player)
	if root then
		character:PivotTo(CFrame.new(Config.Islands.Glade.Arrival))
		root.AssemblyLinearVelocity = Vector3.zero
	end
end

local function finish(run, success, message)
	if run.Ended then
		return
	end
	run.Ended = true
	for _, connection in ipairs(run.Connections) do
		connection:Disconnect()
	end
	MobService.DespawnTag(run.Tag)
	byPlayer[run.Player] = nil
	if run.Player.Parent then
		Remotes.Dungeon:FireClient(run.Player, { Active = false, Success = success, Message = message })
		if message then
			toast(run.Player, message, success and "success" or "error")
		end
		local root = rootOf(run.Player)
		if root and (root.Position - run.Info.Center).Magnitude < run.Info.Radius + 60 then
			sendHome(run.Player)
		end
	end
	task.delay(2, function()
		run.Info.Folder:Destroy()
		slots[run.Slot] = nil
	end)
end

local function spawnGroup(run, group)
	local points = run.Info.MobSpawns
	local list = {}
	for mobId, amount in pairs(group) do
		for _ = 1, amount do
			table.insert(list, mobId)
		end
	end
	table.sort(list)
	local offset = rng:NextInteger(0, #points - 1)
	run.Remaining = #list
	run.Total = #list
	for index, mobId in ipairs(list) do
		local point = points[((index + offset - 1) % #points) + 1]
		MobService.Spawn(mobId, {
			Position = point, NoRespawn = true, AggroRange = 90, LeashRange = run.Info.Radius + 30, Tag = run.Tag,
			OnDeath = function()
				run.Remaining = math.max(0, run.Remaining - 1)
				sendState(run)
			end,
		})
	end
end

local function openChest(run, player, chest)
	if run.ChestOpened or player ~= run.Player then
		return
	end
	local profile = DataService.Get(player)
	local root = rootOf(player)
	if not profile or not root or (root.Position - chest.PrimaryPart.Position).Magnitude > 14 then
		return
	end
	run.ChestOpened = true
	local result = Rules.DungeonChest(profile, run.Id, function()
		return rng:NextNumber()
	end, os.clock())
	local lid = chest:FindFirstChild("ChestLid", true)
	if lid and lid:IsA("BasePart") then
		TweenService:Create(lid, TweenInfo.new(0.6, Enum.EasingStyle.Back), { CFrame = lid.CFrame * CFrame.new(0, 0.4, 0.6) * CFrame.Angles(math.rad(-70), 0, 0) }):Play()
	end
	Remotes.FX:FireClient(player, "Loot", chest.PrimaryPart.Position, { Coins = result.Coins, XP = result.XP, Items = result.Items })
	if #result.Items > 0 then
		toast(player, "Сундук: " .. MobService.ItemNames(result.Items), "loot")
	end
	if result.Levels > 0 and player.Character then
		Remotes.FX:FireAllClients("LevelUp", player.Character, profile.Level)
		toast(player, "Новый уровень " .. profile.Level .. "! +" .. result.Points .. " очков навыков (K — прокачка)", "success")
	end
	DataService.Changed(player)
	local prompt = chest:FindFirstChildWhichIsA("ProximityPrompt", true)
	if prompt then
		prompt.Enabled = false
	end
end

local function victory(run)
	local def = Config.Dungeons[run.Id]
	run.Stage = "Victory"
	run.Deadline = os.clock() + VICTORY_STAY
	run.Remaining = 0
	sendState(run)
	toast(run.Player, def.Name .. " зачищено! Открой сундук и войди в портал.", "success")
	local chest = DungeonWorld.BuildChest(run.Info.ChestCFrame, def.Color)
	chest.Parent = run.Info.Folder
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "DungeonChest"
	prompt.ActionText, prompt.ObjectText = "Открыть", "Сундук подземелья"
	prompt.KeyboardKeyCode, prompt.HoldDuration = Enum.KeyCode.E, 0.5
	prompt.MaxActivationDistance, prompt.RequiresLineOfSight = 12, false
	prompt.Parent = chest.PrimaryPart
	prompt.Triggered:Connect(function(player)
		openChest(run, player, chest)
	end)
	local portal = DungeonWorld.BuildReturnPortal(run.Info.PortalCFrame)
	portal.Parent = run.Info.Folder
	local core = portal:FindFirstChild("PortalCore", true)
	if core then
		local exit = Instance.new("ProximityPrompt")
		exit.Name = "DungeonExit"
		exit.ActionText, exit.ObjectText = "Вернуться", "Портал на Поляну"
		exit.KeyboardKeyCode, exit.HoldDuration = Enum.KeyCode.E, 0.3
		exit.MaxActivationDistance, exit.RequiresLineOfSight = 12, false
		exit.Parent = core
		exit.Triggered:Connect(function(player)
			local root = rootOf(player)
			if player == run.Player and root and (root.Position - core.Position).Magnitude <= 15 then
				if not run.ChestOpened then
					openChest(run, player, chest)
				end
				finish(run, true, "Ты вернулся на Поляну с добычей!")
			end
		end)
	end
end

local function spawnBoss(run)
	local def = Config.Dungeons[run.Id]
	run.Stage = "Boss"
	run.Wave = #def.Waves + 1
	run.Remaining = 1
	run.Total = 1
	toast(run.Player, "Финальная волна: " .. Config.Mobs[def.Boss].Name .. "!", "error")
	MobService.Spawn(def.Boss, {
		Position = run.Info.BossSpawn, NoRespawn = true, AggroRange = 120, LeashRange = run.Info.Radius + 30, Tag = run.Tag,
		OnDeath = function()
			if not run.Ended then
				victory(run)
			end
		end,
	})
end

local function loop(run)
	local def = Config.Dungeons[run.Id]
	local nextAt = os.clock() + Config.DungeonCountdown
	while not run.Ended do
		task.wait(0.5)
		if run.Ended then
			break
		end
		local now = os.clock()
		local root = run.Player.Parent and rootOf(run.Player)
		if not run.Player.Parent then
			finish(run, false, nil)
			break
		end
		if not root or (root.Position - run.Info.Center).Magnitude > run.Info.Radius + 60 then
			finish(run, false, "Подземелье провалено: ты покинул арену.")
			break
		end
		if now >= run.Deadline then
			if run.Stage == "Victory" then
				finish(run, true, "Портал закрылся — ты вернулся на Поляну.")
			else
				finish(run, false, "Время вышло! Подземелье провалено.")
			end
			break
		end
		if run.Stage == "Countdown" or run.Stage == "Break" then
			if now >= nextAt then
				if run.Wave < #def.Waves then
					run.Wave = run.Wave + 1
					run.Stage = "Wave"
					spawnGroup(run, def.Waves[run.Wave])
					toast(run.Player, "Волна " .. run.Wave .. " из " .. (#def.Waves + 1) .. "!", "info")
				else
					spawnBoss(run)
				end
			end
		elseif run.Stage == "Wave" and run.Remaining <= 0 then
			run.Stage = "Break"
			nextAt = now + Config.DungeonWaveDelay
		end
		sendState(run)
	end
end

-- Возвращает (ok, сообщение). Проверки: уровень, не в бою, не в другом данже, жив, есть свободная арена.
function DungeonService.Enter(player, profile, dungeonId)
	local ok, message = Rules.CanEnterDungeon(profile, dungeonId)
	if not ok then
		return false, message
	end
	if byPlayer[player] then
		return false, "Ты уже в подземелье."
	end
	local root, character = rootOf(player)
	if not root then
		return false, "Сейчас нельзя войти в подземелье."
	end
	local combatAt = player:GetAttribute("GladeCombatAt")
	if combatAt and os.clock() - combatAt < Config.TeleportCombatSeconds then
		return false, "Нельзя войти в подземелье в бою. Подожди 8 секунд."
	end
	local slot = nil
	for index = 1, MAX_SLOTS do
		if not slots[index] then
			slot = index
			break
		end
	end
	if not slot then
		return false, "Все арены заняты. Попробуй через минуту."
	end
	local origin = Config.DungeonOrigin + Vector3.new(0, 0, (slot - 1) * Config.DungeonSlotSpacing)
	local built, info = pcall(DungeonWorld.Build, dungeonId, origin)
	if not built then
		warn("[GladeSlayer] Арена подземелья: " .. tostring(info))
		return false, "Не удалось построить арену. Попробуй ещё раз."
	end
	info.Folder.Parent = container
	nextRun = nextRun + 1
	local def = Config.Dungeons[dungeonId]
	local run = {
		Id = dungeonId, Player = player, Slot = slot, Info = info, Tag = "Dungeon" .. nextRun,
		Stage = "Countdown", Wave = 0, Remaining = 0, Total = 0, Ended = false, ChestOpened = false,
		Deadline = os.clock() + Config.DungeonCountdown + def.TimeLimit, Connections = {},
	}
	slots[slot] = run
	byPlayer[player] = run
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	table.insert(run.Connections, humanoid.Died:Connect(function()
		finish(run, false, "Ты пал в подземелье. Прокачайся и попробуй снова!")
	end))
	character:PivotTo(info.PlayerSpawn)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	sendState(run)
	task.spawn(loop, run)
	return true, "Подземелье: " .. def.Name .. ". Приготовься!"
end

function DungeonService.Leave(player)
	local run = byPlayer[player]
	if not run then
		return false, "Ты не в подземелье."
	end
	finish(run, false, "Ты покинул подземелье.")
	return true, ""
end

function DungeonService.Init(dataService, mobService, remotes)
	DataService = dataService
	MobService = mobService
	Remotes = remotes
	local old = workspace:FindFirstChild("GladeSlayerDungeons")
	if old then
		old:Destroy()
	end
	container = Instance.new("Folder")
	container.Name = "GladeSlayerDungeons"
	container.Parent = workspace
	local world = workspace:FindFirstChild("GladeSlayerWorld")
	if world then
		for _, prompt in ipairs(world:GetDescendants()) do
			if prompt:IsA("ProximityPrompt") and prompt.Name == "DungeonEntrance" then
				local core = prompt.Parent
				prompt.Triggered:Connect(function(player)
					local root = rootOf(player)
					-- Prompt можно подделать: дистанцию перепроверяем на сервере.
					if root and core:IsA("BasePart") and (root.Position - core.Position).Magnitude <= 18 then
						Remotes.OpenShop:FireClient(player, "Dungeons")
					end
				end)
			end
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		local run = byPlayer[player]
		if run then
			finish(run, false, nil)
		end
	end)
end

return DungeonService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">DungeonWorld</string><ProtectedString name="Source"><![CDATA[-- Underground dungeon arenas built from anchored Parts; one themed hall per Config.Dungeons entry.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("GladeSlayer"):WaitForChild("Config"))
local DungeonWorld = {}
local V = Vector3.new
local C = CFrame.new
local rgb = Color3.fromRGB
local M = Enum.Material

local HALF = 65 -- inner half-width of the hall
local HEIGHT = 32

local THEMES = {
 Catacombs = {
  floor = rgb(78,84,82), floorMat = M.Cobblestone, wall = rgb(64,70,72), wallMat = M.Slate,
  column = rgb(92,98,96), trim = rgb(48,54,52), fire = rgb(110,255,130), accent = rgb(120,230,140),
 },
 Tomb = {
  floor = rgb(196,166,112), floorMat = M.Sandstone, wall = rgb(176,146,98), wallMat = M.Sandstone,
  column = rgb(214,184,128), trim = rgb(150,120,76), fire = rgb(120,190,255), accent = rgb(255,205,100),
 },
 Forge = {
  floor = rgb(40,36,44), floorMat = M.Basalt, wall = rgb(34,30,38), wallMat = M.Basalt,
  column = rgb(58,50,60), trim = rgb(24,20,28), fire = rgb(255,140,60), accent = rgb(255,120,60),
 },
}

local function part(parent, name, size, cf, color, material, solid)
 local p = Instance.new("Part")
 p.Name, p.Size, p.CFrame = name, size, cf
 p.Color, p.Material, p.Anchored = color, material or M.Slate, true
 p.CanCollide = solid == true
 p.CanTouch = false
 p.CanQuery = solid == true
 p.CastShadow = solid == true
 p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
 p.Parent = parent
 return p
end
local function group(parent, name)
 local f = Instance.new("Folder")
 f.Name, f.Parent = name, parent
 return f
end
local function light(p, color, range, brightness)
 local l = Instance.new("PointLight")
 l.Color, l.Range, l.Brightness = color, range or 14, brightness or 1.4
 l.Parent = p
 return l
end
local function fire(p, color, size)
 local fx = Instance.new("Fire")
 fx.Color, fx.SecondaryColor = color, rgb(255,170,60)
 fx.Size, fx.Heat = size or 4, 6
 fx.Parent = p
 return fx
end
local function label(p, title, offset)
 local ui = Instance.new("BillboardGui")
 ui.Size = UDim2.fromOffset(260, 62)
 ui.StudsOffsetWorldSpace = V(0, offset or 5, 0)
 ui.MaxDistance, ui.AlwaysOnTop = 75, true
 local t = Instance.new("TextLabel")
 t.Size, t.BackgroundTransparency = UDim2.fromScale(1, 1), 1
 t.Font, t.TextSize = Enum.Font.GothamBold, 18
 t.TextColor3, t.TextStrokeTransparency = Color3.new(1,1,1), 0.25
 t.TextWrapped, t.Text = true, title
 t.Parent = ui
 ui.Parent = p
end
local function disk(parent, name, pos, diameter, thickness, color, material)
 local p = part(parent,name,V(thickness,diameter,diameter),C(pos)*CFrame.Angles(0,0,math.pi/2),color,material)
 p.Shape = Enum.PartType.Cylinder
 return p
end
local function skull(parent, cf)
 local s = part(parent,"Skull",V(1.2,1.2,1.2),cf,rgb(224,218,198),M.Marble)
 s.Shape = Enum.PartType.Ball
 part(parent,"SkullJaw",V(0.8,0.3,0.7),cf*C(0,-0.7,-0.15),rgb(206,200,180),M.Marble)
 for _, side in ipairs({-1,1}) do
  local eye = part(parent,"SkullEye",V(0.32,0.32,0.2),cf*C(side*0.3,0.1,-0.55),rgb(8,6,8),M.SmoothPlastic)
  eye.Shape = Enum.PartType.Ball
 end
end
local function bonePile(parent, pos, rng)
 local cf = C(pos)*CFrame.Angles(0,rng:NextNumber(0,6.28),0)
 for i=1,3 do
  part(parent,"Bone",V(0.35,0.35,rng:NextNumber(1.8,3)),cf*C((i-2)*0.7,0.2+i*0.05,0)*CFrame.Angles(0,(i-2)*0.5,0),rgb(222,214,190),M.Marble)
 end
 if rng:NextNumber() < 0.6 then skull(parent,cf*C(0.5,0.9,0.4)) end
end
local function torch(parent, cf, color)
 part(parent,"TorchBracket",V(0.5,0.5,1.6),cf*C(0,-0.9,0.8),rgb(40,36,36),M.Metal)
 local head = part(parent,"TorchHead",V(0.9,0.7,0.9),cf*C(0,0,0.2),rgb(30,28,28),M.Metal)
 fire(head,color,5)
 light(head,color,24,1.6)
 part(parent,"TorchStick",V(0.4,2,0.4),cf*C(0,-0.6,0.3),rgb(70,48,32),M.Wood)
end
local function column(parent, pos, theme)
 local f = group(parent,"Column")
 part(f,"ColumnBase",V(6,1.6,6),C(pos+V(0,0.8,0)),theme.trim,M.Cobblestone,true)
 part(f,"ColumnShaft",V(4,HEIGHT-4,4),C(pos+V(0,HEIGHT/2,0)),theme.column,theme.wallMat,true)
 part(f,"ColumnCap",V(6,1.6,6),C(pos+V(0,HEIGHT-1.4,0)),theme.trim,M.Cobblestone,true)
 return f
end

local function gate(parent, base, theme)
 local f = group(parent,"Portcullis")
 local iron = rgb(48,46,52)
 part(f,"GateGap",V(13,13,0.4),base*C(0,6.5,-0.1),rgb(4,4,8),M.SmoothPlastic)
 for _, side in ipairs({-1,1}) do
  part(f,"GatePost",V(2,14,1.4),base*C(side*7.5,7,-0.7),theme.trim,M.Cobblestone)
 end
 part(f,"GateLintel",V(17,2,1.4),base*C(0,14.5,-0.7),theme.trim,M.Cobblestone)
 for i=-4,4 do
  part(f,"GateBar",V(0.4,13,0.4),base*C(i*1.5,6.6,-0.9),iron,M.Metal)
 end
 for _, y in ipairs({4,9}) do
  part(f,"GateCrossbar",V(13,0.4,0.4),base*C(0,y,-1.1),iron,M.Metal)
 end
end

local function catacombs(parent, theme, rng)
 local pools = {{-38,-32},{40,-36},{-44,20},{44,26},{-20,-52},{22,-50}}
 for i, p in ipairs(pools) do
  local d = rng:NextNumber(8,13)
  local pool = disk(parent,"SlimePool",V(p[1],0.07,p[2]),d,0.1,rgb(90,220,110),M.Neon)
  pool.Transparency = 0.35
  if i%2==1 then light(pool,theme.fire,16,1) end
  for j=1,3 do
   local b = part(parent,"SlimeBubble",V(0.7,0.7,0.7),C(p[1]+rng:NextNumber(-d/3,d/3),0.5,p[2]+rng:NextNumber(-d/3,d/3)),rgb(150,255,160),M.Glass)
   b.Shape, b.Transparency = Enum.PartType.Ball, 0.3
  end
 end
 for i=1,16 do
  local a = rng:NextNumber(0,6.28)
  local r = rng:NextNumber(30,60)
  bonePile(parent,V(math.cos(a)*r,0.1,math.sin(a)*r),rng)
 end
 for _, x in ipairs({-52,-26,26,52}) do
  part(parent,"CoffinNiche",V(8,5,0.6),C(x,6,-HALF+0.3),rgb(30,34,34),M.Slate)
  part(parent,"CoffinLid",V(7,0.8,2),C(x,3.4,-HALF+1.2),rgb(96,102,98),M.Cobblestone)
 end
end

local function tomb(parent, theme, rng, wallBases)
 for _, base in ipairs(wallBases) do
  part(parent,"GoldBand",V(136,2,0.4),base*C(0,22,-0.3),theme.accent,M.Metal)
  for i=-7,7,2 do
   part(parent,"Hieroglyph",V(1.2,1.2,0.3),base*C(i*8,19.5,-0.35),rgb(40,70,110),M.SmoothPlastic)
  end
 end
 for _, x in ipairs({-46,-22,22,46}) do
  local cf = CFrame.lookAt(V(x,0,-HALF+6),V(x,0,0))
  part(parent,"Sarcophagus",V(5,3,10),cf*C(0,1.5,0),rgb(214,184,128),M.Sandstone)
  part(parent,"SarcophagusLid",V(5.4,0.8,10.4),cf*C(0,3.3,0),theme.accent,M.Metal)
  part(parent,"SarcophagusMask",V(2,2,0.4),cf*C(0,3.9,3.6),rgb(60,110,180),M.SmoothPlastic)
 end
 for _, p in ipairs({{-34,-56},{34,-56},{-26,56},{26,56},{-58,-10},{58,-10}}) do
  part(parent,"BrazierStand",V(2,3,2),C(p[1],1.5,p[2]),theme.trim,M.Slate)
  local bowl = part(parent,"BrazierBowl",V(1,3.4,3.4),C(p[1],3.5,p[2])*CFrame.Angles(0,0,math.pi/2),theme.accent,M.Metal)
  bowl.Shape = Enum.PartType.Cylinder
  local flame = part(parent,"BrazierFlame",V(1,1,1),C(p[1],4.4,p[2]),rgb(120,190,255),M.Neon)
  flame.Transparency = 0.6
  fire(flame,theme.fire,6)
  light(flame,theme.fire,26,1.5)
 end
 for i=1,10 do
  local a = rng:NextNumber(0,6.28)
  local r = rng:NextNumber(34,60)
  part(parent,"SandDrift",V(6,0.4,4),C(math.cos(a)*r,0.2,math.sin(a)*r)*CFrame.Angles(0,a,0),rgb(226,196,138),M.Sand)
 end
 for i=1,8 do
  local a = rng:NextNumber(0,6.28)
  bonePile(parent,V(math.cos(a)*rng:NextNumber(34,58),0.1,math.sin(a)*rng:NextNumber(34,58)),rng)
 end
end

local function forge(parent, theme, rng)
 for _, x in ipairs({-58,58}) do
  local lava = part(parent,"LavaChannel",V(6,0.1,120),C(x,0.06,0),rgb(255,96,24),M.Neon)
  light(lava,rgb(255,120,50),30,2)
  for _, s in ipairs({-1,1}) do
   part(parent,"ObsidianCurb",V(1,0.6,120),C(x+s*3.5,0.3,0),rgb(18,14,24),M.Glass)
  end
 end
 for _, p in ipairs({{-26,-56},{26,-56},{-26,56},{26,56}}) do
  part(parent,"AnvilBase",V(3,2,2.4),C(p[1],1,p[2]),rgb(36,34,40),M.Metal)
  part(parent,"AnvilTop",V(4.6,0.9,2.2),C(p[1],2.45,p[2]),rgb(70,68,76),M.Metal)
  part(parent,"AnvilHorn",V(1.8,0.6,1.2),C(p[1]+2.8,2.5,p[2]),rgb(70,68,76),M.Metal)
  local ember = part(parent,"AnvilEmber",V(1.2,0.15,0.8),C(p[1],2.95,p[2]),rgb(255,120,50),M.Neon)
  light(ember,theme.fire,14,1.2)
 end
 for i=1,8 do
  local x,z = rng:NextNumber(-55,55),rng:NextNumber(-55,55)
  if math.sqrt(x*x+z*z) > 20 then
   part(parent,"ChainLine",V(0.4,12,0.4),C(x,HEIGHT-6,z),rgb(60,58,64),M.Metal)
   local hook = part(parent,"ChainHook",V(1.4,1.4,0.5),C(x,HEIGHT-12.6,z)*CFrame.Angles(0,i,0),rgb(80,76,84),M.Metal)
   hook.Shape = Enum.PartType.Cylinder
  end
 end
 for i=1,10 do
  local a = rng:NextNumber(0,6.28)
  local r = rng:NextNumber(30,58)
  part(parent,"SlagRock",V(2.4,1.4,2),C(math.cos(a)*r,0.7,math.sin(a)*r)*CFrame.Angles(0,a,0.2),rgb(54,46,56),M.Slate)
 end
end

function DungeonWorld.Build(dungeonId, origin)
 local def = Config.Dungeons[dungeonId]
 local theme = THEMES[def.Theme] or THEMES.Catacombs
 local seed = 0
 for i=1,string.len(dungeonId) do seed += dungeonId:byte(i)*i end
 local rng = Random.new(9100+seed)
 local model = Instance.new("Model")
 model.Name = "Dungeon_"..dungeonId
 local f = group(model,"Hall")
 local o = origin
 local floorY = o.Y
 -- Everything below is authored around (0,0,0) at floor level and shifted by origin.
 local rootCF = C(o.X,floorY,o.Z)
 local function at(x,y,z) return rootCF*C(x,y,z) end

 -- Shell: floor, thick walls, ceiling.
 part(f,"HallFloor",V(150,6,150),at(0,-3,0),theme.floor,theme.floorMat,true)
 local shell = group(f,"Shell")
 for _, side in ipairs({-1,1}) do
  part(shell,"HallWall",V(150,HEIGHT,6),at(0,HEIGHT/2,side*(HALF+3)),theme.wall,theme.wallMat,true)
  part(shell,"HallWall",V(6,HEIGHT,150),at(side*(HALF+3),HEIGHT/2,0),theme.wall,theme.wallMat,true)
 end
 part(shell,"HallCeiling",V(156,4,156),at(0,HEIGHT+2,0),theme.wall,theme.wallMat,true)
 -- Seal the corners against mobs/players clipping out.
 part(shell,"OuterSeal",V(170,2,170),at(0,-7,0),theme.trim,theme.wallMat,true)

 local decor = group(f,"Decor")
 local wallBases = {}
 for _, w in ipairs({{0,-HALF},{0,HALF},{-HALF,0},{HALF,0}}) do
  local wp = V(o.X+w[1],floorY,o.Z+w[2])
  table.insert(wallBases, CFrame.lookAt(wp,V(o.X,floorY,o.Z)))
 end
 -- Decorative helpers run in local space; shift whole folders to world afterwards.

 -- Ceiling beams, floor emblem.
 for i=-3,3 do
  part(decor,"CeilingBeam",V(4,3,150),at(i*20,HEIGHT-1.5,0),theme.trim,M.Cobblestone)
 end
 disk(decor,"FloorEmblem",at(0,0.05,0).Position,34,0.1,theme.trim,M.Slate)
 local ring = disk(decor,"FloorRing",at(0,0.08,0).Position,30,0.1,theme.accent,M.Neon)
 ring.Transparency = 0.7
 disk(decor,"FloorEmblemInner",at(0,0.1,0).Position,26,0.1,theme.floor,theme.floorMat)
 for i=1,12 do
  local a = i*math.pi/6
  local rune = part(decor,"FloorRune",V(1.2,0.1,1.2),at(math.cos(a)*14.5,0.14,math.sin(a)*14.5)*CFrame.Angles(0,a,math.pi/4),theme.accent,M.Neon)
  if i%4==0 then light(rune,theme.accent,16,1) end
 end

 -- Columns avoid the central 30-stud circle, spawn lanes and the portal/chest line.
 local colPositions = {{-45,-45},{45,-45},{-45,45},{45,45},{-45,0},{45,0},{0,-45},{-45,-22},{45,-22},{-45,22},{45,22}}
 for _, p in ipairs(colPositions) do column(f,at(p[1],0,p[2]).Position,theme) end

 -- Wall torches, gates and wall trim.
 for i, base in ipairs(wallBases) do
  for _, t in ipairs({-50,-34,-18,18,34,50}) do
   torch(decor,base*C(t,9,-0.9)*CFrame.Angles(0,0,0),theme.fire)
  end
  part(decor,"WallPlinth",V(136,2,1),base*C(0,1,-0.5),theme.trim,M.Cobblestone)
  if i~=2 then gate(decor,base,theme) end
 end

 -- Scattered skulls and rubble.
 for i=1,10 do
  local a,r = rng:NextNumber(0,6.28),rng:NextNumber(24,62)
  part(decor,"Rubble",V(rng:NextNumber(1.2,2.6),0.9,rng:NextNumber(1.2,2.4)),at(math.cos(a)*r,0.45,math.sin(a)*r)*CFrame.Angles(0,a,0.15),theme.column,M.Rock)
 end
 local themeDecor = group(f,"ThemeDecor")
 local worldCenter = V(o.X,floorY,o.Z)
 local function shifted(builder, ...)
  local tmp = Instance.new("Folder")
  builder(tmp, ...)
  for _, p in ipairs(tmp:GetDescendants()) do
   if p:IsA("BasePart") then
    p.CFrame = rootCF * p.CFrame
    p.Parent = themeDecor
   end
  end
  tmp:Destroy()
 end
 if def.Theme == "Tomb" then
  local localBases = {}
  for _, w in ipairs({{0,-HALF},{0,HALF},{-HALF,0},{HALF,0}}) do
   localBases[#localBases+1] = CFrame.lookAt(V(w[1],0,w[2]),V(0,0,0))
  end
  shifted(tomb,theme,rng,localBases)
 elseif def.Theme == "Forge" then
  shifted(forge,theme,rng)
 else
  shifted(catacombs,theme,rng)
 end

 -- Floor-level dim ambience lights over the hall.
 for _, p in ipairs({{-30,-30},{30,-30},{-30,30},{30,30},{0,-55}}) do
  local lamp = part(decor,"AmbientLight",V(1,1,1),at(p[1],HEIGHT-4,p[2]),theme.accent,M.Neon)
  lamp.Transparency = 1
  light(lamp,theme.accent,50,0.5)
 end

 local spawns = {}
 local playerSpawnPos = V(o.X,floorY+3,o.Z+50)
 local function addSpawn(x,z)
  if (V(x,0,z)-V(0,0,50)).Magnitude >= 16 then spawns[#spawns+1] = V(o.X+x,floorY,o.Z+z) end
 end
 for i=0,7 do
  local a = i*math.pi/4
  addSpawn(math.sin(a)*32,math.cos(a)*32)
 end
 for k=0,3 do
  local a = math.rad(45+k*90)
  addSpawn(math.sin(a)*50,math.cos(a)*50)
 end
 addSpawn(-34,-8)
 addSpawn(34,-8)

 return {
  Folder = model,
  PlayerSpawn = CFrame.lookAt(playerSpawnPos,V(o.X,floorY+3,o.Z)),
  MobSpawns = spawns,
  BossSpawn = V(o.X,floorY,o.Z-28),
  ChestCFrame = CFrame.lookAt(V(o.X,floorY,o.Z-10),V(o.X,floorY,o.Z+50)),
  PortalCFrame = CFrame.lookAt(V(o.X,floorY,o.Z+57),V(o.X,floorY,o.Z)),
  Center = worldCenter,
  Radius = 62,
 }
end

function DungeonWorld.BuildChest(cframe, color)
 local m = Instance.new("Model")
 m.Name = "DungeonChest"
 local gold = rgb(236,186,64)
 local wood = rgb(122,80,44)
 local base = part(m,"ChestBase",V(5,2.6,3.2),cframe*C(0,1.3,0),wood,M.WoodPlanks,true)
 local lid = part(m,"ChestLid",V(5.2,1.2,3.4),cframe*C(0,3.2,0),wood,M.WoodPlanks)
 local arch = part(m,"ChestLidArch",V(5.2,1,3.4),cframe*C(0,3.9,0)*CFrame.Angles(0,0,0),rgb(138,92,52),M.WoodPlanks)
 arch.Size = V(4.4,0.8,3.2)
 for _, x in ipairs({-2.3,2.3}) do
  part(m,"ChestTrim",V(0.4,3.9,3.5),cframe*C(x,1.95,0),gold,M.Metal)
 end
 part(m,"ChestBand",V(5.4,0.4,3.5),cframe*C(0,2.65,0),gold,M.Metal)
 part(m,"ChestLock",V(1,1.2,0.3),cframe*C(0,2.6,-1.7),gold,M.Metal)
 local glow = part(m,"ChestGlow",V(0.9,0.9,0.9),cframe*C(0,2.6,-1.95),color,M.Neon)
 glow.Shape = Enum.PartType.Ball
 light(glow,color,22,2)
 local aura = part(m,"ChestAura",V(0.3,6,0.3),cframe*C(0,6,0),color,M.Neon)
 aura.Transparency = 0.75
 for _, p in ipairs({base,lid,arch}) do p.CanQuery = true end
 m.PrimaryPart = base
 m.Parent = nil
 return m
end

function DungeonWorld.BuildReturnPortal(cframe)
 local def = Config.Islands and Config.Islands.Glade
 local color = def and def.Color or rgb(120,230,150)
 local m = Instance.new("Model")
 m.Name = "ReturnPortal"
 local stone = rgb(86,85,103)
 part(m,"PortalPlinth",V(12,0.6,6),cframe*C(0,0.3,0),rgb(65,66,86),M.Marble,true)
 for _, side in ipairs({-1,1}) do
  part(m,"PortalPillar",V(1.4,9,1.6),cframe*C(side*4.5,5.1,0),stone,M.Slate,true)
  local gem = part(m,"PortalGem",V(0.9,1.6,0.9),cframe*C(side*4.5,10.4,0),color,M.Neon)
  gem.Shape = Enum.PartType.Ball
 end
 part(m,"PortalLintel",V(10.4,1,1.8),cframe*C(0,9.6,0),rgb(93,88,113),M.Marble,true)
 local core = part(m,"PortalCore",V(7.6,8.4,0.25),cframe*C(0,5.1,0),color,M.Neon)
 core.Transparency = 0.55
 light(core,color,24,2)
 label(core,"Портал на Поляну\nE — вернуться",7)
 m.PrimaryPart = core
 return m
end

return DungeonWorld
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source"><![CDATA[-- GladeSlayer: действия игрока через RemoteFunction «Request». Каждое действие проверяется на сервере:
-- типы аргументов, лимит частоты, дистанция до NPC, наличие монет и предметов (через Rules).
-- Клиент ничего не решает сам: он только просит, а сервер отвечает (ok, сообщение) и рассылает новое состояние.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GladeSlayer")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("Rules"))

local TravelService = require(script.Parent:WaitForChild("TravelService"))
local DungeonService = require(script.Parent:WaitForChild("DungeonService"))
local EconomyService = {}
EconomyService.OnSync = nil
-- Хук успешного действия: function(player, profile, action, arg) — используется гайдом новичка.
EconomyService.OnAction = nil

local DataService = nil
local buckets = {}

local function allow(player)
	local combat = Config.Combat
	local now = os.clock()
	local bucket = buckets[player]
	if not bucket then
		bucket = { Tokens = combat.RequestBurst, Updated = now }
		buckets[player] = bucket
	end
	bucket.Tokens = math.min(combat.RequestBurst, bucket.Tokens + (now - bucket.Updated) * combat.RequestRefillPerSecond)
	bucket.Updated = now
	if bucket.Tokens < 1 then
		return false
	end
	bucket.Tokens = bucket.Tokens - 1
	return true
end

local function validString(value)
	return type(value) == "string" and #value > 0 and #value <= 40
end

local function near(player, kind)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local npc = Config.NPC[kind]
	return root ~= nil and npc ~= nil and (root.Position - npc.Position).Magnitude <= Config.ShopDistance
end

local function itemName(itemId)
	local def = Config.Items[itemId]
	return def and def.Name or tostring(itemId)
end

local handlers = {}

function handlers.Upgrade(_, profile, statId)
	if not validString(statId) or not Config.Stats[statId] then
		return false, "Неизвестная характеристика."
	end
	local ok, result = Rules.Upgrade(profile, statId)
	if not ok then
		return false, result
	end
	return true, Config.Stats[statId].Name .. ": ур. " .. result
end

function handlers.Equip(_, profile, itemId)
	if not validString(itemId) then
		return false, "Неизвестный предмет."
	end
	local ok, result = Rules.Equip(profile, itemId)
	if not ok then
		return false, result
	end
	return true, "Надето: " .. itemName(itemId)
end

function handlers.Unequip(_, profile, slot)
	if not validString(slot) then
		return false, "Неизвестный слот."
	end
	local ok, result = Rules.Unequip(profile, slot)
	if not ok then
		return false, result
	end
	return true, "Снято: " .. Config.SlotNames[slot]
end

function handlers.UsePotion(_, profile, itemId)
	if not validString(itemId) then
		return false, "Неизвестный предмет."
	end
	local ok, result = Rules.UsePotion(profile, itemId, os.clock())
	if not ok then
		return false, result
	end
	local buff = Config.Buffs[result]
	return true, buff.Icon .. " " .. buff.Name .. ": " .. buff.Short
end

function handlers.Sell(player, profile, itemId, amount)
	if not near(player, "Merchant") then
		return false, "Подойди ближе к Скупщику."
	end
	if not validString(itemId) or not Rules.IsInteger(amount, 1, Config.MaxStack) then
		return false, "Неверный запрос."
	end
	local ok, coins = Rules.Sell(profile, itemId, amount)
	if not ok then
		return false, coins
	end
	return true, "Продано: " .. itemName(itemId) .. " x" .. amount .. " (+" .. Rules.FormatNumber(coins) .. " монет)"
end

function handlers.SellAll(player, profile)
	if not near(player, "Merchant") then
		return false, "Подойди ближе к Скупщику."
	end
	local ok, coins, sold = Rules.SellAllJunk(profile)
	if not ok then
		return false, coins
	end
	return true, "Продано хлама: " .. sold .. " шт. (+" .. Rules.FormatNumber(coins) .. " монет)"
end

function handlers.Buy(player, profile, itemId)
	if not near(player, "Blacksmith") then
		return false, "Подойди ближе к Кузнецу."
	end
	if not validString(itemId) then
		return false, "Неизвестный предмет."
	end
	local ok, price = Rules.Buy(profile, itemId)
	if not ok then
		return false, price
	end
	return true, "Куплено: " .. itemName(itemId) .. " (-" .. Rules.FormatNumber(price) .. " монет)"
end

function handlers.Teleport(player, profile, islandId)
 if not validString(islandId) then return false, "Неизвестный остров." end
 return TravelService.Teleport(player, profile, islandId)
end
function handlers.DiscardJunk(_, profile)
 return Rules.DiscardJunk(profile)
end
function handlers.SkipTutorial(_, profile)
	return Rules.TutorialSkip(profile)
end
function handlers.EnterDungeon(player, profile, dungeonId)
	if not validString(dungeonId) then
		return false, "Неизвестное подземелье."
	end
	return DungeonService.Enter(player, profile, dungeonId)
end
function handlers.LeaveDungeon(player)
	return DungeonService.Leave(player)
end
local function onRequest(player, action, a, b)
	if not allow(player) then
		return false, "Слишком часто. Подожди секунду."
	end
	if not validString(action) then
		return false, "Неизвестное действие."
	end
	local profile = DataService.Get(player)
	if action == "Sync" then
		if profile and EconomyService.OnSync then
			EconomyService.OnSync(player)
		end
		return profile ~= nil, ""
	end
	local handler = handlers[action]
	if not handler then
		return false, "Неизвестное действие."
	end
	if not profile then
		return false, "Профиль ещё загружается…"
	end
	local success, ok, message = pcall(handler, player, profile, a, b)
	if not success then
		warn("[GladeSlayer] Request " .. action .. ": " .. tostring(ok))
		return false, "Ошибка сервера. Попробуй ещё раз."
	end
	if ok then
		DataService.Changed(player)
		if EconomyService.OnAction then
			local hookOk, hookError = pcall(EconomyService.OnAction, player, profile, action, a)
			if not hookOk then
				warn("[GladeSlayer] OnAction " .. action .. ": " .. tostring(hookError))
			end
		end
	end
	return ok == true, type(message) == "string" and message or ""
end

function EconomyService.Init(dataService, remotes)
	DataService = dataService
	remotes.Request.OnServerInvoke = onRequest
	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

return EconomyService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">ExpansionWorld</string><ProtectedString name="Source"><![CDATA[-- Additive deterministic world decoration; legacy world/NPC coordinates are preserved.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("GladeSlayer"):WaitForChild("Config"))
local ExpansionWorld = {}
local V = Vector3.new
local C = CFrame.new
local rgb = Color3.fromRGB
local M = Enum.Material
local rng = Random.new(71023)
local function part(parent, name, size, cf, color, material, solid)
 local p = Instance.new("Part")
 p.Name, p.Size, p.CFrame = name, size, cf
 p.Color, p.Material, p.Anchored = color, material or M.Slate, true
 p.CanCollide = solid == true
 p.CanTouch = false
 p.CanQuery = solid == true
 p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
 p.Parent = parent
 return p
end
local function group(parent, name)
 local f = Instance.new("Folder")
 f.Name, f.Parent = name, parent
 return f
end
local function light(p, color, range)
 local l = Instance.new("PointLight")
 l.Color, l.Range, l.Brightness = color, range or 12, 1.5
 l.Parent = p
end
local function text(p, title)
 local ui = Instance.new("BillboardGui")
 ui.Size = UDim2.fromOffset(260, 62)
 ui.StudsOffsetWorldSpace = V(0, 5, 0)
 ui.MaxDistance, ui.AlwaysOnTop = 75, true
 local label = Instance.new("TextLabel")
 label.Size, label.BackgroundTransparency = UDim2.fromScale(1, 1), 1
 label.Font, label.TextSize = Enum.Font.GothamBold, 18
 label.TextColor3, label.TextStrokeTransparency = Color3.new(1,1,1), 0.25
 label.TextWrapped, label.Text = true, title
 label.Parent, ui.Parent = ui, p
end
local function crystal(parent, pos, color, scale)
 local base = part(parent,"CrystalRock",V(3,1.5,3)*scale,C(pos+V(0,0.5*scale,0)),rgb(65,68,83),M.Rock)
 for i=1,3 do
  local h = (2+i*0.8)*scale
  local p = part(parent,"Crystal",V(0.6*scale,h,0.6*scale),C(pos+V((i-2)*0.7*scale,h/2,0))*CFrame.Angles(0,0,(i-2)*0.2),color,M.Neon)
  if i==2 then light(p,color,10) end
 end
 return base
end
local function lantern(parent, pos, color)
 part(parent,"LanternFoot",V(1.6,0.4,1.6),C(pos+V(0,0.2,0)),rgb(58,50,48),M.Cobblestone)
 part(parent,"LanternPost",V(0.4,6,0.4),C(pos+V(0,3,0)),rgb(65,49,38),M.Wood)
 local lamp = part(parent,"LanternGlow",V(0.8,1.1,0.8),C(pos+V(0,6,0)),color,M.Neon)
 light(lamp,color,17)
 for _, y in ipairs({5.35,6.65}) do part(parent,"LanternCap",V(1.3,0.2,1.3),C(pos+V(0,y,0)),rgb(53,49,51),M.Metal) end
end
local function portal(parent, pos, destination, facing)
 local def = Config.Islands[destination]
 local f = group(parent,"Portal_"..destination)
 -- Local -Z of base points at `facing`, so the core plane faces the approaching player.
 local base = CFrame.lookAt(pos, V(facing.X, pos.Y, facing.Z))
 part(f,"PortalPlinth",V(12,0.5,10),base,rgb(65,66,86),M.Marble,true)
 for _, side in ipairs({-1,1}) do
  part(f,"PortalPillar",V(1.2,9,1.4),base*C(side*4.5,4.5,0),rgb(86,85,103),M.Slate,true)
  crystal(f,(base*C(side*4.5,9,0)).Position,def.Color,0.6)
 end
 part(f,"PortalLintel",V(10,0.9,1.6),base*C(0,9,0),rgb(93,88,113),M.Marble,true)
 local core = part(f,"PortalCore",V(7.5,7.8,0.25),base*C(0,4.5,0),def.Color,M.Neon)
 core.Transparency = 0.65
 light(core,def.Color,20)
 text(core,def.Name.."\nУровень "..def.Level.." • E — перейти")
 local prompt = Instance.new("ProximityPrompt")
 prompt.Name = "IslandTravel"
 prompt.ActionText, prompt.ObjectText = "Перейти", def.Name
 prompt.KeyboardKeyCode, prompt.HoldDuration = Enum.KeyCode.E, 0.4
 prompt.MaxActivationDistance, prompt.RequiresLineOfSight = 11, false
 prompt.Parent = core
 core:SetAttribute("DestinationIsland",destination)
end
local function clearSpawn(x,z)
 local p = V(x,2,z)
 for _, zone in pairs(Config.Zones) do
  if (p-zone.Center).Magnitude < zone.Radius+8 then return false end
 end
 return true
end
local function torch(parent, cf, color)
 part(parent,"TorchStick",V(0.4,2.6,0.4),cf,rgb(70,48,32),M.Wood)
 local head = part(parent,"TorchHead",V(0.8,0.6,0.8),cf*C(0,1.5,0),rgb(40,34,32),M.Metal)
 local fire = Instance.new("Fire")
 fire.Color, fire.SecondaryColor, fire.Size, fire.Heat = color, rgb(255,140,40), 4, 6
 fire.Parent = head
 light(head,color,16)
end
local function dungeonEntrance(parent)
 local f = group(parent,"DungeonEntrance")
 local base = CFrame.lookAt(V(40,2,134), V(0,2,118))
 local stone, dark = rgb(78,76,86), rgb(34,32,40)
 part(f,"EntranceSteps",V(16,0.3,9),base*C(0,0.15,-6.5),rgb(92,90,98),M.Cobblestone,true)
 part(f,"EntranceFloor",V(14,0.4,6),base*C(0,0.2,0),dark,M.Slate,true)
 for i=1,4 do
  part(f,"DescendingStep",V(8-i*0.6,0.1,1.2),base*C(0,0.46,-3.6+i*1.1),rgb(34-i*5,32-i*5,40-i*5),M.Slate)
 end
 for _, side in ipairs({-1,1}) do
  part(f,"ArchPillar",V(3,13,3.5),base*C(side*6,6.5,0),stone,M.Slate,true)
  part(f,"PillarBase",V(4.2,1.2,4.7),base*C(side*6,0.6,0),rgb(60,58,68),M.Cobblestone,true)
  part(f,"PillarCap",V(4.2,1,4.7),base*C(side*6,13.4,0),rgb(60,58,68),M.Cobblestone,true)
  torch(f,base*C(side*6,4.5,-2.4),rgb(255,150,60))
 end
 part(f,"ArchLintel",V(16,3,4),base*C(0,14.5,0),stone,M.Slate,true)
 part(f,"ArchKeystone",V(3,2,4.4),base*C(0,17,0),rgb(95,92,104),M.Cobblestone,true)
 part(f,"ArchVoid",V(9,12,0.6),base*C(0,6,1.2),rgb(8,6,12),M.SmoothPlastic,true)
 part(f,"ArchBackWall",V(16,13,1),base*C(0,6.5,2.6),dark,M.Slate,true)
 local skull = part(f,"Skull",V(2.4,2.4,2.4),base*C(0,17.6,-2.4),rgb(226,220,200),M.Marble)
 skull.Shape = Enum.PartType.Ball
 for _, side in ipairs({-1,1}) do
  local eye = part(f,"SkullEye",V(0.7,0.7,0.5),base*C(side*0.6,17.8,-3.4),rgb(10,8,10),M.SmoothPlastic)
  eye.Shape = Enum.PartType.Ball
  part(f,"SkullHorn",V(0.5,2.4,0.5),base*C(side*1.5,19,-2.4)*CFrame.Angles(0,0,-side*0.4),rgb(205,198,176),M.Marble)
 end
 part(f,"SkullJaw",V(1.8,0.6,1.4),base*C(0,16.4,-2.7),rgb(214,208,188),M.Marble)
 local core = part(f,"DungeonEntranceCore",V(8,6,3),base*C(0,3,-1),rgb(120,230,140),M.Neon)
 core.Transparency = 1
 local prompt = Instance.new("ProximityPrompt")
 prompt.Name = "DungeonEntrance"
 prompt.ActionText, prompt.ObjectText = "Подземелья", "Вход в подземелья"
 prompt.KeyboardKeyCode, prompt.HoldDuration = Enum.KeyCode.E, 0
 prompt.MaxActivationDistance, prompt.RequiresLineOfSight = 12, false
 prompt.Parent = core
 local label = part(f,"DungeonSign",V(1,1,1),base*C(0,14,-3),rgb(255,255,255),M.SmoothPlastic)
 label.Transparency = 1
 text(label,"ПОДЗЕМЕЛЬЯ\nE — выбрать данж")
 for _, off in ipairs({{-11,1},{11,-1},{-10,-5},{10,-5}}) do
  local rock = part(f,"Rubble",V(1.6,1,1.4),base*C(off[1],0.5,off[2])*CFrame.Angles(0,off[1],0.2),rgb(86,84,92),M.Rock)
  rock.CanCollide = false
 end
end
local function starter(parent)
 -- Remove only small pre-existing static decorations along the new portal approaches.
 for _, p in ipairs(parent:GetDescendants()) do
  if p:IsA("BasePart") and p.Anchored and p.Name~="Boundary" and p.Size.X<25 and p.Size.Z<25 then
   local pos=p.Position
   local inPath=math.abs(pos.X)<105 and math.abs(pos.Z-106)<7 and math.abs(pos.X)>20
   local inPortal=math.abs(math.abs(pos.X)-94)<14 and math.abs(pos.Z-106)<14
   if (inPath or inPortal) and pos.Y>Config.GroundY+0.5 then p:Destroy() end
  end
 end
 for _, p in ipairs(parent:GetDescendants()) do
  if p:IsA("BasePart") and p.Anchored and p.Name~="Boundary" and p.Size.X<25 and p.Size.Z<25 and p.Position.Y>Config.GroundY+0.5 then
   local pos=p.Position
   if (V(pos.X,0,pos.Z)-V(40,0,134)).Magnitude<14 then p:Destroy() end
  end
 end
 local f = group(parent,"GladeDetails")
 -- Side paths stop before the old boundary walls.
 for _, x in ipairs({-94,94}) do
  part(f,"PortalPath",V(math.abs(x),0.12,6),C(x/2,2.13,106),rgb(153,134,107),M.Cobblestone)
 end
 portal(f,V(-94,2.6,106),"Desert",V(0,2,106))
 portal(f,V(94,2.6,106),"Volcano",V(0,2,106))
 dungeonEntrance(f)
 for i=1,28 do
  local x,z = rng:NextNumber(-140,140), rng:NextNumber(-140,135)
  if clearSpawn(x,z) and math.abs(x)>65 and math.abs(z-106)>12 then
   local p = part(f,"MossyBoulder",V(3,2,4),C(x,2.8,z)*CFrame.Angles(0,i,0.2),rgb(94,115,96),M.Rock)
   p.Shape = Enum.PartType.Ball
   crystal(f,V(x+2.2,2,z),rgb(114,218,225),0.6)
   for j=1,3 do
    local leaf = part(f,"Fern",V(0.18,1.8,1),C(x+j-2,2.8,z+2)*CFrame.Angles(0,j,0.4),rgb(69,140,78),M.Grass)
    leaf.CastShadow = false
   end
  end
 end
 for _, x in ipairs({-17,17}) do
  for _, z in ipairs({48,86,129}) do lantern(f,V(x,2,z),rgb(255,224,151)) end
 end
 for _, npc in pairs(Config.NPC) do
  -- Extra display shelving behind existing stalls, not on their interaction side.
  local pos = npc.Position+V(0,0,-7)
  for _, h in ipairs({1.5,3.1}) do
   part(f,"DisplayShelf",V(8,0.22,1.4),C(pos+V(0,h,0)),rgb(104,70,43),M.WoodPlanks)
   for j=-2,2 do
    local bottle = part(f,"DisplayBottle",V(0.5,0.8,0.5),C(pos+V(j*1.2,h+0.5,0)),j%2==0 and rgb(86,183,204) or rgb(201,128,96),M.Glass)
    bottle.Transparency = 0.25
    part(f,"BottleStopper",V(0.3,0.2,0.3),bottle.CFrame*C(0,0.5,0),rgb(135,103,61),M.Wood)
   end
  end
  for _, side in ipairs({-1,1}) do
   part(f,"SupplyCrate",V(2.2,2.2,2.2),C(pos+V(side*6,1.1,1)),rgb(138,101,62),M.WoodPlanks)
   lantern(f,pos+V(side*7,0,2),rgb(255,207,126))
  end
 end
end
local function island(parent,id,cx,volcanic)
 local def = Config.Islands[id]
 local f = group(parent,id.."Island")
 local surface = volcanic and rgb(65,56,66) or rgb(214,184,124)
 part(f,"IslandBedrock",V(316,32,316),C(cx,-16,0),volcanic and rgb(35,29,42) or rgb(150,115,79),M.Rock,true)
 part(f,"IslandSurface",V(310,4,310),C(cx,0,0),surface,volcanic and M.Basalt or M.Sand,true)
 -- A safe, level path joins arrival and all farming areas. All decorative obstacles avoid spawn disks.
 part(f,"MainCauseway",V(9,0.15,245),C(cx,2.12,0),volcanic and rgb(102,78,85) or rgb(183,148,95),M.Cobblestone)
 for i=1,65 do
  local x,z = cx+rng:NextNumber(-144,144),rng:NextNumber(-144,144)
  if clearSpawn(x,z) and math.abs(x-cx)>17 and z<85 then
   if volcanic then
    local h = rng:NextNumber(6,19)
    part(f,"BasaltSpire",V(4,h,5),C(x,2+h/2,z)*CFrame.Angles(0,i,0.08),rgb(42,34,52),M.Basalt)
    if i%3==0 then crystal(f,V(x+4,2,z),rgb(255,102,49),0.8) end
   else
    local h = rng:NextNumber(1.5,4)
    local dune = part(f,"Dune",V(17,h,14),C(x,2+h/5,z),surface,M.Sand)
    dune.Shape = Enum.PartType.Ball
    if i%3==0 then
     part(f,"Cactus",V(1.2,5,1.2),C(x,4.5,z),rgb(83,134,86),M.Grass)
     part(f,"CactusArm",V(3,0.8,0.8),C(x,5,z),rgb(83,134,86),M.Grass)
    end
   end
  end
 end
 -- Ruin pillars stand outside each combat disk; the entire combat floor stays traversable.
 local templeZ = volcanic and -105 or -68
 for i=0,7 do
  local a = i*math.pi/4
  local templeX = volcanic and cx or cx+38
  local px,pz = templeX+math.cos(a)*49,templeZ+math.sin(a)*39
  local h = volcanic and 13 or 10
  part(f,"TempleColumn",V(3,h,3),C(px,2+h/2,pz),surface,M.Sandstone,true)
  part(f,"ColumnCap",V(4.5,1,4.5),C(px,2+h,pz),surface,M.Marble)
  local glow = part(f,"ColumnRune",V(1.1,1.1,0.15),C(px,6,pz-1.6)*CFrame.Angles(0,0,math.pi/4),def.Color,M.Neon)
  light(glow,def.Color,10)
 end
 if volcanic then
  -- Lava is visual only; no hidden unavoidable damage under the mob spawn floors.
  for _, x in ipairs({cx-116,cx+116}) do
   local lava = part(f,"LavaChannel",V(12,0.2,170),C(x,2.18,-10),rgb(255,96,24),M.Neon)
   light(lava,rgb(255,111,44),20)
  end
  part(f,"BossArena",V(94,0.25,86),C(cx,2.15,-105),rgb(74,57,70),M.Cobblestone,true)
  text(part(f,"ArenaSign",V(1,1,1),C(cx,7,-57),rgb(255,125,61),M.Neon),"ВЛАДЫКА ПЕПЛА\nКрасная зона — отступай!")
 else
  for step=0,5 do
   part(f,"DistantPyramid",V(65-step*9,3,65-step*9),C(cx+91,3.5+step*3,-112),rgb(188,149,91),M.Sandstone,true)
  end
 end
 for _, z in ipairs({72,30,-15}) do
  for _, x in ipairs({cx-14,cx+14}) do lantern(f,V(x,2,z),def.Color) end
 end
 portal(f,V(cx-22,2.6,114),"Glade",V(cx,2,114))
 portal(f,V(cx+22,2.6,114),volcanic and "Desert" or "Volcano",V(cx,2,114))
 if volcanic then
  part(f,"PortalPath",V(8,0.12,16),C(cx,2.13,130),rgb(102,78,85),M.Cobblestone)
  portal(f,V(cx,2.6,140),"Frost",V(cx,2,114))
 end
 text(part(f,"ArrivalMarker",V(1,1,1),C(cx,6,131),def.Color,M.Neon),def.Name.."\nРекомендуемый уровень: "..def.Level.."+")
 -- Low perimeter walls stop mobs leaving their island. Portals are entirely inside these walls.
 for _, side in ipairs({-1,1}) do
  part(f,"EdgeWall",V(310,6,2),C(cx,5,side*154),surface,M.Rock,true)
  part(f,"EdgeWall",V(2,6,310),C(cx+side*154,5,0),surface,M.Rock,true)
 end
end
-- Stacked tapering upright cylinders approximate a cone.
local function cone(parent, pos, radius, height, tiers, color, material, solid)
 local th = height/tiers
 for i=0,tiers-1 do
  local d = radius*2*(1-i/tiers)
  local p = part(parent,"ConeTier",V(th,math.max(d,0.4),math.max(d,0.4)),C(pos+V(0,th*(i+0.5),0))*CFrame.Angles(0,0,math.pi/2),color,material,solid)
  p.Shape = Enum.PartType.Cylinder
 end
end
local function disk(parent, name, pos, diameter, thickness, color, material, solid)
 local p = part(parent,name,V(thickness,diameter,diameter),C(pos)*CFrame.Angles(0,0,math.pi/2),color,material,solid)
 p.Shape = Enum.PartType.Cylinder
 return p
end
local function frost(parent)
 local cx = 2160
 local def = Config.Islands.Frost
 local f = group(parent,"FrostIsland")
 local throne = Config.Zones.FrostThrone.Center
 local ice, snow = rgb(176,220,245), rgb(236,244,250)
 -- Free of every spawn disk, the causeway, the throne arena and the portal/arrival strip.
 local function free(x,z,extra)
  if not clearSpawn(x,z) then return false end
  if math.abs(x-cx)<14 or z>95 or math.abs(x-cx)>144 or math.abs(z)>144 then return false end
  local dx,dz = x-throne.X,z-throne.Z
  return math.sqrt(dx*dx+dz*dz) > 58+(extra or 0)
 end
 part(f,"IslandBedrock",V(316,32,316),C(cx,-16,0),rgb(78,100,128),M.Rock,true)
 part(f,"IslandSurface",V(310,4,310),C(cx,0,0),snow,M.Snow,true)
 part(f,"MainCauseway",V(9,0.15,245),C(cx,2.12,0),rgb(150,185,215),M.Ice,false)
 -- Frozen lake (visual only) between the quarry and the rift, clear of all zones.
 disk(f,"FrozenLake",V(cx-98,2.12,-5),56,0.15,rgb(130,200,235),M.Glacier)
 disk(f,"FrozenLakeCore",V(cx-98,2.2,-5),34,0.1,rgb(170,225,248),M.Ice)
 for i=1,8 do
  local a = i*math.pi/4
  part(f,"LakeCrack",V(0.3,0.05,14),C(cx-98+math.cos(a)*9,2.3,-5+math.sin(a)*9)*CFrame.Angles(0,a,0),rgb(235,248,255),M.Neon)
 end
 -- Ice spires and crystals.
 local spires,crystals,pines = 0,0,0
 for i=1,260 do
  local x,z = cx+rng:NextNumber(-144,144),rng:NextNumber(-144,90)
  local lakeD = math.sqrt((x-(cx-98))^2+(z+5)^2)
  if free(x,z) and lakeD>34 then
   local kind = i%3
   if kind==0 and spires<26 then
    spires += 1
    local h = rng:NextNumber(8,20)
    part(f,"IceSpire",V(3.5,h,4),C(x,2+h/2,z)*CFrame.Angles(0,i,0.07),ice,M.Ice,true).Transparency = 0.15
   elseif kind==1 and crystals<20 then
    crystals += 1
    crystal(f,V(x,2,z),i%2==0 and rgb(120,210,255) or rgb(190,160,255),1.1)
   elseif kind==2 and pines<26 then
    pines += 1
    part(f,"PineTrunk",V(1,4,1),C(x,4,z),rgb(78,56,42),M.Wood)
    cone(f,V(x,5,z),3.6,7,3,rgb(60,100,92),M.Grass)
    cone(f,V(x,9,z),2.4,4,2,snow,M.Snow)
   end
  end
 end
 for _, a in ipairs({{-60,-20},{50,-6},{-70,60},{80,70}}) do
  local x,z = cx+a[1],a[2]
  if free(x,z) then
   local drift = part(f,"SnowDrift",V(14,2.4,10),C(x,2.2,z),snow,M.Snow)
   drift.Shape = Enum.PartType.Ball
  end
 end
 -- Void rift: glowing purple shards ringing the zone (decor only).
 local rift = Config.Zones.VoidRift
 for i=1,18 do
  local a = i*math.pi*2/18
  local pos = rift.Center+V(math.cos(a)*(rift.Radius+2),0,math.sin(a)*(rift.Radius+2))
  local h = 4+(i%4)*1.8
  local shard = part(f,"RiftShard",V(0.8,h,2.4),C(pos+V(0,h/2,0))*CFrame.Angles(0,-a,(i%3-1)*0.15),rgb(170,90,255),M.Neon)
  if i%6==0 then light(shard,rgb(170,90,255),18) end
 end
 disk(f,"RiftRing",rift.Center+V(0,0.18,0),rift.Radius*2,0.1,rgb(60,20,110),M.Neon).Transparency = 0.55
 disk(f,"RiftHeart",rift.Center+V(0,0.22,0),9,0.1,rgb(20,6,40),M.SmoothPlastic)
 -- Throne arena: flat 45-stud disk, rune rings and a boss sign; nothing collidable inside.
 disk(f,"ThroneArena",V(throne.X,2.15,throne.Z),84,0.3,rgb(182,206,230),M.Marble,true)
 disk(f,"ThroneRingOuter",V(throne.X,2.35,throne.Z),70,0.1,def.Color,M.Neon).Transparency = 0.4
 disk(f,"ThroneRingInner",V(throne.X,2.4,throne.Z),26,0.1,rgb(236,248,255),M.Glacier)
 for i=1,8 do
  local a = i*math.pi/4
  local rune = part(f,"ThroneRune",V(1.2,0.12,1.2),C(throne.X+math.cos(a)*20,2.5,throne.Z+math.sin(a)*20)*CFrame.Angles(0,a,math.pi/4),rgb(120,210,255),M.Neon)
  if i%2==0 then light(rune,def.Color,14) end
 end
 for i=0,9 do
  local a = math.rad(i*18)
  local px,pz = throne.X+math.cos(a)*54,throne.Z+math.sin(a)*54
  if math.abs(px-cx)<144 and pz>-146 and free(px,pz,-5) then
   part(f,"ArenaPillar",V(3.4,14,3.4),C(px,9,pz),ice,M.Ice,true).Transparency = 0.1
   crystal(f,V(px,16,pz),rgb(150,225,255),0.7)
  end
 end
 text(part(f,"ArenaSign",V(1,1,1),C(cx,7,-62),def.Color,M.Neon),"ИМПЕРАТОР ВЕЧНОЙ МЕРЗЛОТЫ\nКрасные круги — уклоняйся!")
 -- Citadel backdrop beyond the northern edge (never reachable).
 local cz = -190
 part(f,"CitadelCliff",V(280,32,62),C(cx,-14,cz+1),rgb(88,112,140),M.Rock)
 part(f,"CitadelCurtainWall",V(230,30,8),C(cx,17,-208),rgb(190,214,236),M.Ice)
 for _, x in ipairs({-110,-70,70,110}) do
  part(f,"CitadelTowerBody",V(14,50,14),C(cx+x,27,-208),rgb(176,200,226),M.Ice)
  cone(f,V(cx+x,52,-208),10,20,4,rgb(80,120,190),M.Glacier)
  local w = part(f,"TowerWindow",V(2.2,4,0.3),C(cx+x,40,-215.2),rgb(160,235,255),M.Neon)
  if x>0 then light(w,rgb(160,235,255),20) end
 end
 part(f,"CitadelKeep",V(60,64,30),C(cx,34,-215),rgb(170,196,224),M.Ice)
 for _, x in ipairs({-22,0,22}) do
  part(f,"KeepTower",V(12,80,12),C(cx+x,42,-215),rgb(190,214,236),M.Ice)
  cone(f,V(cx+x,82,-215),9,22+(x==0 and 14 or 0),4,rgb(92,130,205),M.Glacier)
 end
 part(f,"CitadelGateway",V(16,22,2),C(cx,13,-199),rgb(14,18,34),M.SmoothPlastic)
 local gateGlow = part(f,"CitadelGateGlow",V(14,20,0.4),C(cx,12,-200.2),rgb(120,200,255),M.Neon)
 gateGlow.Transparency = 0.5
 light(gateGlow,rgb(120,200,255),30)
 for i=-5,5 do
  part(f,"CitadelMerlon",V(6,4,8),C(cx+i*20,34,-208),rgb(190,214,236),M.Ice)
 end
 for _, z in ipairs({72,30,-15}) do
  for _, x in ipairs({cx-14,cx+14}) do lantern(f,V(x,2,z),rgb(150,220,255)) end
 end
 portal(f,V(cx-22,2.6,114),"Glade",V(cx,2,114))
 portal(f,V(cx+22,2.6,114),"Volcano",V(cx,2,114))
 text(part(f,"ArrivalMarker",V(1,1,1),C(cx,6,131),def.Color,M.Neon),def.Name.."\nРекомендуемый уровень: "..def.Level.."+")
 for _, side in ipairs({-1,1}) do
  part(f,"EdgeWall",V(310,6,2),C(cx,5,side*154),snow,M.Rock,true)
  part(f,"EdgeWall",V(2,6,310),C(cx+side*154,5,0),snow,M.Rock,true)
 end
end
function ExpansionWorld.Build(parent)
 starter(parent)
 island(parent,"Desert",720,false)
 island(parent,"Volcano",1440,true)
 frost(parent)
end
return ExpansionWorld
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX0000000F"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- GladeSlayer: точка входа сервера. Создаёт Remotes, строит карту, запускает сервисы и синхронизацию состояния.
-- Структура: ServerScriptService.GladeSlayerServer (этот Script + модули сервисов),
-- ReplicatedStorage.GladeSlayer (Config, Rules, Models, Animator + папка Remotes, которую создаёт этот скрипт).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GladeSlayer")
local Rules = require(Shared:WaitForChild("Rules"))

local Server = script.Parent
local WorldBuilder = require(Server:WaitForChild("WorldBuilder"))
local DataService = require(Server:WaitForChild("DataService"))
local CharacterService = require(Server:WaitForChild("CharacterService"))
local MobService = require(Server:WaitForChild("MobService"))
local CombatService = require(Server:WaitForChild("CombatService"))
local EconomyService = require(Server:WaitForChild("EconomyService"))
local NPCService = require(Server:WaitForChild("NPCService"))

local REMOTE_EVENTS = { "Attack", "State", "FX", "OpenShop", "Toast", "Dungeon" }

-- Папка Remotes попадает в ReplicatedStorage только полностью собранной: клиент не увидит половину.
local function createRemotes()
	local old = Shared:FindFirstChild("Remotes")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "Remotes"
	local remotes = {}
	for _, name in ipairs(REMOTE_EVENTS) do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
		remotes[name] = remote
	end
	local request = Instance.new("RemoteFunction")
	request.Name = "Request"
	request.Parent = folder
	remotes.Request = request
	folder.Parent = Shared
	return remotes
end

local Remotes = createRemotes()
Players.RespawnTime = 3

local built, buildError = pcall(WorldBuilder.Build)
if not built then
	warn("[GladeSlayer] Ошибка генерации карты: " .. tostring(buildError))
end

local function toast(player, text, kind)
	if player and player.Parent then
		Remotes.Toast:FireClient(player, text, kind or "info")
	end
end

DataService.Init({ Toast = toast })
CharacterService.Init(DataService)
MobService.Init(DataService, CharacterService, Remotes)
CombatService.Init(DataService, MobService, Remotes)
EconomyService.Init(DataService, Remotes)
NPCService.Start(Remotes)
require(Server:WaitForChild("TravelService")).Init(DataService, Remotes)
require(Server:WaitForChild("DungeonService")).Init(DataService, MobService, Remotes)
require(Server:WaitForChild("TutorialService")).Init(DataService, Remotes, MobService, EconomyService)
MobService.Start()
CharacterService.Start()
DataService.Start()

-- Синхронизация: изменения профиля собираются и уходят клиенту не чаще раза в 0.15 с.
local dirty = {}

local function sendState(player)
	local profile = DataService.Get(player)
	if profile and player.Parent then
		dirty[player] = nil
		Remotes.State:FireClient(player, Rules.ClientState(profile, os.clock()))
	end
end

DataService.OnChanged(function(player)
	dirty[player] = true
end)
EconomyService.OnSync = sendState

local function onPlayerAdded(player)
	if DataService.Load(player) and player.Parent then
		CharacterService.Apply(player, true)
		sendState(player)
		toast(player, "Добро пожаловать на Поляну! ЛКМ — удар, I — инвентарь, K — прокачка, J — подземелья, T — телепорты, E — NPC и порталы.", "info")
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	dirty[player] = nil
	DataService.Unload(player)
end)

game:BindToClose(function()
	DataService.Shutdown()
end)

task.spawn(function()
	while true do
		task.wait(0.15)
		local due = {}
		for player in pairs(dirty) do
			table.insert(due, player)
		end
		for _, player in ipairs(due) do
			if player.Parent then
				sendState(player)
			else
				dirty[player] = nil
			end
		end
	end
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">MobService</string><ProtectedString name="Source"><![CDATA[-- GladeSlayer: мобы — спавн по зонам или по точкам (арены подземелий), ИИ (агр, преследование, «поводок»,
-- ближняя атака с замахом, снаряды дальников, удары по площади), боссы с фазами, призывом миньонов и
-- телеграфами AoE, полоска ХП, урон, награда (убийце и всем, кто нанёс ≥ RewardShare ХП) и респавн.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("GladeSlayer")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("Rules"))
local Models = require(Shared:WaitForChild("Models"))

local MobService = {}
-- Хук убийства: function(player, profile, mobId) — вызывается для каждого получившего награду.
MobService.OnKill = nil
local DataService, CharacterService, Remotes
local folder = nil
local mobs = {}
local byModel = {}
local rng = Random.new()

local AI_STEP = 0.2
local MOB_GROUP = "GladeMobs"

-- Мобы не сталкиваются друг с другом (не толкаются и не залезают сверху), но сталкиваются с миром и игроками.
pcall(function()
	local PhysicsService = game:GetService("PhysicsService")
	if not PhysicsService:IsCollisionGroupRegistered(MOB_GROUP) then
		PhysicsService:RegisterCollisionGroup(MOB_GROUP)
	end
	PhysicsService:CollisionGroupSetCollidable(MOB_GROUP, MOB_GROUP, false)
end)

local function rollFn()
	return rng:NextNumber()
end

local function randomPoint(zone)
	local angle = rng:NextNumber() * math.pi * 2
	local radius = math.sqrt(rng:NextNumber()) * zone.Radius
	return Vector3.new(zone.Center.X + math.cos(angle) * radius, Config.GroundY, zone.Center.Z + math.sin(angle) * radius)
end

local function buildBar(mob)
	local def = mob.Def
	local gui = Instance.new("BillboardGui")
	gui.Name = "MobBar"
	gui.Size = UDim2.fromOffset(def.Boss and 310 or 150, def.Boss and 48 or 34)
	-- Смещение в мировых осях: полоска не качается вместе с поворотом/наклоном корня.
	gui.StudsOffsetWorldSpace = Vector3.new(0, def.BarHeight, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = def.Boss and 200 or 90
	gui.LightInfluence = 0
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, 0, 0, def.Boss and 24 or 16)
	title.Font = Enum.Font.GothamBold
	title.TextSize = def.Boss and 18 or 13
	title.TextColor3 = Color3.new(1, 1, 1)
	title.TextStrokeTransparency = 0.4
	title.Text = def.Name .. "  [ур. " .. def.Level .. "]"
	title.Parent = gui
	local back = Instance.new("Frame")
	back.Name = "Back"
	back.Position = UDim2.new(0, 0, 0, def.Boss and 29 or 19)
	back.Size = UDim2.new(1, 0, 0, def.Boss and 17 or 11)
	back.BackgroundColor3 = Color3.fromRGB(30, 22, 26)
	back.BorderSizePixel = 0
	back.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = back
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(10, 8, 10)
	stroke.Thickness = 1.5
	stroke.Parent = back
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.new(1, 1, 1)
	fill.BorderSizePixel = 0
	fill.Parent = back
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(Color3.fromRGB(255, 96, 96), Color3.fromRGB(200, 40, 60))
	gradient.Rotation = 90
	gradient.Parent = fill
	gui.Parent = mob.Root
	mob.Fill = fill
end

local function updateBar(mob)
	if mob.Fill then
		local ratio = math.clamp(mob.Humanoid.Health / mob.Humanoid.MaxHealth, 0, 1)
		mob.Fill.Size = UDim2.fromScale(ratio, 1)
	end
end

-- opts (все поля необязательны): Position (точка пола), NoRespawn, NoReward, AggroRange, LeashRange,
-- OnDeath(mob, killer), Tag (метка группы для массового удаления), Owner (босс, призвавший миньона).
local function spawnMob(mobId, opts)
	opts = opts or {}
	local def = Config.Mobs[mobId]
	if not def then
		return nil
	end
	local home = opts.Position
	if not home then
		local zone = def.Zone and Config.Zones[def.Zone]
		if not zone then
			return nil
		end
		home = randomPoint(zone)
	end
	local model = Models.BuildMob(mobId)
	if not model then
		return nil
	end
	local root = model.PrimaryPart
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local height = def.HipHeight + root.Size.Y / 2 + 0.4
	local yaw = rng:NextNumber() * math.pi * 2
	model:PivotTo(CFrame.new(home + Vector3.new(0, height, 0)) * CFrame.Angles(0, yaw, 0))
	humanoid.MaxHealth = def.Health
	humanoid.Health = def.Health
	humanoid.WalkSpeed = def.WalkSpeed
	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	-- Мобы не прыгают и не карабкаются: иначе слизни запрыгивают друг на друга и на заборы.
	for _, state in ipairs({ Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Ragdoll, Enum.HumanoidStateType.Climbing, Enum.HumanoidStateType.Swimming, Enum.HumanoidStateType.Jumping }) do
		humanoid:SetStateEnabled(state, false)
	end
	humanoid.UseJumpPower = true
	humanoid.JumpPower = 0
	humanoid.MaxSlopeAngle = 30
	for _, item in ipairs(model:GetDescendants()) do
		if item:IsA("BasePart") then
			item.CollisionGroup = MOB_GROUP
		end
	end
	model:SetAttribute("MobId", mobId)
	model:SetAttribute("Level", def.Level)
	model:SetAttribute("Boss", def.Boss == true)
	model:SetAttribute("Phase", 1)
	model:SetAttribute("MobDead", false)
	if def.IdleClip then
		model:SetAttribute("IdleClip", def.IdleClip)
	end
	if def.WalkClip then
		model:SetAttribute("WalkClip", def.WalkClip)
	end
	local now = os.clock()
	local mob = {
		Model = model, Root = root, Humanoid = humanoid, Id = mobId, Def = def, Opts = opts,
		Home = home, Dead = false, Hits = {}, Target = nil,
		Aggro = opts.AggroRange or def.AggroRange, Leash = opts.LeashRange or def.LeashRange,
		LastEngaged = now, NextAoE = now + 4, Phase = 1, NextAttack = 0, Attacking = false, NextWander = now + rng:NextNumber(2, 6),
		NextSummon = now + 6, NextMeteor = now + 5, Minions = {},
	}
	buildBar(mob)
	model.Parent = folder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	mobs[mob] = true
	byModel[model] = mob
	return mob
end

local function aliveCharacter(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and root and humanoid.Health > 0 and DataService.Get(player) then
		return character, root
	end
	return nil
end

local function flatDistance(a, b)
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local function findTarget(mob)
	local position = mob.Root.Position
	-- Тот, кто ударил, остаётся целью, пока не вышел за поводок.
	if mob.Target then
		local _, root = aliveCharacter(mob.Target)
		if root and flatDistance(root.Position, mob.Home) <= mob.Leash and math.abs(root.Position.Y - mob.Home.Y) < 40 then
			return mob.Target, root
		end
		mob.Target = nil
	end
	local best, bestRoot, bestDistance = nil, nil, mob.Aggro
	for _, player in ipairs(Players:GetPlayers()) do
		local _, root = aliveCharacter(player)
		if root and math.abs(root.Position.Y - mob.Home.Y) < 40 then
			local distance = flatDistance(root.Position, position)
			if distance <= bestDistance and flatDistance(root.Position, mob.Home) <= mob.Leash then
				best, bestRoot, bestDistance = player, root, distance
			end
		end
	end
	return best, bestRoot
end

local function hurt(player, character, amount)
	if CharacterService.Damage(player, amount) then
		player:SetAttribute("GladeCombatAt", os.clock())
		Remotes.FX:FireAllClients("PlayerHit", character, amount)
	end
end

-- Множители фаз: для двухфазного Владыки пепла дают ровно прежние значения (×1.25 урон и т.д.).
local function phaseScale(mob, perPhase)
	return 1 + perPhase * (mob.Phase - 1)
end

local function pickClip(mob)
	local def = mob.Def
	if def.AttackClips and #def.AttackClips > 0 then
		return def.AttackClips[rng:NextInteger(1, #def.AttackClips)]
	end
	if (def.Model or mob.Id) == "Slime" then
		return "SlimeLunge"
	end
	return rng:NextNumber() < 0.5 and "GuardianSlam" or "GuardianPunch"
end

local function facePosition(mob, targetPosition)
	local position = mob.Root.Position
	mob.Humanoid:MoveTo(position)
	-- Поворот к цели только по горизонтали и без телепорта корня (раньше слизень «подпрыгивал»).
	local look = Vector3.new(targetPosition.X - position.X, 0, targetPosition.Z - position.Z)
	if look.Magnitude > 0.1 then
		mob.Humanoid:MoveTo(position + look.Unit * 0.5)
	end
end

-- Снаряд летит в точку, где цель стояла в момент выстрела: отбежал — промах.
local function fireProjectile(mob, targetRoot)
	local def = mob.Def
	local castPoint = mob.Model:FindFirstChild("CastPoint", true)
	local from = castPoint and castPoint:IsA("BasePart") and castPoint.Position or (mob.Root.Position + Vector3.new(0, 2, 0))
	local to = targetRoot.Position
	local speed = def.ProjectileSpeed or 50
	local radius = def.ProjectileRadius or 4
	local color = def.ProjectileColor or Color3.fromRGB(150, 220, 255)
	Remotes.FX:FireAllClients("Projectile", from, to, color, speed)
	local damage = math.floor(def.Damage * phaseScale(mob, 0.25))
	task.delay((to - from).Magnitude / speed, function()
		if mob.Dead then
			return
		end
		for _, player in ipairs(Players:GetPlayers()) do
			local character, root = aliveCharacter(player)
			if root and flatDistance(root.Position, to) <= radius and math.abs(root.Position.Y - to.Y) < 8 then
				hurt(player, character, damage)
			end
		end
	end)
end

local function attack(mob, player, targetRoot)
	local def = mob.Def
	mob.Attacking = true
	mob.NextAttack = os.clock() + def.AttackCooldown
	facePosition(mob, targetRoot.Position)
	Remotes.FX:FireAllClients("MobAttack", mob.Model, mob.Id, pickClip(mob))
	task.delay(def.AttackWindup, function()
		mob.Attacking = false
		if mob.Dead or not mob.Model.Parent then
			return
		end
		local character, root = aliveCharacter(player)
		if not character or root ~= targetRoot then
			return
		end
		if def.Ranged then
			if flatDistance(root.Position, mob.Root.Position) <= def.AttackRange + 8 then
				fireProjectile(mob, root)
			end
			return
		end
		local amount = math.floor(def.Damage * phaseScale(mob, 0.25))
		if def.SlamRadius then
			-- Тяжёлый удар бьёт всех рядом с точкой перед мобом.
			local center = mob.Root.Position
			for _, other in ipairs(Players:GetPlayers()) do
				local otherCharacter, otherRoot = aliveCharacter(other)
				if otherRoot and flatDistance(otherRoot.Position, center) <= def.SlamRadius and math.abs(otherRoot.Position.Y - center.Y) < 12 then
					hurt(other, otherCharacter, amount)
				end
			end
			Remotes.FX:FireAllClients("BossImpact", Vector3.new(center.X, mob.Home.Y + 0.3, center.Z), def.SlamRadius * 0.6)
			return
		end
		-- Уклонение: если игрок отбежал за время замаха — промах.
		if math.abs(root.Position.Y - mob.Root.Position.Y) < (def.Boss and 18 or 10) and flatDistance(root.Position, mob.Root.Position) - def.Radius <= def.AttackRange + 1.5 then
			hurt(player, character, amount)
		end
	end)
end

-- Телеграф — серверная деталь: поздно подключившиеся клиенты видят ровно ту зону, что нанесёт урон.
local function warningDisk(parent, center, radius, windup, color, text)
	local marker = Instance.new("Part")
	marker.Name = "BossWarning"
	marker.Shape = Enum.PartType.Cylinder
	marker.Anchored, marker.CanCollide, marker.CanTouch, marker.CanQuery = true, false, false, false
	marker.Size = Vector3.new(0.15, radius * 2, radius * 2)
	marker.CFrame = CFrame.new(center) * Models.UPRIGHT
	marker.Color, marker.Material, marker.Transparency = color, Enum.Material.Neon, 0.45
	marker.Parent = parent
	if text then
		local labelGui = Instance.new("BillboardGui")
		labelGui.Size, labelGui.AlwaysOnTop = UDim2.fromOffset(220, 36), true
		labelGui.StudsOffsetWorldSpace = Vector3.new(0, 2, 0)
		labelGui.MaxDistance = 110
		labelGui.Parent = marker
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency, label.Size = 1, UDim2.fromScale(1, 1)
		label.Text, label.TextColor3 = text, Color3.new(1, 1, 1)
		label.TextSize, label.Font, label.TextStrokeTransparency = 16, Enum.Font.GothamBold, 0.2
		label.Parent = labelGui
	end
	TweenService:Create(marker, TweenInfo.new(windup), { Transparency = 0.12 }):Play()
	Debris:AddItem(marker, windup + 0.2)
	return marker
end

local function damageArea(center, radius, amount)
	for _, player in ipairs(Players:GetPlayers()) do
		local character, root = aliveCharacter(player)
		if root and flatDistance(root.Position, center) <= radius and math.abs(root.Position.Y - center.Y) < 16 then
			hurt(player, character, amount)
		end
	end
end

local function bossAoE(mob)
	local def = mob.Def
	local center = Vector3.new(mob.Root.Position.X, mob.Home.Y + 0.38, mob.Root.Position.Z)
	local radius = def.AoERadius * phaseScale(mob, 0.2)
	local windup = def.AoEWindup
	local amount = math.floor(def.AoEDamage * phaseScale(mob, 0.3))
	mob.Attacking = true
	mob.NextAoE = os.clock() + def.AoECooldown * (0.7 ^ (mob.Phase - 1))
	mob.NextAttack = os.clock() + windup + 0.9
	mob.Humanoid:MoveTo(mob.Root.Position)
	local marker = warningDisk(mob.Model, center, radius, windup, Color3.fromRGB(255, 40, 55), "ОТОЙДИ ОТ КРАСНОЙ ЗОНЫ!")
	Remotes.FX:FireAllClients("MobAttack", mob.Model, mob.Id, "BossSlam")
	task.delay(windup, function()
		if marker.Parent then
			marker:Destroy()
		end
		if mob.Dead or not mob.Model.Parent then
			return
		end
		damageArea(center, radius, amount)
		Remotes.FX:FireAllClients("BossImpact", center, radius)
		task.delay(0.55, function()
			if not mob.Dead then
				mob.Attacking = false
			end
		end)
	end)
end

-- Метеоры: красные круги под ногами игроков в бою с боссом, в последней фазе — несколько на каждого.
local function bossMeteors(mob)
	local def = mob.Def
	local spec = def.Meteors
	local lastPhase = #(def.PhaseThresholds or {}) + 1
	local perPlayer = mob.Phase >= lastPhase and (spec.LastPhasePerPlayer or spec.PerPlayer) or spec.PerPlayer
	mob.Attacking = true
	mob.NextMeteor = os.clock() + spec.Cooldown * (mob.Phase >= lastPhase and 0.75 or 1)
	mob.NextAttack = os.clock() + 1.1
	mob.Humanoid:MoveTo(mob.Root.Position)
	Remotes.FX:FireAllClients("MobAttack", mob.Model, mob.Id, "BossCast")
	local floorY = mob.Home.Y + 0.4
	local targets = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local _, root = aliveCharacter(player)
		if root and flatDistance(root.Position, mob.Home) <= mob.Leash and math.abs(root.Position.Y - mob.Home.Y) < 40 then
			for i = 1, perPlayer do
				local offset = i == 1 and Vector3.zero or Vector3.new(rng:NextNumber(-12, 12), 0, rng:NextNumber(-12, 12))
				table.insert(targets, Vector3.new(root.Position.X + offset.X, floorY, root.Position.Z + offset.Z))
			end
		end
	end
	local amount = math.floor(spec.Damage * phaseScale(mob, 0.2))
	for index, center in ipairs(targets) do
		local delay = (index - 1) * 0.12
		task.delay(delay, function()
			if mob.Dead then
				return
			end
			warningDisk(mob.Model, center, spec.Radius, spec.Windup, spec.Color or Color3.fromRGB(255, 60, 60), nil)
			task.delay(spec.Windup, function()
				if mob.Dead or not mob.Model.Parent then
					return
				end
				damageArea(center, spec.Radius, amount)
				Remotes.FX:FireAllClients("BossImpact", center, spec.Radius)
			end)
		end)
	end
	task.delay(1.1, function()
		if not mob.Dead then
			mob.Attacking = false
		end
	end)
end

local function aliveMinions(mob)
	local alive = 0
	for minion in pairs(mob.Minions) do
		if minion.Dead or not minion.Model.Parent then
			mob.Minions[minion] = nil
		else
			alive = alive + 1
		end
	end
	return alive
end

local function bossSummon(mob)
	local def = mob.Def
	local spec = def.Summon
	mob.NextSummon = os.clock() + spec.Cooldown
	local room = spec.Max - aliveMinions(mob)
	if room <= 0 then
		return false
	end
	mob.Attacking = true
	mob.NextAttack = os.clock() + 1.3
	mob.Humanoid:MoveTo(mob.Root.Position)
	Remotes.FX:FireAllClients("MobAttack", mob.Model, mob.Id, "BossSummon")
	local color = (def.Meteors and def.Meteors.Color) or Color3.fromRGB(200, 120, 255)
	for i = 1, math.min(spec.Count, room) do
		local angle = (i / spec.Count) * math.pi * 2 + rng:NextNumber(0, 1)
		local point = Vector3.new(mob.Root.Position.X + math.cos(angle) * (def.Radius + 6), mob.Home.Y, mob.Root.Position.Z + math.sin(angle) * (def.Radius + 6))
		Remotes.FX:FireAllClients("Summon", point, color)
		task.delay(0.8, function()
			if mob.Dead then
				return
			end
			local minion = spawnMob(spec.Mob, {
				Position = point, NoRespawn = true, NoReward = true, AggroRange = 70, LeashRange = mob.Leash,
				Tag = mob.Opts.Tag, Owner = mob,
			})
			if minion then
				mob.Minions[minion] = true
				minion.Home = mob.Home
				if mob.Opts.OnMinion then
					pcall(mob.Opts.OnMinion, minion)
				end
			end
		end)
	end
	task.delay(1.2, function()
		if not mob.Dead then
			mob.Attacking = false
		end
	end)
	return true
end

local function phaseFor(mob)
	local ratio = mob.Humanoid.Health / mob.Humanoid.MaxHealth
	local phase = 1
	for _, threshold in ipairs(mob.Def.PhaseThresholds or { 0.5 }) do
		if ratio <= threshold then
			phase = phase + 1
		end
	end
	return phase
end

local function resetBoss(mob, now)
	local def = mob.Def
	mob.Humanoid.Health = mob.Humanoid.MaxHealth
	mob.Hits = {}
	mob.Phase = 1
	mob.Model:SetAttribute("Phase", 1)
	mob.Humanoid.WalkSpeed = def.WalkSpeed
	mob.NextAoE = now + 4
	mob.NextSummon = now + 6
	mob.NextMeteor = now + 5
	updateBar(mob)
end

local function think(mob, now)
	if mob.Dead or mob.Attacking or not mob.Model.Parent then
		return
	end
	local def = mob.Def
	local position = mob.Root.Position
	if def.Boss then
		local phase = phaseFor(mob)
		if phase ~= mob.Phase then
			mob.Phase = phase
			mob.Model:SetAttribute("Phase", phase)
			mob.Humanoid.WalkSpeed = def.WalkSpeed * phaseScale(mob, 0.3)
			Remotes.FX:FireAllClients("Summon", Vector3.new(position.X, mob.Home.Y, position.Z), Color3.fromRGB(255, 90, 90))
		end
	end
	local player, targetRoot = findTarget(mob)
	if player then
		mob.LastEngaged = now
		local flat = flatDistance(targetRoot.Position, position)
		if def.Boss then
			if def.Summon and mob.Phase >= (def.Summon.FromPhase or 1) and now >= mob.NextSummon and bossSummon(mob) then
				return
			end
			if def.Meteors and mob.Phase >= (def.Meteors.FromPhase or 1) and now >= mob.NextMeteor then
				bossMeteors(mob)
				return
			end
			if def.AoERadius and now >= mob.NextAoE and flat < def.AoERadius + 10 then
				bossAoE(mob)
				return
			end
		end
		local distance = flat - def.Radius
		if distance <= def.AttackRange then
			if now >= mob.NextAttack then
				attack(mob, player, targetRoot)
			else
				mob.Humanoid:MoveTo(position)
			end
		else
			mob.Humanoid:MoveTo(targetRoot.Position)
		end
		return
	end
	mob.Target = nil
	if def.Boss and now - mob.LastEngaged > 10 and mob.Humanoid.Health < mob.Humanoid.MaxHealth then
		resetBoss(mob, now)
	end
	local fromHome = flatDistance(position, mob.Home)
	if fromHome > mob.Leash * 0.5 then
		-- Возврат домой с полным восстановлением ХП (без «выбивания» моба по одному удару).
		mob.Humanoid:MoveTo(mob.Home)
		if mob.Humanoid.Health < mob.Humanoid.MaxHealth then
			mob.Humanoid.Health = mob.Humanoid.MaxHealth
			mob.Hits = {}
			updateBar(mob)
		end
	elseif now >= mob.NextWander then
		mob.NextWander = now + rng:NextNumber(3, 7)
		local zone = def.Zone and Config.Zones[def.Zone]
		local point = mob.Home + Vector3.new(rng:NextNumber(-8, 8), 0, rng:NextNumber(-8, 8))
		if not zone or mob.Opts.Position or flatDistance(point, zone.Center) <= zone.Radius then
			mob.Humanoid:MoveTo(point)
		end
	end
end

local function itemNames(items)
	local names = {}
	for _, itemId in ipairs(items) do
		local def = Config.Items[itemId]
		table.insert(names, def and def.Name or itemId)
	end
	return table.concat(names, ", ")
end
MobService.ItemNames = itemNames

local function reward(mob, killer)
	if mob.Opts.NoReward then
		return
	end
	local share = mob.Humanoid.MaxHealth * Config.RewardShare
	local position = mob.Root.Position
	for player, dealt in pairs(mob.Hits) do
		local profile = player.Parent and DataService.Get(player)
		if profile and (player == killer or dealt >= share) then
			local result = Rules.Reward(profile, mob.Id, rollFn, os.clock())
			Remotes.FX:FireClient(player, "Loot", position, { Coins = result.Coins, XP = result.XP, Items = result.Items })
			if #result.Items > 0 then
				DataService.Toast(player, "Добыча: " .. itemNames(result.Items), "loot")
			end
			if result.Levels > 0 then
				if player.Character then
					Remotes.FX:FireAllClients("LevelUp", player.Character, profile.Level)
				end
				DataService.Toast(player, "Новый уровень " .. profile.Level .. "! +" .. result.Points .. " очков навыков (K — прокачка)", "success")
			end
			if MobService.OnKill then
				local ok, err = pcall(MobService.OnKill, player, profile, mob.Id)
				if not ok then
					warn("[GladeSlayer] OnKill: " .. tostring(err))
				end
			end
			DataService.Changed(player)
		end
	end
end

local function removeModel(mob, delay)
	task.delay(delay, function()
		byModel[mob.Model] = nil
		mob.Model:Destroy()
	end)
end

local function die(mob, killer)
	if mob.Dead then
		return
	end
	mob.Dead = true
	mob.Model:SetAttribute("MobDead", true)
	mobs[mob] = nil
	if mob.Opts.Owner then
		mob.Opts.Owner.Minions[mob] = nil
	end
	Remotes.FX:FireAllClients("MobDied", mob.Model)
	local ok, err = pcall(reward, mob, killer)
	if not ok then
		warn("[GladeSlayer] Награда за моба: " .. tostring(err))
	end
	local bar = mob.Root:FindFirstChild("MobBar")
	if bar then
		bar:Destroy()
	end
	mob.Humanoid.WalkSpeed = 0
	removeModel(mob, 1.2)
	if mob.Opts.OnDeath then
		local okDeath, errDeath = pcall(mob.Opts.OnDeath, mob, killer)
		if not okDeath then
			warn("[GladeSlayer] OnDeath: " .. tostring(errDeath))
		end
	end
	if not mob.Opts.NoRespawn then
		task.delay(mob.Def.RespawnSeconds, function()
			spawnMob(mob.Id)
		end)
	end
end

function MobService.GetFolder()
	return folder
end

function MobService.FromPart(part)
	local current = part
	while current and current.Parent ~= folder do
		current = current.Parent
	end
	if current then
		local mob = byModel[current]
		if mob and not mob.Dead then
			return mob
		end
	end
	return nil
end

function MobService.Damage(mob, player, amount, crit)
	if mob.Dead or not mob.Model.Parent then
		return
	end
	local humanoid = mob.Humanoid
	player:SetAttribute("GladeCombatAt", os.clock())
	if mob.Def.DamageReduction then
		amount = math.max(1, math.floor(amount * (1 - mob.Def.DamageReduction) + 0.5))
	end
	local dealt = math.min(amount, humanoid.Health)
	mob.Hits[player] = (mob.Hits[player] or 0) + dealt
	mob.Target = player
	humanoid.Health = math.max(0, humanoid.Health - amount)
	updateBar(mob)
	local hitPosition = mob.Root.Position + Vector3.new(0, mob.Def.BarHeight * 0.5, 0)
	Remotes.FX:FireAllClients("Damage", mob.Model, hitPosition, amount, crit, player.UserId)
	if humanoid.Health <= 0 then
		die(mob, player)
	end
end

-- Публичный спавн для подземелий: моб появляется в точке Position и не респавнится.
function MobService.Spawn(mobId, opts)
	return spawnMob(mobId, opts)
end

-- Тихое удаление без награды (выход из подземелья, провал по таймеру).
function MobService.Despawn(mob)
	if mob.Dead then
		return
	end
	mob.Dead = true
	mobs[mob] = nil
	mob.Model:SetAttribute("MobDead", true)
	removeModel(mob, 0)
end

function MobService.DespawnTag(tag)
	if tag == nil then
		return
	end
	local list = {}
	for mob in pairs(mobs) do
		if mob.Opts.Tag == tag then
			table.insert(list, mob)
		end
	end
	for _, mob in ipairs(list) do
		MobService.Despawn(mob)
	end
end

function MobService.Init(dataService, characterService, remotes)
	DataService = dataService
	CharacterService = characterService
	Remotes = remotes
	local old = workspace:FindFirstChild("GladeSlayerMobs")
	if old then
		old:Destroy()
	end
	folder = Instance.new("Folder")
	folder.Name = "GladeSlayerMobs"
	folder.Parent = workspace
	Players.PlayerRemoving:Connect(function(player)
		for mob in pairs(mobs) do
			mob.Hits[player] = nil
			if mob.Target == player then
				mob.Target = nil
			end
		end
	end)
end

function MobService.Start()
	for _, mobId in ipairs(Config.MobOrder) do
		for _ = 1, Config.Mobs[mobId].Count do
			spawnMob(mobId)
		end
	end
	task.spawn(function()
		while true do
			task.wait(AI_STEP)
			local now = os.clock()
			local list = {}
			for mob in pairs(mobs) do
				table.insert(list, mob)
			end
			for _, mob in ipairs(list) do
				local ok, err = pcall(think, mob, now)
				if not ok then
					warn("[GladeSlayer] ИИ моба: " .. tostring(err))
				end
				-- Моб провалился под карту — возвращаем домой.
				if not mob.Dead and mob.Root.Position.Y < mob.Home.Y + Config.FallResetY - Config.GroundY then
					mob.Model:PivotTo(CFrame.new(mob.Home + Vector3.new(0, mob.Def.HipHeight + 3, 0)))
				end
			end
		end
	end)
end

return MobService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">NPCService</string><ProtectedString name="Source"><![CDATA[-- GladeSlayer: NPC-торговцы (Скупщик и Кузнец) с табличкой над головой и ProximityPrompt.
-- Prompt только открывает окно на клиенте; все сделки отдельно проверяются EconomyService (дистанция, монеты).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GladeSlayer")
local Config = require(Shared:WaitForChild("Config"))
local Models = require(Shared:WaitForChild("Models"))

local NPCService = {}

local KINDS = { "Merchant", "Blacksmith" }
local ACCENT = {
	Merchant = Color3.fromRGB(255, 204, 84),
	Blacksmith = Color3.fromRGB(255, 132, 72),
}

local function nameplate(root, def, kind, height)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Nameplate"
	gui.Size = UDim2.fromOffset(240, 54)
	gui.StudsOffset = Vector3.new(0, height, 0)
	gui.MaxDistance = 80
	gui.LightInfluence = 0
	local nameLabel = Instance.new("TextLabel")
	nameLabel.BackgroundTransparency = 1
	nameLabel.Size = UDim2.new(1, 0, 0, 28)
	nameLabel.Font = Enum.Font.GothamBlack
	nameLabel.TextSize = 22
	nameLabel.TextColor3 = ACCENT[kind]
	nameLabel.TextStrokeTransparency = 0.3
	nameLabel.Text = def.Name
	nameLabel.Parent = gui
	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(0, 28)
	title.Size = UDim2.new(1, 0, 0, 20)
	title.Font = Enum.Font.GothamMedium
	title.TextSize = 15
	title.TextColor3 = Color3.fromRGB(240, 240, 240)
	title.TextStrokeTransparency = 0.4
	title.Text = def.Title
	title.Parent = gui
	gui.Parent = root
end

function NPCService.Start(remotes)
	local old = workspace:FindFirstChild("GladeSlayerNPCs")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "GladeSlayerNPCs"
	folder.Parent = workspace
	for _, kind in ipairs(KINDS) do
		local def = Config.NPC[kind]
		local model = Models.BuildNPC(kind)
		local root = model.PrimaryPart
		-- Стопы на уровне пола: корень = половина торса + длина ног (обе = Size.Y корня).
		local position = def.Position + Vector3.new(0, root.Size.Y * 1.5, 0)
		model:PivotTo(CFrame.lookAt(position, position + def.Facing))
		nameplate(root, def, kind, root.Size.Y * 1.6)
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "ShopPrompt"
		prompt.ActionText = def.Prompt
		prompt.ObjectText = def.Name
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = Config.PromptDistance
		prompt.RequiresLineOfSight = false
		prompt.Parent = root
		prompt.Triggered:Connect(function(player)
			remotes.OpenShop:FireClient(player, kind)
		end)
		model.Parent = folder
	end
end

return NPCService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">TravelService</string><ProtectedString name="Source"><![CDATA[-- Server-authoritative travel. No client-supplied coordinates, prices, or levels.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("GladeSlayer")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("Rules"))
local DungeonService = require(script.Parent:WaitForChild("DungeonService"))
local TravelService = {}
local cooldowns = {}
local DataService
function TravelService.Teleport(player, profile, islandId)
 local ok, message = Rules.CanTeleport(profile, islandId)
 if not ok then return false, message end
 if DungeonService.InDungeon(player) then
  return false, "Сначала покинь подземелье."
 end
 local character = player.Character
 local humanoid = character and character:FindFirstChildOfClass("Humanoid")
 local root = character and character:FindFirstChild("HumanoidRootPart")
 if not root or not humanoid or humanoid.Health <= 0 or humanoid.Sit then
  return false, "Телепорт сейчас недоступен."
 end
 local now = os.clock()
 if now < (cooldowns[player] or 0) then return false, "Телепорт перезаряжается." end
 local combatAt = player:GetAttribute("GladeCombatAt")
 if combatAt and now - combatAt < Config.TeleportCombatSeconds then
  return false, "Нельзя телепортироваться в бою. Подожди 8 секунд."
 end
 cooldowns[player] = now + Config.TeleportCooldown
 character:PivotTo(CFrame.new(Config.Islands[islandId].Arrival))
 root.AssemblyLinearVelocity = Vector3.zero
 root.AssemblyAngularVelocity = Vector3.zero
 return true, "Локация: " .. message
end
function TravelService.Init(dataService, remotes)
 DataService = dataService
 local world = workspace:FindFirstChild("GladeSlayerWorld")
 if world then
  for _, prompt in ipairs(world:GetDescendants()) do
   if prompt:IsA("ProximityPrompt") and prompt.Name == "IslandTravel" then
    local core = prompt.Parent
    prompt.Triggered:Connect(function(player)
     local profile = DataService.Get(player)
     local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
     -- Prompt events can be forged by exploiters; re-check range on the server.
     if not profile or not root or (root.Position-core.Position).Magnitude > 15 then return end
     local ok, message = TravelService.Teleport(player,profile,core:GetAttribute("DestinationIsland"))
     remotes.Toast:FireClient(player,message,ok and "success" or "error")
    end)
   end
  end
 end
 Players.PlayerRemoving:Connect(function(player) cooldowns[player] = nil end)
end
return TravelService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">TutorialService</string><ProtectedString name="Source"><![CDATA[-- GladeSlayer: гайд новичка на сервере. Прогресс хранится в профиле (Rules.TutorialEvent),
-- события приходят из убийств мобов и успешных действий игрока (Equip, Upgrade, Sell).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GladeSlayer")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("Rules"))

local TutorialService = {}
local DataService, Remotes

local ACTION_EVENTS = { Upgrade = "Upgrade", Equip = "Equip", Sell = "Sell", SellAll = "Sell" }

local function toast(player, text, kind)
	if player.Parent then
		Remotes.Toast:FireClient(player, text, kind)
	end
end

function TutorialService.Event(player, profile, event, data)
	local result = Rules.TutorialEvent(profile, event, data)
	if not result then
		return
	end
	if table.find(result.Granted, "OldSword") then
		toast(player, "Слизень выронил Старый меч! Открой Инвентарь [I] и надень его.", "loot")
	end
	if result.Finished then
		local itemDef = result.Item and Config.Items[result.Item]
		toast(player, "Гайд пройден! Награда: +" .. Rules.FormatNumber(result.Coins or 0) .. " монет" .. (itemDef and (" и " .. itemDef.Name) or "") .. ".", "success")
		if player.Character then
			Remotes.FX:FireAllClients("LevelUp", player.Character, profile.Level)
		end
	elseif result.Advanced then
		local step, index = Rules.TutorialStep(profile)
		if step then
			toast(player, "Цель " .. index .. "/" .. #Config.Tutorial.Steps .. ": " .. step.Text, "info")
		end
	end
	DataService.Changed(player)
end

function TutorialService.OnAction(player, profile, action, a)
	local event = ACTION_EVENTS[action]
	if event then
		TutorialService.Event(player, profile, event, a)
	end
end

function TutorialService.Init(dataService, remotes, mobService, economyService)
	DataService = dataService
	Remotes = remotes
	mobService.OnKill = function(player, profile, mobId)
		TutorialService.Event(player, profile, "Kill", mobId)
	end
	economyService.OnAction = TutorialService.OnAction
end

return TutorialService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">WorldBuilder</string><ProtectedString name="Source"><![CDATA[-- GladeSlayer: процедурная стартовая локация «Поляна» — луг, тропы, лес, руины Стражей, лавки торговцев,
-- фонари, пруд и освещение (Lighting + Atmosphere + пост-эффекты). Всё из Part/материалов, без ассетов.
-- Соглашение: верхняя поверхность земли = Config.GroundY; позиции из Config с Y = GroundY стоят на полу.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GladeSlayer")
local Config = require(Shared:WaitForChild("Config"))
local Models = require(Shared:WaitForChild("Models"))

local WorldBuilder = {}

local V3 = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local RAD = math.rad
local M = Enum.Material
local rgb = Color3.fromRGB
local G = Config.GroundY

local world = nil
local rng = Random.new(1337)

local function part(parent, name, size, cframe, color, material, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		p.Shape = shape
	end
	p.Parent = parent
	return p
end

local function wedge(parent, name, size, cframe, color, material)
	local p = Instance.new("WedgePart")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.Parent = parent
	return p
end

local function cylinder(parent, name, height, diameter, position, color, material)
	return part(parent, name, V3(height, diameter, diameter), CF(position) * Models.UPRIGHT, color, material, Enum.PartType.Cylinder)
end

local function ball(parent, name, diameter, position, color, material)
	return part(parent, name, V3(diameter, diameter, diameter), CF(position), color, material, Enum.PartType.Ball)
end

local function folder(name)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = world
	return f
end

local function decor(p)
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end

local function sign(parent, text, cframe, color)
	-- Таблички — чистый декор: без коллизии, чтобы никогда не перегораживать тропы.
	local board = decor(part(parent, "Sign", V3(9, 3, 0.4), cframe, rgb(120, 84, 50), M.WoodPlanks))
	for _, side in ipairs({ -1, 1 }) do
		decor(part(parent, "SignPost", V3(0.5, 5.5, 0.5), cframe * CF(side * 3.6, -2.2, 0.3), rgb(96, 66, 40), M.Wood))
	end
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.LightInfluence = 0.6
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.TextColor3 = color or rgb(255, 236, 190)
		label.TextStrokeTransparency = 0.2
		label.Text = text
		label.Parent = gui
		gui.Parent = board
	end
	return board
end

-- Запретные для декора области: зоны мобов, спавн, лавки и тропы.
local function blocked(x, z, margin)
	local point = V3(x, G, z)
	for _, zone in pairs(Config.Zones) do
		if (V3(zone.Center.X, G, zone.Center.Z) - point).Magnitude < zone.Radius + margin then
			return true
		end
	end
	if (V3(Config.SpawnPosition.X, G, Config.SpawnPosition.Z) - point).Magnitude < 20 + margin then
		return true
	end
	for _, npc in pairs(Config.NPC) do
		if (V3(npc.Position.X, G, npc.Position.Z) - point).Magnitude < 16 + margin then
			return true
		end
	end
	if math.abs(x) < 8 + margin then
		return true
	end
	if math.abs(z - 74) < 6 + margin and math.abs(x) < 50 then
		return true
	end
	return false
end

-- Земля, границы, тропы ---------------------------------------------------------------------
local function buildGround()
	local f = folder("Ground")
	local size = Config.MapHalfSize * 2
	part(f, "Meadow", V3(size, 4, size), CF(0, G - 2, 0), rgb(98, 160, 72), M.Grass)
	-- Холмистая кромка вокруг поляны. Холмы не должны залезать в порталы и вход в подземелья.
	local keepClear = { V3(-94, G, 106), V3(94, G, 106), V3(40, G, 134) }
	for i = 0, 23 do
		local angle = i / 24 * math.pi * 2
		local radius = Config.MapHalfSize - 6
		local height = rng:NextNumber(10, 22)
		local diameter = rng:NextNumber(30, 46)
		for _, point in ipairs(keepClear) do
			local center = V3(math.cos(angle) * radius, G, math.sin(angle) * radius)
			if (center - point).Magnitude < diameter / 2 + 12 then
				radius = Config.MapHalfSize + 8
				diameter = 24
			end
		end
		ball(f, "Hill", diameter, V3(math.cos(angle) * radius, G - 30 + height, math.sin(angle) * radius), rgb(84, 140, 62), M.Grass)
	end
	for _, data in ipairs({ { V3(0, 30, Config.MapHalfSize), V3(size, 60, 2) }, { V3(0, 30, -Config.MapHalfSize), V3(size, 60, 2) }, { V3(Config.MapHalfSize, 30, 0), V3(2, 60, size) }, { V3(-Config.MapHalfSize, 30, 0), V3(2, 60, size) } }) do
		local wall = part(f, "Boundary", data[2], CF(data[1]), rgb(255, 255, 255), M.SmoothPlastic)
		wall.Transparency = 1
	end
	local path = rgb(150, 118, 80)
	local function strip(name, from, to, width)
		local mid = (from + to) / 2
		local length = (to - from).Magnitude
		local p = part(f, name, V3(width, 0.2, length), CF(V3(mid.X, G + 0.05, mid.Z), V3(to.X, G + 0.05, to.Z)), path, M.Ground)
		decor(p)
		p.CanCollide = false
	end
	strip("PathMain", V3(0, 0, Config.SpawnPosition.Z), V3(0, 0, Config.Zones.Ruins.Center.Z + 26), 9)
	strip("PathShops", V3(-40, 0, 74), V3(40, 0, 74), 7)
	-- Площадь спавна.
	local plaza = cylinder(f, "SpawnPlaza", 0.4, 30, V3(Config.SpawnPosition.X, G + 0.1, Config.SpawnPosition.Z), rgb(150, 146, 136), M.Cobblestone)
	plaza.CanCollide = true
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "GladeSpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = V3(8, 0.4, 8)
	spawn.CFrame = CF(Config.SpawnPosition.X, G + 0.3, Config.SpawnPosition.Z)
	spawn.Color = rgb(120, 200, 255)
	spawn.Material = M.Neon
	spawn.Transparency = 0.35
	spawn.Parent = f
	-- Фонтан-обелиск у спавна.
	cylinder(f, "Obelisk", 6, 1.6, V3(0, G + 3.2, Config.SpawnPosition.Z - 10), rgb(170, 166, 156), M.Marble)
	decor(ball(f, "ObeliskGem", 1.4, V3(0, G + 7, Config.SpawnPosition.Z - 10), rgb(120, 220, 255), M.Neon))
	-- Табличка на обочине справа от центральной тропы (тропа шириной 9 по оси X = 0), развёрнута к дорожке.
	sign(f, Config.GameName, CF(11, G + 5, Config.SpawnPosition.Z - 17) * ANG(0, RAD(160), 0), rgb(255, 230, 150))
end

-- Лес и мелкий декор ---------------------------------------------------------------------------
local function tree(f, x, z, scale)
	local trunkHeight = 7 * scale
	cylinder(f, "Trunk", trunkHeight, 1.6 * scale, V3(x, G + trunkHeight / 2, z), rgb(104, 72, 46), M.Wood)
	local leaf = rgb(rng:NextInteger(52, 78), rng:NextInteger(120, 160), rng:NextInteger(48, 66))
	local top = G + trunkHeight
	decor(ball(f, "Leaves", 7 * scale, V3(x, top + 1.5 * scale, z), leaf, M.Grass))
	decor(ball(f, "Leaves", 5 * scale, V3(x + 2 * scale, top, z + 1 * scale), Models.Shade(leaf, 1.1), M.Grass))
	decor(ball(f, "Leaves", 5 * scale, V3(x - 1.8 * scale, top + 0.5 * scale, z - 1.2 * scale), Models.Shade(leaf, 0.9), M.Grass))
	decor(ball(f, "Leaves", 4 * scale, V3(x, top + 4.2 * scale, z), Models.Shade(leaf, 1.15), M.Grass))
end

local function pine(f, x, z, scale)
	cylinder(f, "Trunk", 4 * scale, 1.2 * scale, V3(x, G + 2 * scale, z), rgb(94, 64, 40), M.Wood)
	local color = rgb(46, 104, 64)
	for i = 0, 2 do
		local width = (7 - i * 2) * scale
		local y = G + (3.5 + i * 3) * scale
		for _, yaw in ipairs({ 0, 90, 180, 270 }) do
			decor(wedge(f, "Needles", V3(width, 3.4 * scale, width / 2), CF(x, y, z) * ANG(0, RAD(yaw), 0) * CF(0, 0, -width / 4) * ANG(0, RAD(180), 0), Models.Shade(color, 1 - i * 0.06), M.Grass))
		end
	end
end

local function buildForest()
	local f = folder("Forest")
	local placed = 0
	local attempts = 0
	while placed < 85 and attempts < 2000 do
		attempts = attempts + 1
		local x = rng:NextNumber(-Config.MapHalfSize + 14, Config.MapHalfSize - 14)
		local z = rng:NextNumber(-Config.MapHalfSize + 14, Config.MapHalfSize - 14)
		if not blocked(x, z, 6) then
			local scale = rng:NextNumber(0.85, 1.35)
			if rng:NextNumber() < 0.35 then
				pine(f, x, z, scale)
			else
				tree(f, x, z, scale)
			end
			placed = placed + 1
		end
	end
	local d = folder("Details")
	local flowerColors = { rgb(255, 120, 150), rgb(255, 220, 90), rgb(180, 140, 255), rgb(255, 255, 255) }
	for _ = 1, 220 do
		local x = rng:NextNumber(-150, 150)
		local z = rng:NextNumber(-150, 150)
		if not blocked(x, z, 0) or rng:NextNumber() < 0.15 then
			local roll = rng:NextNumber()
			if roll < 0.55 then
				local stem = decor(part(d, "Stem", V3(0.15, 0.8, 0.15), CF(x, G + 0.4, z), rgb(70, 140, 60), M.Grass))
				stem.CastShadow = false
				decor(ball(d, "Flower", 0.5, V3(x, G + 0.9, z), flowerColors[rng:NextInteger(1, #flowerColors)], M.SmoothPlastic)).CastShadow = false
			elseif roll < 0.8 then
				decor(ball(d, "Bush", rng:NextNumber(2, 3.4), V3(x, G + 0.6, z), rgb(70, 132, 58), M.Grass))
			else
				local size = rng:NextNumber(1.5, 3.2)
				part(d, "Rock", V3(size, size * 0.6, size * 0.8), CF(x, G + size * 0.2, z) * ANG(0, rng:NextNumber(0, 6.28), rng:NextNumber(-0.2, 0.2)), rgb(128, 128, 122), M.Slate)
			end
		end
	end
	-- Пруд.
	local pond = folder("Pond")
	cylinder(pond, "Shore", 0.3, 30, V3(78, G + 0.02, -20), rgb(160, 140, 100), M.Sand)
	local water = cylinder(pond, "Water", 0.3, 26, V3(78, G + 0.08, -20), rgb(70, 150, 200), M.Glass)
	water.Transparency = 0.25
	water.CanCollide = false
	for i = 1, 6 do
		local angle = i / 6 * math.pi * 2
		decor(cylinder(pond, "LilyPad", 0.1, 2, V3(78 + math.cos(angle) * 7, G + 0.25, -20 + math.sin(angle) * 7), rgb(70, 160, 70), M.Grass))
	end
end

-- Зоны мобов ---------------------------------------------------------------------------------
local function buildMeadow()
	local f = folder("SlimeMeadow")
	local zone = Config.Zones.Meadow
	local ring = cylinder(f, "MeadowGrass", 0.15, zone.Radius * 2 + 4, V3(zone.Center.X, G + 0.02, zone.Center.Z), rgb(120, 182, 82), M.Grass)
	decor(ring)
	for i = 0, 17 do
		local angle = i / 18 * math.pi * 2
		local x = zone.Center.X + math.cos(angle) * (zone.Radius + 3)
		local z = zone.Center.Z + math.sin(angle) * (zone.Radius + 3)
		if math.abs(x) > 6 then
			part(f, "FencePost", V3(0.6, 3, 0.6), CF(x, G + 1.5, z), rgb(120, 86, 52), M.Wood)
			local nextAngle = (i + 1) / 18 * math.pi * 2
			local nx = zone.Center.X + math.cos(nextAngle) * (zone.Radius + 3)
			local nz = zone.Center.Z + math.sin(nextAngle) * (zone.Radius + 3)
			if math.abs(nx) > 6 then
				local a, b = V3(x, G + 2.2, z), V3(nx, G + 2.2, nz)
				decor(part(f, "FenceRail", V3(0.3, 0.3, (b - a).Magnitude), CF((a + b) / 2, b), rgb(140, 100, 60), M.Wood))
			end
		end
	end
	sign(f, zone.Name .. "  •  ур. 1", CF(7, G + 4.5, zone.Center.Z + zone.Radius + 6) * ANG(0, RAD(180), 0) * ANG(0, RAD(180), 0))
	for _ = 1, 10 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(6, zone.Radius - 4)
		decor(ball(f, "SlimePuddle", rng:NextNumber(1.5, 3), V3(zone.Center.X + math.cos(angle) * r, G - 0.3, zone.Center.Z + math.sin(angle) * r), rgb(110, 220, 90), M.Glass)).Transparency = 0.3
	end
end

local function buildRuins()
	local f = folder("GuardianRuins")
	local zone = Config.Zones.Ruins
	local c = zone.Center
	local stone = rgb(140, 138, 132)
	local floor = cylinder(f, "RuinsFloor", 0.4, zone.Radius * 2 + 8, V3(c.X, G + 0.05, c.Z), rgb(120, 118, 112), M.Cobblestone)
	floor.CanCollide = true
	-- Кольцо колонн: часть целые, часть сломаны, одна лежит.
	for i = 0, 9 do
		local angle = i / 10 * math.pi * 2 + 0.15
		local x = c.X + math.cos(angle) * (zone.Radius + 2)
		local z = c.Z + math.sin(angle) * (zone.Radius + 2)
		local entrance = z > c.Z and math.abs(x - c.X) < 8
		if not entrance then
			local height = (i % 3 == 0) and rng:NextNumber(3, 6) or rng:NextNumber(10, 16)
			part(f, "PillarBase", V3(3.4, 1, 3.4), CF(x, G + 0.5, z), Models.Shade(stone, 0.85), M.Slate)
			cylinder(f, "Pillar", height, 2.4, V3(x, G + 1 + height / 2, z), stone, M.Slate)
			if height > 9 then
				part(f, "Capital", V3(3.2, 0.8, 3.2), CF(x, G + 1.4 + height, z), Models.Shade(stone, 0.9), M.Slate)
				decor(part(f, "Moss", V3(3.3, 0.3, 3.3), CF(x, G + 1.9 + height, z), rgb(86, 140, 60), M.Grass))
			else
				part(f, "Rubble", V3(2, 1.2, 1.6), CF(x + 2, G + 0.6, z + 1) * ANG(0.3, 0.5, 0.2), stone, M.Slate)
			end
		end
	end
	part(f, "FallenPillar", V3(12, 2.4, 2.4), CF(c.X + 12, G + 1.2, c.Z - 8) * ANG(0, RAD(30), 0), stone, M.Slate).Shape = Enum.PartType.Cylinder
	-- Арка входа.
	local gateZ = c.Z + zone.Radius + 4
	for _, side in ipairs({ -1, 1 }) do
		part(f, "GatePillar", V3(3, 14, 3), CF(c.X + side * 7, G + 7, gateZ), stone, M.Slate)
	end
	part(f, "GateLintel", V3(18, 2.5, 3.4), CF(c.X, G + 15, gateZ), Models.Shade(stone, 0.9), M.Slate)
	decor(part(f, "GateRune", V3(3, 1.2, 0.2), CF(c.X, G + 15, gateZ + 1.75), rgb(90, 220, 255), M.Neon))
	-- Алтарь с руной.
	part(f, "AltarBase", V3(8, 1, 8), CF(c.X, G + 0.5, c.Z), Models.Shade(stone, 0.8), M.Slate)
	part(f, "Altar", V3(4, 2.4, 4), CF(c.X, G + 2.2, c.Z), stone, M.Marble)
	local rune = decor(ball(f, "RuneOrb", 2, V3(c.X, G + 5, c.Z), rgb(90, 220, 255), M.Neon))
	local light = Instance.new("PointLight")
	light.Color = rgb(90, 220, 255)
	light.Range = 22
	light.Brightness = 2
	light.Parent = rune
	sign(f, zone.Name .. "  •  ур. 8", CF(c.X + 12, G + 4.5, gateZ + 6) * ANG(0, RAD(180), 0) * ANG(0, RAD(180), 0), rgb(150, 230, 255))
end

-- Лавки торговцев -------------------------------------------------------------------------------
local function stall(f, npc, canopyA, canopyB, title)
	local pos = npc.Position
	local facing = npc.Facing
	local base = CF(V3(pos.X, G, pos.Z), V3(pos.X, G, pos.Z) + facing)
	-- Платформа и столбы.
	part(f, "Deck", V3(14, 0.6, 12), base * CF(0, 0.3, 2), rgb(130, 92, 58), M.WoodPlanks)
	for _, offset in ipairs({ V3(-6.5, 0, -3.5), V3(6.5, 0, -3.5), V3(-6.5, 0, 7.5), V3(6.5, 0, 7.5) }) do
		part(f, "Post", V3(0.8, 9, 0.8), base * CF(offset + V3(0, 4.5, 0)), rgb(110, 76, 46), M.Wood)
	end
	-- Полосатый навес из клиньев.
	for i = 0, 6 do
		local color = (i % 2 == 0) and canopyA or canopyB
		wedge(f, "Canopy", V3(2, 2.2, 6.5), base * CF(-6 + i * 2, 10.1, -0.8) * ANG(0, RAD(180), 0), color, M.Fabric)
		part(f, "CanopyBack", V3(2, 0.3, 6), base * CF(-6 + i * 2, 9.1, 4.8), color, M.Fabric)
	end
	-- Прилавок перед NPC.
	part(f, "Counter", V3(10, 3, 1.6), base * CF(0, 1.5 + 0.6, -3), rgb(150, 106, 66), M.WoodPlanks)
	part(f, "CounterTop", V3(10.6, 0.3, 2.2), base * CF(0, 3.75, -3), rgb(110, 76, 46), M.Wood)
	sign(f, title, base * CF(0, 12.6, -3.2) * ANG(0, RAD(180), 0), canopyA)
	return base
end

local function crate(f, cframe, size)
	part(f, "Crate", V3(size, size, size), cframe, rgb(160, 120, 70), M.WoodPlanks)
	decor(part(f, "CrateBand", V3(size + 0.1, 0.25, size + 0.1), cframe * CF(0, size * 0.3, 0), rgb(90, 64, 40), M.Wood))
end

local function buildShops()
	local f = folder("Shops")
	-- Скупщик.
	local merchant = Config.NPC.Merchant
	local mBase = stall(f, merchant, rgb(230, 190, 70), rgb(250, 245, 230), "СКУПЩИК")
	crate(f, mBase * CF(-4.5, 1.6, 4), 2)
	crate(f, mBase * CF(-4.2, 3.6, 4.2) * ANG(0, 0.4, 0), 1.6)
	cylinder(f, "Barrel", 2.8, 2.2, (mBase * CF(4.5, 2, 4)).Position, rgb(120, 80, 44), M.Wood)
	for i = 1, 3 do
		decor(ball(f, "Sack", 1.6, (mBase * CF(-2 + i * 1.3, 4.6, -3)).Position, rgb(200, 170, 110), M.Fabric))
	end
	local coins = decor(cylinder(f, "CoinPile", 0.5, 1.4, (mBase * CF(3, 4.15, -3)).Position, rgb(255, 210, 80), M.Metal))
	coins.Reflectance = 0.2
	-- Кузнец: горн с огнём, наковальня и стойка с оружием.
	local smith = Config.NPC.Blacksmith
	local sBase = stall(f, smith, rgb(180, 60, 50), rgb(60, 50, 50), "КУЗНИЦА")
	part(f, "Forge", V3(4, 4, 4), sBase * CF(-4, 2.6, 4.5), rgb(110, 100, 96), M.Brick)
	part(f, "Chimney", V3(2, 8, 2), sBase * CF(-4, 8.6, 5.5), rgb(100, 90, 86), M.Brick)
	local coal = decor(part(f, "Coals", V3(2.8, 0.4, 2.8), sBase * CF(-4, 4.8, 4.5), rgb(255, 120, 40), M.Neon))
	local fire = Instance.new("Fire")
	fire.Size = 4
	fire.Heat = 6
	fire.Color = rgb(255, 140, 50)
	fire.SecondaryColor = rgb(255, 60, 30)
	fire.Parent = coal
	local glow = Instance.new("PointLight")
	glow.Color = rgb(255, 140, 60)
	glow.Range = 16
	glow.Brightness = 2.5
	glow.Parent = coal
	part(f, "AnvilBase", V3(1.4, 1.8, 1.4), sBase * CF(3.5, 1.5, 3), rgb(70, 66, 64), M.Slate)
	part(f, "Anvil", V3(1.6, 0.8, 3.2), sBase * CF(3.5, 2.8, 3), rgb(60, 62, 70), M.Metal)
	wedge(f, "AnvilHorn", V3(1.2, 0.8, 1.4), sBase * CF(3.5, 2.8, 1.0) * ANG(0, RAD(180), 0), rgb(60, 62, 70), M.Metal)
	-- Витрина: настоящие модели мечей из Models на прилавке и стойке.
	local display = { "IronSword", "KnightBlade" }
	for i, itemId in ipairs(display) do
		local model = Models.BuildItem(itemId)
		if model then
			Models.Anchor(model)
			model:PivotTo(sBase * CF(-2.5 + i * 2.5, 4.05, -3) * ANG(RAD(90), 0, RAD(90)) * ANG(0, RAD(90), 0))
			model.Parent = f
		end
	end
	local rack = part(f, "WeaponRack", V3(6, 0.4, 0.6), sBase * CF(1, 6.5, 7.2), rgb(110, 76, 46), M.Wood)
	rack.Name = "WeaponRack"
	for i, itemId in ipairs({ "OldSword", "IronSword", "KnightBlade" }) do
		local model = Models.BuildItem(itemId)
		if model then
			Models.Anchor(model)
			model:PivotTo(sBase * CF(-1 + i * 1.6, 6.8, 7) * ANG(RAD(-90), 0, 0))
			model.Parent = f
		end
	end
	for i, itemId in ipairs({ "CoinPotion", "RagePotion", "WisdomPotion" }) do
		local model = Models.BuildItem(itemId)
		if model then
			Models.Anchor(model)
			model:PivotTo(sBase * CF(-4.5 + i * 1.1, 4.45, -2.6))
			model.Parent = f
		end
	end
end

local function buildLanterns()
	local f = folder("Lanterns")
	local spots = {}
	for z = Config.SpawnPosition.Z - 22, Config.Zones.Ruins.Center.Z + 30, -26 do
		table.insert(spots, V3(-6.5, G, z))
		table.insert(spots, V3(6.5, G, z + 13))
	end
	table.insert(spots, V3(-24, G, 78.5))
	table.insert(spots, V3(24, G, 78.5))
	for _, spot in ipairs(spots) do
		cylinder(f, "LanternPost", 7, 0.5, spot + V3(0, 3.5, 0), rgb(50, 46, 44), M.Metal)
		part(f, "LanternCap", V3(1.4, 0.3, 1.4), CF(spot + V3(0, 7.9, 0)), rgb(50, 46, 44), M.Metal)
		local lamp = decor(part(f, "Lamp", V3(1, 1.2, 1), CF(spot + V3(0, 7.2, 0)), rgb(255, 214, 140), M.Neon))
		local light = Instance.new("PointLight")
		light.Color = rgb(255, 200, 130)
		light.Range = 14
		light.Brightness = 1.4
		light.Shadows = false
		light.Parent = lamp
	end
end

-- Остров: океан (Terrain-вода), песчаный пляж, скалистые обрывы, водопад, островки, облака и цветочные поляны.
local function buildIsland()
	local f = folder("Island")
	local half = Config.MapHalfSize
	local waterY = G - 12
	-- Океан из воды Terrain — настоящие волны и отражения без ассетов.
	local terrain = workspace.Terrain
	pcall(function()
		terrain.WaterColor = rgb(40, 150, 170)
		terrain.WaterTransparency = 0.55
		terrain.WaterWaveSize = 0.25
		terrain.WaterWaveSpeed = 8
		terrain.WaterReflectance = 0.6
		terrain:FillBlock(CF(720, waterY - 10, 0), V3(2400, 20, 1600), M.Water)
		terrain:FillBlock(CF(720, waterY - 26, 0), V3(2400, 12, 1600), M.Sand)
	end)
	-- Пляж: песчаная кромка чуть ниже луга и уходящая под воду отмель.
	part(f, "Beach", V3(half * 2 + 24, 2, half * 2 + 24), CF(0, G - 1.6, 0), rgb(226, 206, 150), M.Sand)
	part(f, "Shallows", V3(half * 2 + 60, 2, half * 2 + 60), CF(0, waterY + 0.2, 0), rgb(214, 196, 140), M.Sand)
	-- Скалы-обрывы между пляжем и водой.
	local cliff = rgb(122, 116, 104)
	for i = 0, 63 do
		local angle = i / 64 * math.pi * 2
		local r = half + 16 + rng:NextNumber(-3, 4)
		local edge = math.max(math.abs(math.cos(angle)), math.abs(math.sin(angle)))
		local x, z = math.cos(angle) / edge * r, math.sin(angle) / edge * r
		local size = rng:NextNumber(9, 16)
		local rock = part(f, "Cliff", V3(size, rng:NextNumber(8, 13), size * 0.8), CF(x, waterY + 4, z) * ANG(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6.28), rng:NextNumber(-0.3, 0.3)), Models.Shade(cliff, rng:NextNumber(0.85, 1.1)), M.Rock)
		rock.CanCollide = false
		if i % 3 == 0 then
			decor(part(f, "CliffMoss", V3(size * 0.8, 0.6, size * 0.6), rock.CFrame * CF(0, rock.Size.Y / 2, 0), rgb(96, 150, 70), M.Grass))
		end
		-- Пальмы на пляже через одну.
		if i % 5 == 0 then
			local px, pz = math.cos(angle) / edge * (half + 6), math.sin(angle) / edge * (half + 6)
			local lean = ANG(rng:NextNumber(-0.25, 0.25), 0, rng:NextNumber(-0.25, 0.25))
			local trunk = part(f, "PalmTrunk", V3(1, 12, 1), CF(px, G + 5, pz) * lean, rgb(150, 112, 70), M.Wood)
			local top = trunk.CFrame * CF(0, 6, 0)
			for k = 0, 5 do
				decor(wedge(f, "PalmLeaf", V3(0.3, 1.2, 6), top * ANG(0, k / 6 * math.pi * 2, 0) * CF(0, 0, -3) * ANG(RAD(-18), 0, 0), rgb(60, 150, 70), M.Grass))
			end
			decor(ball(f, "Coconut", 0.9, (top * CF(0.5, -0.6, 0.3)).Position, rgb(110, 76, 44), M.Wood))
		end
	end
	-- Водопад с утёса на северо-востоке в океан.
	local fallX, fallZ = half - 30, -half + 30
	part(f, "FallCliff", V3(26, 24, 18), CF(fallX, G + 8, fallZ) * ANG(0, RAD(45), 0), cliff, M.Rock)
	-- Ручей идёт по диагонали к краю острова (+X, -Z), там срывается вниз водопадом.
	local flow = ANG(0, RAD(-45), 0)
	local stream = decor(part(f, "Stream", V3(5, 0.4, 62), CF(fallX + 22, G + 20.3, fallZ - 22) * flow, rgb(110, 200, 230), M.Glass))
	stream.Transparency = 0.3
	part(f, "FallLedge", V3(12, G + 20 - waterY, 12), CF(fallX + 40, (G + 20 + waterY) / 2, fallZ - 40) * flow, cliff, M.Rock)
	local fall = decor(part(f, "Waterfall", V3(5, G + 20 - waterY, 1), CF(fallX + 44.5, (G + 20 + waterY) / 2, fallZ - 44.5) * flow, rgb(200, 240, 255), M.Glass))
	fall.Transparency = 0.25
	local mist = Instance.new("ParticleEmitter")
	mist.Color = ColorSequence.new(rgb(240, 250, 255))
	mist.Size = NumberSequence.new(2, 6)
	mist.Transparency = NumberSequence.new(0.5, 1)
	mist.Lifetime = NumberRange.new(1, 2)
	mist.Rate = 18
	mist.Speed = NumberRange.new(2, 4)
	mist.SpreadAngle = Vector2.new(60, 60)
	mist.Parent = fall
	-- Маленькие островки в океане.
	for i = 1, 6 do
		local angle = i / 6 * math.pi * 2 + 0.4
		local r = half + rng:NextNumber(70, 140)
		local pos = V3(math.cos(angle) * r, waterY, math.sin(angle) * r)
		local d = rng:NextNumber(18, 34)
		local islet = part(f, "Islet", V3(d * 0.35, d, d), CF(pos) * Models.UPRIGHT, rgb(222, 200, 146), M.Sand, Enum.PartType.Cylinder)
		islet.CanCollide = false
		local topY = waterY + d * 0.175
		decor(ball(f, "IsletRock", d * 0.4, V3(pos.X + d * 0.2, topY, pos.Z), cliff, M.Rock))
		decor(part(f, "IsletTrunk", V3(1, 8, 1), CF(pos.X - d * 0.1, topY + 4, pos.Z) * ANG(0, 0, 0.2), rgb(150, 112, 70), M.Wood))
		decor(ball(f, "IsletLeaves", 6, V3(pos.X - d * 0.1 - 0.8, topY + 8.5, pos.Z), rgb(70, 160, 72), M.Grass))
	end
	-- Цветочные поляны и высокая трава на открытых местах.
	local colors = { rgb(255, 130, 170), rgb(255, 230, 110), rgb(170, 140, 255), rgb(255, 255, 255), rgb(255, 160, 80) }
	for _ = 1, 26 do
		local cx, cz = rng:NextNumber(-half + 20, half - 20), rng:NextNumber(-half + 20, half - 20)
		if not blocked(cx, cz, 2) then
			local color = colors[rng:NextInteger(1, #colors)]
			for _ = 1, 9 do
				local x, z = cx + rng:NextNumber(-4, 4), cz + rng:NextNumber(-4, 4)
				decor(wedge(f, "Grass", V3(0.2, rng:NextNumber(1, 1.8), 0.6), CF(x, G + 0.6, z) * ANG(0, rng:NextNumber(0, 6.28), 0), rgb(90, 170, 70), M.Grass)).CastShadow = false
				decor(ball(f, "Bloom", 0.45, V3(x + 0.3, G + 1, z), color, M.SmoothPlastic)).CastShadow = false
			end
		end
	end
	-- Процедурные облака Terrain (без текстур).
	local clouds = terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
	clouds.Cover = 0.55
	clouds.Density = 0.6
	clouds.Color = rgb(255, 252, 245)
	clouds.Parent = terrain
end

function WorldBuilder.ApplyLighting()
	Lighting.ClockTime = 16.1
	Lighting.GeographicLatitude = 35
	Lighting.Brightness = 2.6
	Lighting.Ambient = rgb(70, 74, 86)
	Lighting.OutdoorAmbient = rgb(128, 132, 140)
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.25
	pcall(function()
		Lighting.Technology = Enum.Technology.Future
	end)
	for _, name in ipairs({ "GladeAtmosphere", "GladeBloom", "GladeColor", "GladeSunRays", "GladeSky" }) do
		local old = Lighting:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Name = "GladeAtmosphere"
	atmosphere.Density = 0.26
	atmosphere.Offset = 0.2
	atmosphere.Color = rgb(199, 214, 230)
	atmosphere.Decay = rgb(106, 128, 150)
	atmosphere.Glare = 0.35
	atmosphere.Haze = 1.4
	atmosphere.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Name = "GladeBloom"
	bloom.Intensity = 0.38
	bloom.Size = 28
	bloom.Threshold = 1.35
	bloom.Parent = Lighting
	local color = Instance.new("ColorCorrectionEffect")
	color.Name = "GladeColor"
	color.Saturation = 0.14
	color.Contrast = 0.08
	color.Brightness = 0.02
	color.TintColor = rgb(255, 250, 240)
	color.Parent = Lighting
	local rays = Instance.new("SunRaysEffect")
	rays.Name = "GladeSunRays"
	rays.Intensity = 0.06
	rays.Spread = 0.6
	rays.Parent = Lighting
end

function WorldBuilder.Build()
	-- Убираем стандартные Baseplate/SpawnLocation шаблона, чтобы игрок появлялся на нашей площади.
	for _, name in ipairs({ "Baseplate", "SpawnLocation", "GladeSlayerWorld" }) do
		local old = workspace:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	world = Instance.new("Folder")
	world.Name = "GladeSlayerWorld"
	buildGround()
	buildForest()
	buildMeadow()
	buildRuins()
	buildShops()
	buildLanterns()
	buildIsland()
	require(script.Parent:WaitForChild("ExpansionWorld")).Build(world)
	world.Parent = workspace
	WorldBuilder.ApplyLighting()
	return world
end

return WorldBuilder
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000021"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX0000001E"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX0000001D"><Properties><string name="Name">GladeSlayerClient</string></Properties><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[-- GladeSlayer: клиентские эффекты — анимации ударов (через Animator/Motor6D), след меча, всплывающий урон
-- (BillboardGui), вспышка Highlight при попадании, лут, повышение уровня, смерть мобов и «жизнь» NPC.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("GladeSlayer")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("Rules"))
local Models = require(Shared:WaitForChild("Models"))
local Animator = require(Shared:WaitForChild("Animator"))

local Effects = {}

local player = Players.LocalPlayer
local rgb = Color3.fromRGB
local handlers = {}
local lastLocalSwing = 0
local popupStack = 0

local function tween(object, time, props, style, direction)
	local t = TweenService:Create(object, TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function isLocal(character)
	return character ~= nil and character == player.Character
end

-- Всплывающий текст в 3D (урон, награды, уровень).
local function popup(position, text, color, size, rise, duration)
	local anchor = Instance.new("Part")
	anchor.Name = "GladePopup"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	-- Без случайного разброса: цифры выстраиваются лесенкой (каждая следующая чуть выше), а не скачут.
	popupStack = (popupStack + 1) % 4
	anchor.CFrame = CFrame.new(position + Vector3.new(0, popupStack * 0.7, 0))
	anchor.Parent = workspace
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(220, 60)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 120
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.TextSize = size
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.15
	label.TextStrokeColor3 = rgb(20, 16, 24)
	label.Text = text
	label.Parent = gui
	local scale = Instance.new("UIScale")
	scale.Scale = 0.3
	scale.Parent = label
	tween(scale, 0.18, { Scale = 1.15 }, Enum.EasingStyle.Back)
	task.delay(0.18, function()
		tween(scale, 0.12, { Scale = 1 })
	end)
	tween(gui, duration, { StudsOffsetWorldSpace = Vector3.new(0, rise * 0.6, 0) }, Enum.EasingStyle.Quart)
	task.delay(duration * 0.55, function()
		tween(label, duration * 0.45, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
	Debris:AddItem(anchor, duration + 0.1)
end

-- Красная вспышка Highlight поверх модели.
local function flash(model, color)
	if not model or not model.Parent then
		return
	end
	local old = model:FindFirstChild("GladeFlash")
	if old then
		old:Destroy()
	end
	local highlight = Instance.new("Highlight")
	highlight.Name = "GladeFlash"
	highlight.FillColor = color or rgb(255, 40, 40)
	highlight.OutlineColor = rgb(255, 255, 255)
	highlight.FillTransparency = 0.25
	highlight.OutlineTransparency = 0.3
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Adornee = model
	highlight.Parent = model
	tween(highlight, 0.35, { FillTransparency = 1, OutlineTransparency = 1 })
	Debris:AddItem(highlight, 0.4)
end

-- Искры из неоновых кубиков в точке попадания.
local function sparks(position, color, count)
	for _ = 1, count do
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Material = Enum.Material.Neon
		p.Color = color
		p.Size = Vector3.new(0.25, 0.25, 0.25)
		p.CFrame = CFrame.new(position) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
		p.Parent = workspace
		local dir = Vector3.new(math.random() - 0.5, math.random() * 0.8, math.random() - 0.5).Unit * (2 + math.random() * 2)
		tween(p, 0.35, { CFrame = p.CFrame + dir, Size = Vector3.new(0.05, 0.05, 0.05), Transparency = 1 })
		Debris:AddItem(p, 0.4)
	end
end

-- Кольцо-волна (уровень, удар Стража).
local function ring(position, color, diameter, duration)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Transparency = 0.2
	p.Size = Vector3.new(0.2, 1, 1)
	p.CFrame = CFrame.new(position) * Models.UPRIGHT
	p.Parent = workspace
	tween(p, duration, { Size = Vector3.new(0.2, diameter, diameter), Transparency = 1 })
	Debris:AddItem(p, duration + 0.05)
end

-- След меча: Trail между двумя Attachment на клинке, включается на время взмаха.
local function swordTrail(character, duration)
	local gear = character:FindFirstChild("GladeGear")
	local weapon = gear and gear:FindFirstChild("Weapon")
	local blade = weapon and weapon:FindFirstChild("Blade")
	if not blade then
		return
	end
	local trail = blade:FindFirstChild("GladeTrail")
	if not trail then
		local a0 = Instance.new("Attachment")
		a0.Name = "TrailA"
		a0.Position = Vector3.new(0, 0, blade.Size.Z / 2)
		a0.Parent = blade
		local a1 = Instance.new("Attachment")
		a1.Name = "TrailB"
		a1.Position = Vector3.new(0, 0, -blade.Size.Z / 2 - 0.5)
		a1.Parent = blade
		trail = Instance.new("Trail")
		trail.Name = "GladeTrail"
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Lifetime = 0.18
		trail.LightEmission = 0.8
		trail.FaceCamera = true
		trail.Transparency = NumberSequence.new(0.2, 1)
		trail.Color = ColorSequence.new(Models.SwordTrailColor(weapon:GetAttribute("ItemId")))
		trail.Enabled = false
		trail.Parent = blade
	end
	trail.Enabled = true
	task.delay(duration, function()
		if trail.Parent then
			trail.Enabled = false
		end
	end)
end

local function playSwing(character, style)
	if not character or not character.Parent then
		return
	end
	local length = Animator.PlayOn(character, style, 1) or 0.35
	if style == "SwordSlash1" or style == "SwordSlash2" then
		swordTrail(character, math.min(length, 0.4))
	end
end

-- Локальный предикт удара: анимация без ожидания сервера.
function Effects.LocalSwing(style)
	lastLocalSwing = os.clock()
	playSwing(player.Character, style)
end

function handlers.Swing(character, style)
	-- Свой удар уже проигран предиктом.
	if isLocal(character) and os.clock() - lastLocalSwing < 0.6 then
		return
	end
	playSwing(character, style)
end

function handlers.Damage(model, position, amount, crit, userId)
	if not model then
		return
	end
	local mine = userId == player.UserId
	local text = Rules.FormatNumber(amount)
	if crit then
		popup(position, "КРИТ! " .. text, rgb(255, 150, 40), mine and 34 or 22, 5, 1.1)
	else
		popup(position, text, mine and rgb(255, 240, 120) or rgb(210, 210, 210), mine and 26 or 18, 4, 0.9)
	end
	flash(model, rgb(255, 60, 60))
	sparks(position, crit and rgb(255, 170, 60) or rgb(255, 255, 200), crit and 10 or 5)
	local clip = model.Name == "Slime" and "SlimeHit" or "HitReact"
	local ctrl = Animator.Get(model)
	if ctrl and not (ctrl:IsBusy() and ctrl.Clip ~= clip and ctrl.Clip ~= "GuardianWalk" and ctrl.Clip ~= "SlimeBounce" and ctrl.Clip ~= "MobIdle" and ctrl.Clip ~= "SlimeIdle" and ctrl.Clip ~= model:GetAttribute("IdleClip") and ctrl.Clip ~= model:GetAttribute("WalkClip")) then
		ctrl:Play(clip, 1)
	end
end

function handlers.Loot(position, reward)
	if type(reward) ~= "table" then
		return
	end
	local offset = 0
	if (reward.Coins or 0) > 0 then
		popup(position + Vector3.new(0, offset, 0), "+" .. Rules.FormatNumber(reward.Coins) .. " монет", rgb(255, 210, 70), 22, 5, 1.4)
		offset = offset + 1.2
		-- Монетки летят к игроку.
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		for i = 1, math.min(6, math.max(2, math.floor(reward.Coins / 5))) do
			local coin = Instance.new("Part")
			coin.Shape = Enum.PartType.Cylinder
			coin.Size = Vector3.new(0.15, 0.7, 0.7)
			coin.Anchored = true
			coin.CanCollide = false
			coin.CanQuery = false
			coin.CanTouch = false
			coin.Material = Enum.Material.Neon
			coin.Color = rgb(255, 205, 60)
			coin.CFrame = CFrame.new(position + Vector3.new((math.random() - 0.5) * 3, 1, (math.random() - 0.5) * 3))
			coin.Parent = workspace
			local up = tween(coin, 0.3, { CFrame = coin.CFrame + Vector3.new(0, 2.5, 0) }, Enum.EasingStyle.Quad)
			up.Completed:Connect(function()
				if root and root.Parent then
					tween(coin, 0.25 + i * 0.04, { CFrame = root.CFrame, Size = Vector3.new(0.05, 0.2, 0.2) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				end
			end)
			Debris:AddItem(coin, 0.9 + i * 0.05)
		end
	end
	if (reward.XP or 0) > 0 then
		popup(position + Vector3.new(0, offset, 0), "+" .. Rules.FormatNumber(reward.XP) .. " XP", rgb(130, 200, 255), 18, 5, 1.4)
		offset = offset + 1.1
	end
	if type(reward.Items) == "table" then
		for _, itemId in ipairs(reward.Items) do
			local def = Config.Items[itemId]
			if def then
				local rarity = Config.Rarities[def.Rarity]
				popup(position + Vector3.new(0, offset, 0), "📦 " .. def.Name, rarity and rarity.Color or rgb(255, 255, 255), 20, 6, 2)
				offset = offset + 1.2
			end
		end
	end
end

function handlers.LevelUp(character, level)
	if not character or not character.Parent then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root then
		popup(root.Position + Vector3.new(0, 4, 0), "УРОВЕНЬ " .. tostring(level) .. "!", rgb(120, 255, 160), 32, 6, 2.2)
		ring(root.Position - Vector3.new(0, 2.8, 0), rgb(120, 255, 160), 16, 0.8)
		sparks(root.Position, rgb(120, 255, 160), 16)
	end
	flash(character, rgb(120, 255, 160))
	Animator.PlayOn(character, "Cheer", 1)
end

function handlers.MobDied(model)
	if not model or not model.Parent then
		return
	end
 model:SetAttribute("MobDead",true)
 Animator.PlayOn(model,"MobDeath",1)
 local root = model.PrimaryPart
 if root then
  sparks(root.Position, model.Name == "Slime" and rgb(120, 230, 100) or rgb(150, 220, 255), 14)
	end
	for _, item in ipairs(model:GetDescendants()) do
		if item:IsA("BasePart") and item.Transparency < 1 then
			task.delay(0.35,function()
    if item.Parent then tween(item, 0.65, { Transparency = 1 }) end
   end)
   -- Independent local shards tumble without altering server collision or rewards.
   if item.Name ~= "HumanoidRootPart" and math.random() < 0.22 then
    local shard = Instance.new("Part")
    shard.Size, shard.CFrame, shard.Color, shard.Material = item.Size*0.35,item.CFrame,item.Color,item.Material
    shard.Anchored, shard.CanCollide, shard.CanQuery, shard.CanTouch = true,false,false,false
    shard.Parent = workspace
    tween(shard,0.9,{CFrame=shard.CFrame*CFrame.Angles(1.4,0.7,1.2)+Vector3.new(math.random(-4,4),-2,math.random(-4,4)),Transparency=1})
    Debris:AddItem(shard,1)
   end
		elseif item:IsA("BillboardGui") then
			item.Enabled = false
		end
	end
end

function handlers.MobAttack(model, mobId, clip)
	if not model or not model.Parent then
		return
	end
	Animator.PlayOn(model, clip, 1)
	if mobId == "Guardian" and clip == "GuardianSlam" and model.PrimaryPart then
		local def = Config.Mobs[mobId]
		task.delay(def and def.AttackWindup or 0.5, function()
			if model.PrimaryPart then
				ring(model.PrimaryPart.Position - Vector3.new(0, def.HipHeight or 3, 0), rgb(150, 220, 255), 14, 0.5)
			end
		end)
	end
end

-- Светящийся снаряд мага: летит от fromPos к toPos со скоростью speed (стад/с), затем вспышка.
function handlers.Projectile(fromPos, toPos, color, speed)
	color = color or rgb(120, 220, 255)
	local distance = (toPos - fromPos).Magnitude
	local duration = math.max(0.1, distance / math.max(speed or 60, 1))
	local orb = Instance.new("Part")
	orb.Shape = Enum.PartType.Ball
	orb.Anchored = true
	orb.CanCollide = false
	orb.CanQuery = false
	orb.CanTouch = false
	orb.Material = Enum.Material.Neon
	orb.Color = color
	orb.Size = Vector3.new(1.2, 1.2, 1.2)
	orb.CFrame = CFrame.new(fromPos)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 12
	light.Brightness = 2
	light.Parent = orb
	orb.Parent = workspace
	tween(orb, duration, { CFrame = CFrame.new(toPos) }, Enum.EasingStyle.Linear)
	task.spawn(function()
		local elapsed = 0
		while elapsed < duration and orb.Parent do
			sparks(orb.Position, color, 1)
			elapsed += 0.06
			task.wait(0.06)
		end
		if orb.Parent then
			sparks(toPos, color, 8)
			ring(toPos, color, 5, 0.3)
		end
		orb:Destroy()
	end)
	Debris:AddItem(orb, duration + 0.5)
end

function handlers.Summon(position, color)
	color = color or rgb(190, 120, 255)
	ring(position + Vector3.new(0, 0.3, 0), color, 16, 0.7)
	ring(position + Vector3.new(0, 0.3, 0), color, 9, 0.5)
	sparks(position + Vector3.new(0, 1, 0), color, 18)
end

function handlers.BossImpact(position, radius)
 ring(position,rgb(255,154,60),radius*2,0.55)
 sparks(position,rgb(255,186,92),24)
 local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
 if root and (root.Position-position).Magnitude<75 then Effects.Shake(0.4,0.8) end
end

function handlers.PlayerHit(character, damage)
	if not character or not character.Parent then
		return
	end
	flash(character, rgb(255, 40, 40))
	local root = character:FindFirstChild("HumanoidRootPart")
	if root then
		popup(root.Position + Vector3.new(0, 2, 0), "-" .. Rules.FormatNumber(damage), rgb(255, 80, 80), isLocal(character) and 26 or 18, 4, 0.9)
	end
	Animator.PlayOn(character, "HitReact", 1)
	if isLocal(character) then
		Effects.Shake(0.25, 0.35)
	end
end

-- Лёгкая тряска камеры при получении урона.
function Effects.Shake(duration, strength)
	local camera = workspace.CurrentCamera
	local stop = os.clock() + duration
	task.spawn(function()
		while os.clock() < stop do
			local k = (stop - os.clock()) / duration * strength
			camera.CFrame = camera.CFrame * CFrame.Angles((math.random() - 0.5) * 0.02 * k, (math.random() - 0.5) * 0.02 * k, 0)
			task.wait()
		end
	end)
end

function Effects.Handle(kind, ...)
	local handler = handlers[kind]
	if handler then
		local ok, err = pcall(handler, ...)
		if not ok then
			warn("[GladeSlayer] FX " .. tostring(kind) .. ": " .. tostring(err))
		end
	end
end

-- Фоновые анимации: ходьба мобов и «работа» NPC.
function Effects.Start()
	task.spawn(function()
		while true do
			task.wait(0.15)
			local mobs = workspace:FindFirstChild("GladeSlayerMobs")
			if mobs then
				for _, model in ipairs(mobs:GetChildren()) do
					local humanoid = model:FindFirstChildOfClass("Humanoid")
					local root = model.PrimaryPart
					if humanoid and root and humanoid.Health > 0 and not model:GetAttribute("MobDead") then
      local localRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
      if localRoot and (localRoot.Position-root.Position).Magnitude<210 then
       local moving = (root.AssemblyLinearVelocity*Vector3.new(1,0,1)).Magnitude>1.5
       local ctrl = Animator.Get(model)
       local idleAttr = model:GetAttribute("IdleClip")
       local walkAttr = model:GetAttribute("WalkClip")
       local idle = ctrl.Clip == "MobIdle" or ctrl.Clip == "SlimeIdle" or (idleAttr ~= nil and ctrl.Clip == idleAttr)
       local walking = ctrl.Clip == "GuardianWalk" or ctrl.Clip == "SlimeBounce" or (walkAttr ~= nil and ctrl.Clip == walkAttr)
       local clip
       if moving then
        clip = walkAttr or (model.Name=="Slime" and "SlimeBounce" or "GuardianWalk")
       else
        clip = idleAttr or (model.Name=="Slime" and "SlimeIdle" or "MobIdle")
       end
       if not ctrl:IsBusy() or (moving and idle and ctrl.Clip ~= clip) or (not moving and walking and ctrl.Clip ~= clip) then
        ctrl:Play(clip, model:GetAttribute("Phase")==2 and 1.2 or 1)
       end
      end
     end
				end
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(2.6)
			local npcs = workspace:FindFirstChild("GladeSlayerNPCs")
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if npcs then
				for _, model in ipairs(npcs:GetChildren()) do
					local kind = model:GetAttribute("NPC")
					local ctrl = Animator.Get(model)
					if ctrl and not ctrl:IsBusy() then
						if kind == "Blacksmith" then
							ctrl:Play("Hammer", 1)
						elseif kind == "Merchant" and root and model.PrimaryPart and (root.Position - model.PrimaryPart.Position).Magnitude < 22 and math.random() < 0.5 then
							ctrl:Play("Wave", 1)
						end
					end
				end
			end
		end
	end)
end

return Effects
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">Guide</string><ProtectedString name="Source"><![CDATA[-- GladeSlayer: навигация гайда новичка. Светящийся 3D-луч (Beam) от персонажа к цели текущего шага
-- и парящая стрелка-маркер над целью. Всё создаётся только на клиенте и не влияет на сервер.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GladeSlayer")
local Config = require(Shared:WaitForChild("Config"))

local Guide = {}

local player = Players.LocalPlayer
local rgb = Color3.fromRGB
local BEAM_COLOR = rgb(255, 214, 90)
local MAX_DISTANCE = 600 -- дальше (другой остров, подземелье) луч не показываем

local target = nil
local holder = nil
local beam, playerAttachment, goalAttachment, marker, markerParts = nil, nil, nil, nil, {}

local function neon(parent, name, size, color, shape, className)
	local p = Instance.new(className or "Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.Neon
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	if shape then
		p.Shape = shape
	end
	p.Parent = parent
	return p
end

local function ensureWorld()
	if holder and holder.Parent then
		return
	end
	holder = Instance.new("Folder")
	holder.Name = "GladeGuide"
	holder.Parent = workspace
	local anchor = neon(holder, "GuideGoal", Vector3.new(0.2, 0.2, 0.2), BEAM_COLOR)
	anchor.Transparency = 1
	goalAttachment = Instance.new("Attachment")
	goalAttachment.Parent = anchor
	-- Маркер: светящееся кольцо на земле и стрелка-«наконечник» над целью.
	marker = Instance.new("Model")
	marker.Name = "GuideMarker"
	marker.Parent = holder
	markerParts = {
		Ring = neon(marker, "Ring", Vector3.new(0.2, 9, 9), BEAM_COLOR, Enum.PartType.Cylinder),
		Shaft = neon(marker, "Shaft", Vector3.new(0.9, 3, 0.9), BEAM_COLOR),
		HeadA = neon(marker, "HeadA", Vector3.new(0.9, 1.6, 1.4), BEAM_COLOR, nil, "WedgePart"),
		HeadB = neon(marker, "HeadB", Vector3.new(0.9, 1.6, 1.4), BEAM_COLOR, nil, "WedgePart"),
	}
	markerParts.Ring.Transparency = 0.45
	local light = Instance.new("PointLight")
	light.Color = BEAM_COLOR
	light.Range = 14
	light.Brightness = 2
	light.Parent = markerParts.Shaft
end

local function ensureBeam(root)
	if beam and beam.Parent and playerAttachment and playerAttachment.Parent == root then
		return
	end
	if beam then
		beam:Destroy()
	end
	if playerAttachment then
		playerAttachment:Destroy()
	end
	playerAttachment = Instance.new("Attachment")
	playerAttachment.Name = "GuideFrom"
	playerAttachment.Position = Vector3.new(0, -2.4, 0)
	playerAttachment.Parent = root
	beam = Instance.new("Beam")
	beam.Name = "GuideBeam"
	beam.Attachment0 = playerAttachment
	beam.Attachment1 = goalAttachment
	beam.Color = ColorSequence.new(BEAM_COLOR, rgb(255, 255, 255))
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.FaceCamera = true
	beam.Width0 = 0.7
	beam.Width1 = 0.7
	beam.Segments = 24
	beam.CurveSize0 = 6
	beam.CurveSize1 = -6
	-- Текстура «искры» прокручивается вдоль луча: получается бегущий пунктир к цели.
	beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	beam.TextureMode = Enum.TextureMode.Static
	beam.TextureLength = 3
	beam.TextureSpeed = 1.6
	beam.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.8),
		NumberSequenceKeypoint.new(0.15, 0.1),
		NumberSequenceKeypoint.new(1, 0.05),
	})
	beam.Parent = root
end

local function hide()
	if beam then
		beam.Enabled = false
	end
	if marker then
		for _, p in pairs(markerParts) do
			p.Transparency = 1
		end
		local light = markerParts.Shaft and markerParts.Shaft:FindFirstChildOfClass("PointLight")
		if light then
			light.Enabled = false
		end
	end
end

-- Принимает состояние профиля от сервера и выбирает цель текущего шага гайда.
function Guide.SetState(state)
	if type(state) ~= "table" then
		return
	end
	local step = Config.Tutorial.Steps[state.Tutorial or 0]
	target = step and step.Target or nil
end

RunService.Heartbeat:Connect(function()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not target or not root or (root.Position - target).Magnitude > MAX_DISTANCE then
		hide()
		return
	end
	ensureWorld()
	ensureBeam(root)
	local t = os.clock()
	local ground = Vector3.new(target.X, Config.GroundY, target.Z)
	goalAttachment.Parent.CFrame = CFrame.new(ground + Vector3.new(0, 1, 0))
	local near = (Vector3.new(root.Position.X, Config.GroundY, root.Position.Z) - ground).Magnitude < 10
	beam.Enabled = not near
	local bob = math.sin(t * 3) * 0.8
	local top = ground + Vector3.new(0, 9 + bob, 0)
	markerParts.Ring.CFrame = CFrame.new(ground + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.rad(90)) * CFrame.Angles(t, 0, 0)
	markerParts.Ring.Transparency = 0.35 + 0.25 * math.sin(t * 4)
	local spin = CFrame.Angles(0, t * 2, 0)
	markerParts.Shaft.CFrame = CFrame.new(top + Vector3.new(0, 1.5, 0)) * spin
	-- Наконечник смотрит вниз: два клина спинами друг к другу, острием к земле.
	local head = CFrame.new(top - Vector3.new(0, 0.8, 0)) * spin * CFrame.Angles(math.rad(180), 0, 0)
	markerParts.HeadA.CFrame = head * CFrame.new(0, 0, -0.7)
	markerParts.HeadB.CFrame = head * CFrame.new(0, 0, 0.7) * CFrame.Angles(0, math.rad(180), 0)
	for _, name in ipairs({ "Shaft", "HeadA", "HeadB" }) do
		markerParts[name].Transparency = 0
	end
	local light = markerParts.Shaft:FindFirstChildOfClass("PointLight")
	if light then
		light.Enabled = true
	end
end)

return Guide
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">IconRenderer</string><ProtectedString name="Source"><![CDATA[-- GladeSlayer: настоящие 3D-иконки через ViewportFrame + WorldModel + Camera.
-- Предметы рендерятся теми же процедурными моделями, что и в мире (Models.BuildItem);
-- для кнопок HUD собираются отдельные мини-модели: сундук, кристалл силы, тёмный портал с черепом, компас.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GladeSlayer")
local Config = require(Shared:WaitForChild("Config"))
local Models = require(Shared:WaitForChild("Models"))

local IconRenderer = {}

local V3 = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local RAD = math.rad
local M = Enum.Material
local rgb = Color3.fromRGB

local templates = {}
local spinning = {}

local function part(model, size, cframe, color, material, shape, className)
	local p = Instance.new(className or "Part")
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		p.Shape = shape
	end
	p.Parent = model
	return p
end

-- Равнобедренный треугольник (наконечник стрелы, шип короны) из двух клиньев: острие вверх, плоскость X-Y.
-- У WedgePart прямой угол на задней (+Z) грани, поэтому две половинки ставятся спинами к центру.
local function spike(model, width, height, cframe, color, material)
	local group = cframe * ANG(0, RAD(90), 0)
	part(model, V3(0.14, height, width / 2), group * CF(0, 0, -width / 4), color, material, nil, "WedgePart")
	part(model, V3(0.14, height, width / 2), group * CF(0, 0, width / 4) * ANG(0, RAD(180), 0), color, material, nil, "WedgePart")
end

local HUD_BUILDERS = {}

function HUD_BUILDERS.Inventory()
	local model = Instance.new("Model")
	local wood, trim, dark = rgb(150, 98, 52), rgb(255, 204, 80), rgb(96, 60, 32)
	part(model, V3(3.2, 1.8, 2), CF(0, 0, 0), wood, M.WoodPlanks)
	-- Цилиндр Roblox вытянут по X: полукруглая крышка вдоль сундука, нижняя половина спрятана в корпусе.
	part(model, V3(3.2, 2, 2), CF(0, 0.9, 0), wood, M.WoodPlanks, Enum.PartType.Cylinder)
	for _, x in ipairs({ -1.25, 0, 1.25 }) do
		part(model, V3(0.22, 1.86, 2.06), CF(x, 0, 0), trim, M.Metal)
		part(model, V3(0.24, 2.08, 2.08), CF(x, 0.9, 0), trim, M.Metal, Enum.PartType.Cylinder)
	end
	part(model, V3(3.26, 0.2, 2.06), CF(0, -0.85, 0), dark, M.Wood)
	part(model, V3(0.6, 0.7, 0.2), CF(0, 0.55, -1.05), trim, M.Metal)
	part(model, V3(0.18, 0.26, 0.08), CF(0, 0.5, -1.17), rgb(40, 30, 20), M.Metal)
	part(model, V3(0.5, 0.5, 0.5), CF(0, 1.2, -0.6), rgb(120, 230, 255), M.Neon, Enum.PartType.Ball)
	part(model, V3(0.35, 0.35, 0.35), CF(0.8, 1.05, -0.7), rgb(255, 220, 90), M.Neon, Enum.PartType.Ball)
	return model, V3(0.55, 0.45, -1)
end

function HUD_BUILDERS.Stats()
	local model = Instance.new("Model")
	local violet, green = rgb(170, 120, 255), rgb(110, 240, 140)
	-- Кристалл: два вытянутых ромба, повёрнутых друг к другу.
	part(model, V3(1.3, 1.3, 1.3), CF(-0.5, 0.2, 0) * ANG(0, RAD(45), 0) * ANG(RAD(45), 0, RAD(35)), violet, M.Neon)
	part(model, V3(1, 2.6, 1), CF(-0.5, 0.2, 0) * ANG(0, RAD(45), 0), violet, M.Glass).Transparency = 0.25
	part(model, V3(1.6, 0.4, 1.6), CF(-0.5, -1.3, 0) * ANG(0, RAD(45), 0), rgb(90, 80, 130), M.Slate)
	-- Стрелка вверх.
	part(model, V3(0.5, 1.9, 0.5), CF(1.2, -0.2, -0.2), green, M.Neon)
	spike(model, 1.5, 1.1, CF(1.2, 1.3, -0.2), green, M.Neon)
	local light = Instance.new("PointLight")
	light.Color = violet
	light.Parent = model:FindFirstChildWhichIsA("BasePart")
	return model, V3(0.25, 0.25, -1)
end

function HUD_BUILDERS.Dungeons()
	local model = Instance.new("Model")
	local stone, glow, bone, gold = rgb(70, 66, 84), rgb(170, 70, 255), rgb(236, 230, 214), rgb(255, 200, 70)
	for _, x in ipairs({ -1.5, 1.5 }) do
		part(model, V3(0.7, 3.6, 0.8), CF(x, 0, 0.5), stone, M.Slate)
	end
	part(model, V3(4, 0.7, 0.9), CF(0, 2, 0.5), stone, M.Slate)
	part(model, V3(2.3, 3.4, 0.2), CF(0, 0.1, 0.55), glow, M.Neon).Transparency = 0.15
	-- Череп с короной перед порталом.
	part(model, V3(1.6, 1.6, 1.6), CF(0, -0.4, -0.6), bone, M.SmoothPlastic, Enum.PartType.Ball)
	part(model, V3(1, 0.5, 0.9), CF(0, -1.15, -0.8), bone, M.SmoothPlastic)
	for _, x in ipairs({ -0.35, 0.35 }) do
		part(model, V3(0.42, 0.42, 0.2), CF(x, -0.3, -1.35), rgb(20, 10, 30), M.SmoothPlastic, Enum.PartType.Ball)
		part(model, V3(0.16, 0.16, 0.16), CF(x, -0.3, -1.45), rgb(255, 80, 80), M.Neon, Enum.PartType.Ball)
	end
	part(model, V3(1.5, 0.3, 1.4), CF(0, 0.45, -0.6), gold, M.Metal)
	for _, x in ipairs({ -0.55, 0, 0.55 }) do
		spike(model, 0.42, 0.6, CF(x, 0.88, -1.25), gold, M.Metal)
	end
	return model, V3(0.3, 0.2, -1)
end

function HUD_BUILDERS.Teleports()
	local model = Instance.new("Model")
	local gold, face = rgb(255, 196, 70), rgb(246, 240, 222)
	local facing = ANG(0, RAD(90), 0)
	part(model, V3(0.4, 3.4, 3.4), CF(0, 0, 0) * facing, gold, M.Metal, Enum.PartType.Cylinder)
	part(model, V3(0.42, 2.9, 2.9), CF(0, 0, -0.02) * facing, face, M.SmoothPlastic, Enum.PartType.Cylinder)
	part(model, V3(0.5, 0.5, 0.5), CF(0, 1.9, 0), gold, M.Metal, Enum.PartType.Ball)
	spike(model, 0.5, 1.2, CF(0, 0.6, -0.25), rgb(235, 60, 60), M.Neon)
	spike(model, 0.5, 1.2, CF(0, -0.6, -0.25) * ANG(0, 0, RAD(180)), rgb(70, 130, 255), M.Neon)
	part(model, V3(0.3, 0.3, 0.3), CF(0, 0, -0.3), gold, M.Metal, Enum.PartType.Ball)
	for i = 0, 3 do
		local a = i * math.pi / 2
		part(model, V3(0.12, 0.35, 0.05), CF(math.sin(a) * 1.2, math.cos(a) * 1.2, -0.25) * ANG(0, 0, -a), rgb(60, 50, 40), M.SmoothPlastic)
	end
	return model, V3(0.35, 0.3, -1)
end

function HUD_BUILDERS.Shop()
	local model = Instance.new("Model")
	local facing = ANG(0, RAD(90), 0)
	part(model, V3(0.4, 3, 3), CF(0, 0, 0) * facing, rgb(255, 200, 60), M.Metal, Enum.PartType.Cylinder)
	part(model, V3(0.44, 2.3, 2.3), CF(0, 0, 0) * facing, rgb(230, 170, 40), M.Metal, Enum.PartType.Cylinder)
	part(model, V3(0.4, 3, 3), CF(0.6, -0.7, 0.8) * facing * ANG(RAD(10), 0, 0), rgb(255, 214, 90), M.Metal, Enum.PartType.Cylinder)
	return model, V3(0.4, 0.3, -1)
end

local function makeViewport(parent, props)
	local viewport = Instance.new("ViewportFrame")
	viewport.Name = "Icon3D"
	viewport.BackgroundTransparency = 1
	viewport.Size = UDim2.fromScale(1, 1)
	viewport.Ambient = rgb(140, 140, 156)
	viewport.LightColor = rgb(255, 246, 228)
	viewport.LightDirection = V3(-0.8, -1.3, 0.9)
	for key, value in pairs(props or {}) do
		viewport[key] = value
	end
	local world = Instance.new("WorldModel")
	world.Parent = viewport
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	viewport.Parent = parent
	return viewport, world, camera
end

-- Камера отъезжает так, чтобы описанная сфера модели целиком влезла в кадр.
local function frameCamera(model, camera, direction, zoom)
	local cframe, size = model:GetBoundingBox()
	local radius = size.Magnitude / 2
	local distance = radius / math.tan(RAD(camera.FieldOfView / 2)) * (zoom or 1)
	camera.CFrame = CFrame.lookAt(cframe.Position + direction.Unit * distance, cframe.Position)
	return cframe.Position
end

local function anchorAll(model)
	for _, item in ipairs(model:GetDescendants()) do
		if item:IsA("BasePart") then
			item.Anchored = true
			item.CanCollide = false
			item.CanQuery = false
			item.CanTouch = false
		elseif item:IsA("Script") or item:IsA("LocalScript") then
			item:Destroy()
		end
	end
	return model
end

local function itemTemplate(itemId)
	local cached = templates[itemId]
	if cached then
		return cached.Model, cached.Direction
	end
	local def = Config.Items[itemId]
	local model = def and Models.BuildItem(itemId)
	if not model then
		return nil
	end
	anchorAll(model)
	local direction = V3(0.5, 0.4, -1)
	if def.Kind == "Gear" and def.Slot == "Weapon" then
		-- Клинок вдоль -Z: ставим его по диагонали остриём вверх-вправо, плашмя к камере.
		model:PivotTo(ANG(0, 0, RAD(-45)) * ANG(RAD(90), 0, 0))
		direction = V3(0.12, 0.08, -1)
	elseif def.Kind == "Gear" then
		model:PivotTo(ANG(0, RAD(-20), 0))
		direction = V3(0.2, 0.25, -1)
	end
	templates[itemId] = { Model = model, Direction = direction }
	return model, direction
end

-- 3D-иконка предмета. props — свойства ViewportFrame (Position, Size, ZIndex ...).
function IconRenderer.Item(parent, itemId, props)
	local template, direction = itemTemplate(itemId)
	local viewport, world, camera = makeViewport(parent, props)
	if template then
		local model = template:Clone()
		model.Parent = world
		frameCamera(model, camera, direction, 1.02)
	end
	return viewport
end

-- 3D-иконка кнопки HUD: Inventory, Stats, Dungeons, Teleports, Shop.
function IconRenderer.Hud(parent, kind, props)
	local builder = HUD_BUILDERS[kind] or HUD_BUILDERS.Inventory
	local model, direction = builder()
	local viewport, world, camera = makeViewport(parent, props)
	model.Parent = world
	frameCamera(model, camera, direction, 1)
	return viewport
end

-- Медленное вращение модели вокруг вертикали (превью в карточке предмета, наведение на кнопку HUD).
function IconRenderer.Spin(viewport, speed)
	if speed and speed ~= 0 then
		local world = viewport:FindFirstChildOfClass("WorldModel")
		local model = world and world:FindFirstChildOfClass("Model")
		if model then
			spinning[viewport] = { Model = model, Speed = speed, Base = model:GetPivot(), Center = model:GetBoundingBox().Position, Angle = 0 }
		end
	else
		local entry = spinning[viewport]
		if entry then
			entry.Model:PivotTo(entry.Base)
		end
		spinning[viewport] = nil
	end
end

RunService.RenderStepped:Connect(function(dt)
	for viewport, entry in pairs(spinning) do
		if not viewport.Parent or not entry.Model.Parent then
			spinning[viewport] = nil
		else
			entry.Angle = entry.Angle + dt * entry.Speed
			local center = CF(entry.Center)
			entry.Model:PivotTo(center * ANG(0, entry.Angle, 0) * center:Inverse() * entry.Base)
		end
	end
end)

return IconRenderer
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">Icons</string><ProtectedString name="Source"><![CDATA[-- Resolution-independent layered icons. No uploaded textures or emoji dependency.
local Icons = {}
local rgb = Color3.fromRGB
local function frame(parent,x,y,w,h,color,rotation,radius)
 local f = Instance.new("Frame")
 f.AnchorPoint = Vector2.new(0.5,0.5)
 f.Position, f.Size = UDim2.fromScale(x,y), UDim2.fromScale(w,h)
 f.Rotation, f.BackgroundColor3, f.BorderSizePixel = rotation or 0,color,0
 f.Parent = parent
 if radius then
  local c=Instance.new("UICorner")
  c.CornerRadius=UDim.new(radius,0)
  c.Parent=f
 end
 return f
end
local function stroke(p,color,thickness)
 local s=Instance.new("UIStroke")
 s.Color,s.Thickness,s.Parent=color,thickness or 1.5,p
end
function Icons.ItemKind(def)
 if not def then return "Crystal" end
 if def.Slot == "Weapon" then return "Sword" end
 if def.Slot == "Armor" then return "Armor" end
 if def.Slot == "Accessory" then return "Charm" end
 if def.Kind == "Potion" then return "Potion" end
 if def.Name == "Древняя монета" or def.Name == "Царский скарабей" then return "Coin" end
 return "Crystal"
end
function Icons.Draw(parent,kind,color,position,size)
 local root=Instance.new("Frame")
 root.Name="VectorIcon_"..kind
 root.BackgroundColor3=color or rgb(130,170,210)
 root.BorderSizePixel=0
 root.Position=position or UDim2.fromScale(0,0)
 root.Size=size or UDim2.fromScale(1,1)
 root.Parent=parent
 local c=Instance.new("UICorner")
 c.CornerRadius=UDim.new(0.2,0)
 c.Parent=root
 local gradient=Instance.new("UIGradient")
 gradient.Color=ColorSequence.new(Color3.new(1,1,1),rgb(70,78,109))
 gradient.Rotation=55
 gradient.Parent=root
 stroke(root,root.BackgroundColor3:Lerp(Color3.new(1,1,1),0.4),1)
 local ink=rgb(247,248,255)
 local shade=rgb(67,73,99)
 if kind=="Sword" or kind=="Damage" then
  frame(root,0.56,0.38,0.13,0.52,ink,35,0.1)
  frame(root,0.60,0.36,0.035,0.42,rgb(174,220,255),35)
  frame(root,0.40,0.62,0.42,0.085,rgb(255,217,119),35,0.15)
  frame(root,0.33,0.74,0.11,0.20,shade,35,0.1)
  frame(root,0.27,0.83,0.13,0.1,rgb(255,222,145),35,0.2)
 elseif kind=="Health" then
  frame(root,0.40,0.38,0.29,0.32,ink,0,1)
  frame(root,0.61,0.38,0.29,0.32,ink,0,1)
  frame(root,0.5,0.53,0.37,0.37,ink,45,0.1)
  frame(root,0.39,0.34,0.11,0.07,rgb(255,202,210),-30,1)
 elseif kind=="Regen" or kind=="Stats" then
  frame(root,0.5,0.5,0.18,0.65,ink,0,0.12)
  frame(root,0.5,0.5,0.65,0.18,ink,0,0.12)
  frame(root,0.5,0.5,0.12,0.12,rgb(163,255,215),45)
 elseif kind=="Speed" then
  for _,x in ipairs({0.35,0.65}) do
   frame(root,x,0.38,0.12,0.35,ink,-40,0.1)
   frame(root,x,0.62,0.12,0.35,ink,40,0.1)
  end
 elseif kind=="Inventory" then
  local handle=frame(root,0.5,0.24,0.32,0.25,shade,0,0.3)
  stroke(handle,ink,2)
  frame(root,0.5,0.55,0.60,0.60,ink,0,0.2)
  frame(root,0.5,0.67,0.40,0.19,shade,0,0.2)
  frame(root,0.5,0.43,0.09,0.15,rgb(255,215,114),0,0.2)
 elseif kind=="Teleport" then
  local outer=frame(root,0.5,0.5,0.61,0.77,shade,0,1)
  stroke(outer,ink,2)
  local inner=frame(root,0.5,0.5,0.34,0.54,root.BackgroundColor3:Lerp(ink,0.4),0,1)
  stroke(inner,rgb(205,235,255),1)
  frame(root,0.5,0.5,0.12,0.30,ink,35,0.2)
 elseif kind=="Shop" then
  frame(root,0.5,0.62,0.62,0.43,ink,0,0.08)
  frame(root,0.5,0.36,0.74,0.22,rgb(255,225,147),0,0.1)
  for _,x in ipairs({0.25,0.50,0.75}) do frame(root,x,0.36,0.10,0.22,shade) end
  frame(root,0.5,0.66,0.18,0.34,shade,0,0.06)
 elseif kind=="Armor" then
  frame(root,0.5,0.5,0.52,0.58,ink,0,0.18)
  frame(root,0.24,0.35,0.22,0.24,ink,25,0.15)
  frame(root,0.76,0.35,0.22,0.24,ink,-25,0.15)
  frame(root,0.5,0.49,0.26,0.32,shade,0,0.15)
  frame(root,0.5,0.68,0.52,0.08,rgb(255,215,133))
 elseif kind=="Charm" then
  local chain=frame(root,0.5,0.40,0.55,0.51,shade,0,1)
  stroke(chain,rgb(255,221,135),2)
  frame(root,0.5,0.68,0.28,0.28,ink,45,0.12)
  frame(root,0.5,0.68,0.15,0.15,root.BackgroundColor3,45,0.12)
 elseif kind=="Potion" then
  frame(root,0.5,0.57,0.49,0.53,ink,0,0.35)
  frame(root,0.5,0.65,0.38,0.26,root.BackgroundColor3,0,0.3)
  frame(root,0.5,0.30,0.20,0.25,ink,0,0.1)
  frame(root,0.5,0.20,0.27,0.09,rgb(210,170,101),0,0.1)
 elseif kind=="Coin" then
  local coin=frame(root,0.5,0.5,0.66,0.66,rgb(255,211,86),0,1)
  stroke(coin,rgb(255,239,171),2)
  frame(root,0.5,0.5,0.16,0.36,rgb(164,113,49),0,0.15)
 else
  frame(root,0.5,0.5,0.42,0.59,ink,25,0.12)
  frame(root,0.4,0.4,0.13,0.39,rgb(183,230,255),25,0.1)
  frame(root,0.72,0.7,0.18,0.27,ink,40,0.1)
 end
 return root
end
return Icons
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX0000001B"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- GladeSlayer: точка входа клиента. Ввод (ЛКМ/тап — удар, I — инвентарь, K — прокачка, J — подземелья,
-- T — телепорты), подписка на Remotes, полоска ХП, гайд новичка, автозакрытие магазина при уходе от NPC.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GladeSlayer")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(script.Parent:WaitForChild("UI"))
local Effects = require(script.Parent:WaitForChild("Effects"))
local Guide = require(script.Parent:WaitForChild("Guide"))

local player = Players.LocalPlayer
local remoteFolder = Shared:WaitForChild("Remotes")
local Remotes = {}
for _, name in ipairs({ "Attack", "State", "FX", "OpenShop", "Toast", "Request", "Dungeon" }) do
	Remotes[name] = remoteFolder:WaitForChild(name)
end

-- Удар: локальная анимация сразу, урон считает сервер (он же проверяет кулдаун и дистанцию).
local lastAttack = 0
local comboIndex = 0
local function attack()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	local armed = (character:GetAttribute("Weapon") or "") ~= ""
	local cooldown = armed and Config.Combat.SwordCooldown or Config.Combat.FistCooldown
	local now = os.clock()
	if now - lastAttack < cooldown then
		return
	end
	lastAttack = now
	comboIndex = comboIndex + 1
	local style
	if armed then
		style = comboIndex % 2 == 1 and "SwordSlash1" or "SwordSlash2"
	else
		style = comboIndex % 2 == 1 and "PunchRight" or "PunchLeft"
	end
	Effects.LocalSwing(style)
	Remotes.Attack:FireServer()
end

UI.Init(Remotes, attack)
Effects.Start()

Remotes.State.OnClientEvent:Connect(function(state)
	UI.SetState(state)
	Guide.SetState(state)
end)
Remotes.Toast.OnClientEvent:Connect(UI.Toast)
Remotes.OpenShop.OnClientEvent:Connect(UI.OpenShop)
Remotes.FX.OnClientEvent:Connect(Effects.Handle)
Remotes.Dungeon.OnClientEvent:Connect(UI.SetDungeon)

-- Горячие клавиши окон; B и C оставлены для тех, кто привык к прежней раскладке.
local PANEL_KEYS = {
	[Enum.KeyCode.I] = "Inventory", [Enum.KeyCode.B] = "Inventory",
	[Enum.KeyCode.K] = "Stats", [Enum.KeyCode.C] = "Stats",
	[Enum.KeyCode.J] = "Dungeons",
	[Enum.KeyCode.T] = "Teleports",
}

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		local position = UserInputService:GetMouseLocation()
		for _, object in ipairs(player.PlayerGui:GetGuiObjectsAtPosition(position.X, position.Y)) do
			if object:IsA("GuiButton") or object:IsA("ScrollingFrame") or object:IsA("TextBox") then
				return
			end
		end
		attack()
	elseif PANEL_KEYS[input.KeyCode] then
		UI.Toggle(PANEL_KEYS[input.KeyCode])
	elseif input.KeyCode == Enum.KeyCode.ButtonR2 then
		attack()
	end
end)

-- Полоска ХП следует за текущим персонажем.
local function onCharacter(character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid then
		return
	end
	local function update()
		UI.SetHealth(humanoid.Health, humanoid.MaxHealth)
	end
	humanoid.HealthChanged:Connect(update)
	humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(update)
	update()
end
player.CharacterAdded:Connect(onCharacter)
if player.Character then
	task.spawn(onCharacter, player.Character)
end

-- Магазин закрывается, если игрок отошёл от торговца (сервер всё равно проверяет дистанцию).
task.spawn(function()
	while true do
		task.wait(0.5)
		local shop = UI.CurrentShop()
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local npc = shop and Config.NPC[shop]
		if npc and root and (root.Position - npc.Position).Magnitude > Config.ShopDistance then
			UI.Close()
		end
	end
end)

-- Первичная синхронизация (сервер ответит событием State).
task.spawn(function()
	pcall(function()
		Remotes.Request:InvokeServer("Sync")
	end)
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001C"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[-- GladeSlayer: весь интерфейс создаётся кодом — HUD (ХП с плавным «следом», XP, монеты, баффы),
-- окна Прокачки, Инвентаря, Скупщика и Кузницы, тосты. UICorner/UIStroke/UIGradient + анимации TweenService.
-- Клиент только отображает состояние и шлёт запросы; все проверки делает сервер.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GladeSlayer")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("Rules"))

local Icons = require(script.Parent:WaitForChild("Icons"))
local IconRenderer = require(script.Parent:WaitForChild("IconRenderer"))
local UI = {}

local player = Players.LocalPlayer
local rgb = Color3.fromRGB
local remotes = nil
local state = nil
local gui = nil
local panels = {}
local currentPanel = nil
local currentShop = nil
local selectedItem = nil
local shopTab = Config.ShopTabs[1].Id
local refs = {}
local buffEnds = {}
local onAttack = nil
local lastCoins = nil
local lastLevel = nil
local lastHealth = nil
local hpRatio = 1
local inventoryFilter = "All"
local discardConfirmUntil = 0
local refreshDetails
local bossSmoothRatio = 1
local dungeon = nil
local dungeonReceivedAt = 0
local skipConfirmUntil = 0
local tutorialHighlight = nil
local DOCK = {
	{ Id = "Inventory", Name = "Инвентарь", Panel = "Inventory", Color = rgb(70, 170, 130) },
	{ Id = "Stats", Name = "Прокачка", Panel = "Stats", Color = rgb(120, 110, 220) },
	{ Id = "Dungeons", Name = "Данжи", Panel = "Dungeons", Color = rgb(150, 70, 200) },
	{ Id = "Teleports", Name = "Телепорты", Panel = "Teleports", Color = rgb(68, 143, 185) },
}

local THEME = {
	Panel = rgb(26, 28, 40),
	PanelLight = rgb(38, 42, 58),
	Card = rgb(44, 48, 66),
	Stroke = rgb(90, 100, 140),
	Text = rgb(240, 242, 250),
	Muted = rgb(160, 166, 190),
	Accent = rgb(110, 170, 255),
	Gold = rgb(255, 205, 70),
	Green = rgb(90, 210, 120),
	Red = rgb(235, 80, 80),
	Gray = rgb(90, 94, 110),
}
local TOAST_COLORS = { info = THEME.Accent, success = THEME.Green, error = THEME.Red, loot = THEME.Gold }

-- Конструкторы ----------------------------------------------------------------------------------
local function new(className, props, parent)
	local object = Instance.new(className)
	for key, value in pairs(props or {}) do
		object[key] = value
	end
	if parent then
		object.Parent = parent
	end
	return object
end

local function corner(parent, radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 10) }, parent)
end

local function stroke(parent, color, thickness, transparency)
	return new("UIStroke", { Color = color or THEME.Stroke, Thickness = thickness or 1.5, Transparency = transparency or 0.3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, parent)
end

local function gradient(parent, top, bottom, rotation)
	return new("UIGradient", { Color = ColorSequence.new(top, bottom), Rotation = rotation or 90 }, parent)
end

local function label(parent, text, size, props)
	local l = new("TextLabel", {
		BackgroundTransparency = 1,
		Text = text or "",
		TextSize = size or 16,
		Font = Enum.Font.GothamBold,
		TextColor3 = THEME.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
	}, parent)
	for key, value in pairs(props or {}) do
		l[key] = value
	end
	return l
end

local function tween(object, time, props, style, direction)
	local t = TweenService:Create(object, TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function button(parent, text, color, callback, props)
	local b = new("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = color or THEME.Accent,
		Text = text,
		TextSize = 15,
		Font = Enum.Font.GothamBold,
		TextColor3 = rgb(255, 255, 255),
	}, parent)
	for key, value in pairs(props or {}) do
		b[key] = value
	end
	corner(b, 8)
	gradient(b, rgb(255, 255, 255), rgb(200, 200, 210), 90)
	stroke(b, rgb(255, 255, 255), 1, 0.75)
	local scale = new("UIScale", { Scale = 1 }, b)
	b.MouseEnter:Connect(function()
		tween(scale, 0.12, { Scale = 1.05 })
	end)
	b.MouseLeave:Connect(function()
		tween(scale, 0.12, { Scale = 1 })
	end)
	b.MouseButton1Down:Connect(function()
		tween(scale, 0.06, { Scale = 0.94 })
	end)
	b.MouseButton1Up:Connect(function()
		tween(scale, 0.1, { Scale = 1.05 })
	end)
 b.Activated:Connect(function()
  if refs.ClickSound then refs.ClickSound:Play() end
  if callback then callback() end
 end)
	return b
end

local function clear(container)
	for _, child in ipairs(container:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIGridLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
end

local function itemColor(itemId)
	local def = Config.Items[itemId]
	local rarity = def and Config.Rarities[def.Rarity]
	return rarity and rarity.Color or THEME.Text, rarity and rarity.Name or ""
end

local function count(itemId)
	if not state then
		return 0
	end
	return state.Inventory[itemId] or 0
end

local function free(itemId)
	if not state then
		return 0
	end
	return Rules.FreeCount(state, itemId)
end

local function isEquipped(itemId)
	if not state then
		return nil
	end
	for _, slot in ipairs(Config.Slots) do
		if state.Equipped[slot] == itemId then
			return slot
		end
	end
	return nil
end

-- Запрос на сервер: ответ показывается тостом, новое состояние придёт через State.
local function request(action, a, b)
	task.spawn(function()
		local ok, okResult, message = pcall(function()
			return remotes.Request:InvokeServer(action, a, b)
		end)
		if not ok then
			UI.Toast("Нет связи с сервером.", "error")
			return
		end
		if type(message) == "string" and message ~= "" then
			UI.Toast(message, okResult and "success" or "error")
		end
	end)
end

-- Окна ------------------------------------------------------------------------------------------
local function makePanel(name, title, size, accent)
	local root = new("CanvasGroup", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = size,
		BackgroundColor3 = THEME.Panel,
		GroupTransparency = 1,
		Visible = false,
	}, gui)
	corner(root, 16)
	gradient(root, rgb(255, 255, 255), rgb(170, 176, 200), 90)
	local outline = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 5 }, root)
	corner(outline, 16)
	stroke(outline, accent or THEME.Accent, 2, 0.2)
	local scale = new("UIScale", { Scale = 0.85 }, root)
	local header = new("Frame", { BackgroundColor3 = accent or THEME.Accent, Size = UDim2.new(1, 0, 0, 48) }, root)
	gradient(header, rgb(255, 255, 255), rgb(150, 150, 170), 90)
	label(header, title, 22, { Font = Enum.Font.GothamBlack, Position = UDim2.fromOffset(18, 0), Size = UDim2.new(1, -80, 1, 0), TextStrokeTransparency = 0.6 })
	button(header, "✕", THEME.Red, function()
		UI.Close()
	end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(34, 34), TextSize = 18 })
	local body = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 58), Size = UDim2.new(1, -28, 1, -70) }, root)
	panels[name] = { Root = root, Scale = scale, Body = body }
	return body
end

local function scroller(parent, props, grid)
	local s = new("ScrollingFrame", {
		BackgroundColor3 = THEME.PanelLight,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = THEME.Stroke,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
	}, parent)
	for key, value in pairs(props or {}) do
		s[key] = value
	end
	corner(s, 10)
	new("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, s)
	if grid then
		new("UIGridLayout", { CellSize = grid, CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }, s)
	else
		new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, s)
	end
	return s
end

local function card(parent, height, order)
	local c = new("Frame", { BackgroundColor3 = THEME.Card, Size = UDim2.new(1, -4, 0, height), LayoutOrder = order or 0 }, parent)
	corner(c, 10)
	stroke(c, THEME.Stroke, 1, 0.6)
	return c
end

-- Прокачка ---------------------------------------------------------------------------------------
local function buildStats()
	local body = makePanel("Stats", "⚡ Прокачка", UDim2.fromOffset(560, 470), rgb(120, 110, 255))
	refs.StatPoints = label(body, "", 17, { Size = UDim2.new(1, 0, 0, 24), TextColor3 = THEME.Gold })
	label(body, "Очки навыков дают за каждый новый уровень. Стоимость растёт с уровнем характеристики.", 13, { Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 20), TextColor3 = THEME.Muted, Font = Enum.Font.GothamMedium })
	refs.StatList = scroller(body, { Position = UDim2.fromOffset(0, 50), Size = UDim2.new(1, 0, 1, -50) })
end

local function refreshStats()
	if not state or not refs.StatList then
		return
	end
	refs.StatPoints.Text = "Очки навыков: " .. state.SkillPoints .. "   •   Уровень " .. state.Level
	clear(refs.StatList)
	for index, statId in ipairs(Config.StatOrder) do
		local def = Config.Stats[statId]
		local level = state.Stats[statId] or 0
		local maxed = level >= def.MaxLevel
		local cost = Rules.UpgradeCost(level)
		local c = card(refs.StatList, 78, index)
		local icon = new("Frame", { BackgroundColor3 = def.Color, Position = UDim2.fromOffset(10, 13), Size = UDim2.fromOffset(52, 52) }, c)
		corner(icon, 12)
		gradient(icon, rgb(255, 255, 255), rgb(150, 150, 150), 45)
		Icons.Draw(icon,statId,def.Color)
		label(c, def.Name .. "  ур. " .. level .. "/" .. def.MaxLevel, 17, { Position = UDim2.fromOffset(74, 8), Size = UDim2.new(1, -210, 0, 22) })
		local now = Rules.FormatStat(statId, Rules.StatValue(statId, level))
		local nextText = maxed and "МАКС" or Rules.FormatStat(statId, Rules.StatValue(statId, level + 1))
		label(c, now .. "  →  " .. nextText, 15, { Position = UDim2.fromOffset(74, 30), Size = UDim2.new(1, -210, 0, 20), TextColor3 = def.Color })
		label(c, def.Description, 12, { Position = UDim2.fromOffset(74, 50), Size = UDim2.new(1, -210, 0, 20), TextColor3 = THEME.Muted, Font = Enum.Font.GothamMedium })
		local affordable = not maxed and state.SkillPoints >= cost
		local b = button(c, maxed and "МАКС" or ("+  (" .. cost .. " оч.)"), affordable and THEME.Green or THEME.Gray, function()
			if maxed then
				return
			end
			request("Upgrade", statId)
		end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(118, 42) })
		b.Active = not maxed
	end
end

-- Инвентарь -------------------------------------------------------------------------------------
local function buildInventory()
	local body = makePanel("Inventory", "🎒 Инвентарь", UDim2.fromOffset(700, 480), rgb(90, 180, 140))
	refs.SlotRow = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -230, 0, 64) }, body)
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) }, refs.SlotRow)
	refs.Grid = scroller(body, { Position = UDim2.fromOffset(0, 120), Size = UDim2.new(1, -230, 1, -120) }, UDim2.fromOffset(96, 104))
	local details = new("Frame", { BackgroundColor3 = THEME.PanelLight, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, 218, 1, 0) }, body)
	corner(details, 10)
	stroke(details, THEME.Stroke, 1, 0.5)
 refs.Details = details
 refs.Filter = button(body,"Фильтр: все",THEME.Gray,function()
  local order={"All","Gear","Potion","Junk","Rare"}
  inventoryFilter=order[(table.find(order,inventoryFilter) or 1)%#order+1]
  local names={All="все",Gear="экипировка",Potion="зелья",Junk="мусор",Rare="редкие+"}
  refs.Filter.Text="Фильтр: "..names[inventoryFilter]
  UI.Refresh()
 end,{Position=UDim2.fromOffset(0,72),Size=UDim2.fromOffset(202,36),TextSize=13})
 refs.Discard = button(body,"Удалить мусор",THEME.Red,function()
  if os.clock()>discardConfirmUntil then
   discardConfirmUntil=os.clock()+4
   refs.Discard.Text="Точно удалить?"
   UI.Toast("Ещё раз в течение 4 секунд: удалить дешёвый мусор без монет. Надетое и редкие материалы защищены.","info")
   task.delay(4,function() if os.clock()>=discardConfirmUntil and refs.Discard then refs.Discard.Text="Удалить мусор" end end)
  else
   discardConfirmUntil=0
   refs.Discard.Text="Удалить мусор"
   request("DiscardJunk")
  end
 end,{Position=UDim2.fromOffset(210,72),Size=UDim2.fromOffset(218,36),TextSize=13})
end

local function itemCell(parent, itemId, amount, order, equippedSlot)
	local color = itemColor(itemId)
	local def = Config.Items[itemId]
	local cell = new("TextButton", { AutoButtonColor = false, Text = "", BackgroundColor3 = rgb(255, 255, 255), LayoutOrder = order }, parent)
	corner(cell, 10)
	local s = stroke(cell, color, selectedItem == itemId and 3 or 1.5, selectedItem == itemId and 0 or 0.25)
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	-- Градиент редкости: светлый цвет редкости сверху, тёмный низ под подписью.
	gradient(cell, color:Lerp(rgb(255, 255, 255), 0.25), THEME.Panel, 90)
	IconRenderer.Item(cell, itemId, { Position = UDim2.fromOffset(6, 4), Size = UDim2.new(1, -12, 0, 60) })
	label(cell, def and def.Name or itemId, 11, { Position = UDim2.fromOffset(4, 64), Size = UDim2.new(1, -8, 0, 36), TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center, TextColor3 = color:Lerp(rgb(255, 255, 255), 0.35), ZIndex = 2 })
	new("UIStroke", { Color = rgb(10, 10, 16), Thickness = 1.4, Transparency = 0.1 }, cell:FindFirstChildOfClass("TextLabel"))
	if amount and amount > 1 then
		local badge = label(cell, "x" .. amount, 13, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 2), Size = UDim2.fromOffset(40, 16), TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 3 })
		new("UIStroke", { Color = rgb(10, 10, 16), Thickness = 1.4 }, badge)
	end
	if equippedSlot then
		local badge = new("Frame", { BackgroundColor3 = THEME.Green, Position = UDim2.fromOffset(4, 4), Size = UDim2.fromOffset(16, 16) }, cell)
		corner(badge, 5)
		label(badge, "E", 12, { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center })
	end
	cell.MouseEnter:Connect(function()
  selectedItem = itemId
  if refreshDetails then refreshDetails() end
 end)
 cell.Activated:Connect(function()
  selectedItem = itemId
  if refs.ClickSound then refs.ClickSound:Play() end
  if def and def.Kind=="Gear" then
   local slot=isEquipped(itemId)
   if slot then request("Unequip",slot) else request("Equip",itemId) end
  end
  UI.Refresh()
 end)
	return cell
end

refreshDetails = function()
	local d = refs.Details
	clear(d)
	local def = selectedItem and Config.Items[selectedItem]
	if not def or count(selectedItem) <= 0 then
		label(d, "Выбери предмет, чтобы увидеть описание.", 14, { Position = UDim2.fromOffset(12, 12), Size = UDim2.new(1, -24, 0, 60), TextColor3 = THEME.Muted, Font = Enum.Font.GothamMedium })
		return
	end
	local color, rarityName = itemColor(selectedItem)
	label(d, def.Name, 19, { Font = Enum.Font.GothamBlack, Position = UDim2.fromOffset(12, 10), Size = UDim2.new(1, -24, 0, 48), TextColor3 = color, TextYAlignment = Enum.TextYAlignment.Top })
	label(d, rarityName .. "  •  x" .. count(selectedItem), 13, { Position = UDim2.fromOffset(12, 58), Size = UDim2.new(1, -24, 0, 18), TextColor3 = THEME.Muted })
	label(d, def.Description or "", 13, { Font = Enum.Font.GothamMedium, Position = UDim2.fromOffset(12, 80), Size = UDim2.new(1, -24, 0, 90), TextYAlignment = Enum.TextYAlignment.Top })
	label(d, Rules.BonusText(selectedItem), 14, { Position = UDim2.fromOffset(12, 172), Size = UDim2.new(1, -24, 0, 40), TextColor3 = THEME.Green, TextYAlignment = Enum.TextYAlignment.Top })
	label(d, "Скупщик даст: " .. Rules.FormatNumber(def.Sell or 0) .. " 🪙", 13, { Position = UDim2.fromOffset(12, 216), Size = UDim2.new(1, -24, 0, 18), TextColor3 = THEME.Gold })
	local preview = new("Frame", { BackgroundColor3 = rgb(255, 255, 255), Position = UDim2.fromOffset(12, 240), Size = UDim2.new(1, -24, 1, -306) }, d)
	corner(preview, 10)
	gradient(preview, color:Lerp(rgb(255, 255, 255), 0.2), THEME.Panel, 90)
	IconRenderer.Spin(IconRenderer.Item(preview, selectedItem), 0.9)
	local equippedSlot = isEquipped(selectedItem)
	local actionProps = { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Size = UDim2.new(1, -24, 0, 42) }
	if def.Kind == "Gear" then
		if equippedSlot then
			button(d, "Снять", THEME.Red, function()
				request("Unequip", equippedSlot)
			end, actionProps)
		else
			button(d, "Надеть", THEME.Green, function()
				request("Equip", selectedItem)
			end, actionProps)
		end
	elseif def.Kind == "Potion" then
		button(d, "Выпить", rgb(170, 110, 255), function()
			request("UsePotion", selectedItem)
		end, actionProps)
	else
		label(d, "Хлам: продай Скупщику на рынке.", 13, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Size = UDim2.new(1, -24, 0, 40), TextColor3 = THEME.Muted, TextXAlignment = Enum.TextXAlignment.Center })
	end
end

local function refreshInventory()
	if not state or not refs.Grid then
		return
	end
	clear(refs.SlotRow)
	for _, slot in ipairs(Config.Slots) do
		local itemId = state.Equipped[slot]
		local holder = new("TextButton", { AutoButtonColor = false, Text = "", BackgroundColor3 = THEME.PanelLight, Size = UDim2.fromOffset(136, 60) }, refs.SlotRow)
		corner(holder, 10)
		stroke(holder, itemId and itemColor(itemId) or THEME.Gray, 1.5, 0.2)
		label(holder, Config.SlotNames[slot], 12, { Position = UDim2.fromOffset(10, 6), Size = UDim2.new(1, -20, 0, 16), TextColor3 = THEME.Muted })
		label(holder, itemId and Config.Items[itemId].Name or "— пусто —", 14, { Position = UDim2.fromOffset(10, 24), Size = UDim2.new(1, -20, 0, 30), TextColor3 = itemId and itemColor(itemId) or THEME.Gray })
		holder.Activated:Connect(function()
			if itemId then
				selectedItem = itemId
				UI.Refresh()
			end
		end)
	end
	clear(refs.Grid)
	local order = 0
	for _, itemId in ipairs(Config.ItemOrder) do
		local amount = count(itemId)
  local def = Config.Items[itemId]
  local rarity = Config.Rarities[def.Rarity]
  local matches = inventoryFilter=="All" or (inventoryFilter=="Gear" and def.Kind=="Gear") or (inventoryFilter=="Potion" and def.Kind=="Potion") or (inventoryFilter=="Junk" and (def.Rarity=="Junk" or def.Junk)) or (inventoryFilter=="Rare" and rarity.Order>=4)
  if amount > 0 and matches then
   order = order + 1
			itemCell(refs.Grid, itemId, amount, order, isEquipped(itemId))
		end
	end
	if order == 0 then
		label(refs.Grid, "Пусто. Побей слизней!", 14, { Size = UDim2.fromOffset(200, 40), TextColor3 = THEME.Muted })
	end
	refreshDetails()
end

-- Скупщик ---------------------------------------------------------------------------------------
local function buildMerchant()
	local body = makePanel("Merchant", "💰 Скупщик", UDim2.fromOffset(580, 480), rgb(220, 170, 60))
	refs.JunkInfo = label(body, "", 15, { Size = UDim2.new(1, -230, 0, 44), TextColor3 = THEME.Gold })
	refs.SellAll = button(body, "Продать весь хлам", THEME.Green, function()
		request("SellAll")
	end, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(220, 44) })
	refs.SellList = scroller(body, { Position = UDim2.fromOffset(0, 54), Size = UDim2.new(1, 0, 1, -54) })
end

local function refreshMerchant()
	if not state or not refs.SellList then
		return
	end
	refs.JunkInfo.Text = "Хлам: " .. (state.JunkCount or 0) .. " шт. → " .. Rules.FormatNumber(state.JunkValue or 0) .. " 🪙\nНадетые вещи не продаются."
	clear(refs.SellList)
	local order = 0
	for _, itemId in ipairs(Config.ItemOrder) do
		local def = Config.Items[itemId]
		local amount = free(itemId)
		if def and amount > 0 and (def.Sell or 0) > 0 then
			order = order + 1
			local c = card(refs.SellList, 58, order)
			local color, rarityName = itemColor(itemId)
			local iconBack = new("Frame", { BackgroundColor3 = rgb(255, 255, 255), Position = UDim2.fromOffset(6, 5), Size = UDim2.fromOffset(48, 48) }, c)
			corner(iconBack, 8)
			gradient(iconBack, color:Lerp(rgb(255, 255, 255), 0.25), THEME.Panel, 90)
			IconRenderer.Item(iconBack, itemId)
			label(c, def.Name .. "  x" .. amount, 16, { Position = UDim2.fromOffset(62, 6), Size = UDim2.new(1, -300, 0, 24), TextColor3 = color })
			label(c, rarityName .. "  •  " .. Rules.FormatNumber(def.Sell) .. " 🪙 за шт.", 13, { Position = UDim2.fromOffset(62, 30), Size = UDim2.new(1, -300, 0, 20), TextColor3 = THEME.Muted })
			button(c, "Продать 1", THEME.Accent, function()
				request("Sell", itemId, 1)
			end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -124, 0.5, 0), Size = UDim2.fromOffset(104, 38) })
			button(c, "Все (" .. Rules.FormatNumber(def.Sell * amount) .. ")", THEME.Green, function()
				request("Sell", itemId, amount)
			end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(108, 38) })
		end
	end
	if order == 0 then
		label(refs.SellList, "Нечего продавать. Возвращайся с добычей!", 14, { Size = UDim2.new(1, 0, 0, 40), TextColor3 = THEME.Muted })
	end
end

-- Кузница ----------------------------------------------------------------------------------------
local function tabMatches(tab, def)
	if tab.Filter == "Weapon" then
		return def.Kind == "Gear" and def.Slot == "Weapon"
	elseif tab.Filter == "Defense" then
		return def.Kind == "Gear" and def.Slot ~= "Weapon"
	end
	return def.Kind == "Potion"
end

local function buildBlacksmith()
	local body = makePanel("Blacksmith", "⚒ Кузница и Алхимия", UDim2.fromOffset(600, 500), rgb(230, 110, 60))
	refs.Tabs = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40) }, body)
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) }, refs.Tabs)
	refs.ShopList = scroller(body, { Position = UDim2.fromOffset(0, 50), Size = UDim2.new(1, 0, 1, -50) })
end

local function refreshBlacksmith()
	if not state or not refs.ShopList then
		return
	end
	clear(refs.Tabs)
	local activeTab = Config.ShopTabs[1]
	for _, tab in ipairs(Config.ShopTabs) do
		if tab.Id == shopTab then
			activeTab = tab
		end
		button(refs.Tabs, tab.Name, tab.Id == shopTab and rgb(230, 110, 60) or THEME.Gray, function()
			shopTab = tab.Id
			UI.Refresh()
		end, { Size = UDim2.fromOffset(150, 36) })
	end
	clear(refs.ShopList)
	local order = 0
	for _, itemId in ipairs(Config.ShopOrder) do
		local def = Config.Items[itemId]
		if def and tabMatches(activeTab, def) then
			order = order + 1
			local c = card(refs.ShopList, 72, order)
			local color, rarityName = itemColor(itemId)
			local iconBack = new("Frame", { BackgroundColor3 = rgb(255, 255, 255), Position = UDim2.fromOffset(7, 7), Size = UDim2.fromOffset(58, 58) }, c)
			corner(iconBack, 9)
			gradient(iconBack, color:Lerp(rgb(255, 255, 255), 0.25), THEME.Panel, 90)
			IconRenderer.Item(iconBack, itemId)
			label(c, def.Name, 17, { Position = UDim2.fromOffset(74, 6), Size = UDim2.new(1, -232, 0, 22), TextColor3 = color })
			label(c, rarityName .. "  •  " .. Rules.BonusText(itemId), 13, { Position = UDim2.fromOffset(74, 28), Size = UDim2.new(1, -232, 0, 18), TextColor3 = THEME.Green })
			label(c, def.Description or "", 12, { Position = UDim2.fromOffset(74, 46), Size = UDim2.new(1, -232, 0, 20), TextColor3 = THEME.Muted, Font = Enum.Font.GothamMedium, TextTruncate = Enum.TextTruncate.AtEnd })
			local affordable = state.Coins >= (def.Price or 0)
			local owned = count(itemId)
			button(c, Rules.FormatNumber(def.Price or 0) .. " 🪙", affordable and THEME.Green or THEME.Gray, function()
				request("Buy", itemId)
			end, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8), Size = UDim2.fromOffset(140, 36) })
			label(c, owned > 0 and ("есть: " .. owned) or "", 12, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -10, 1, -4), Size = UDim2.fromOffset(140, 18), TextColor3 = THEME.Muted, TextXAlignment = Enum.TextXAlignment.Center })
		end
	end
end

-- HUD --------------------------------------------------------------------------------------------
-- Бегущий блик поверх полоски: белая полоса с прозрачными краями, Offset двигает animateHud.
local function shine(parent)
	local overlay = new("Frame", { Name = "Shine", BackgroundColor3 = rgb(255, 255, 255), BackgroundTransparency = 0, Size = UDim2.fromScale(1, 1), ZIndex = 2 }, parent)
	corner(overlay, 9)
	return new("UIGradient", {
		Rotation = 20,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.42, 1),
			NumberSequenceKeypoint.new(0.5, 0.55),
			NumberSequenceKeypoint.new(0.58, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Offset = Vector2.new(-1, 0),
	}, overlay)
end

-- «Пружинка»: резко увеличить UIScale и вернуть с отскоком.
local function pop(scale, amount)
	if not scale then
		return
	end
	scale.Scale = amount or 1.18
	tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
end

-- Всплывающая «+N» слева от элемента HUD (HUD монет прижат к правому краю экрана).
local function floatText(parent, text, color)
	local l = label(parent, text, 18, { Font = Enum.Font.GothamBlack, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(0, -8, 0.5, 0), Size = UDim2.fromOffset(120, 24), TextColor3 = color, TextStrokeTransparency = 0.3, TextWrapped = false, TextXAlignment = Enum.TextXAlignment.Right })
	tween(l, 0.9, { Position = UDim2.new(0, -8, 0.5, -26), TextTransparency = 1, TextStrokeTransparency = 1 }, Enum.EasingStyle.Quart)
	task.delay(0.95, function()
		l:Destroy()
	end)
end

-- Постоянные анимации HUD (один Heartbeat): блики полосок, пульс низкого ХП, мигание истекающих баффов.
local function animateHud()
	local t = os.clock()
	local sweep = (t * 0.45) % 2.2 - 1.1
	if refs.XPShine then
		refs.XPShine.Offset = Vector2.new(sweep, 0)
	end
	if refs.HPShine then
		refs.HPShine.Offset = Vector2.new(((t * 0.45 + 1.1) % 2.2) - 1.1, 0)
	end
	if refs.Vignette then
		local danger = hpRatio < 0.3 and hpRatio > 0
		local pulse = 0.5 + 0.5 * math.sin(t * (danger and 6 or 2))
		refs.Vignette.Transparency = danger and (0.25 + pulse * 0.45) or 1
	end
	if refs.Buffs then
		for _, chip in ipairs(refs.Buffs:GetChildren()) do
			local ends = buffEnds[chip.Name]
			local s = chip:FindFirstChildOfClass("UIStroke")
			if s and ends then
				s.Transparency = (ends - t < 10) and (0.5 + 0.5 * math.sin(t * 10)) or 0.1
			end
		end
	end
	if refs.LevelRing then
		refs.LevelRing.Rotation = (t * 60) % 360
	end
	-- Пульсация кнопки дока, которую требует текущий шаг гайда.
	if refs.DockButtons then
		local pulse = 0.5 + 0.5 * math.sin(t * 6)
		for id, entry in pairs(refs.DockButtons) do
			if entry.Glow then
				if tutorialHighlight == id and currentPanel ~= id then
					entry.Glow.Color = rgb(255, 220, 80)
					entry.Glow.Thickness = 2 + pulse * 3
					entry.Glow.Transparency = 0.1 * pulse
				else
					entry.Glow.Color = rgb(255, 255, 255)
					entry.Glow.Thickness = 1
					entry.Glow.Transparency = 0.75
				end
			end
		end
	end
end

local function buildHud()
	-- Монеты и очки навыков — справа сверху: левый верх занимает чат Roblox, верх — его топбар.
	local inset = GuiService:GetGuiInset()
	refs.TopY = math.max(inset.Y, 36) + 10
	local coins = new("Frame", { BackgroundColor3 = THEME.Panel, BackgroundTransparency = 0.1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, refs.TopY), Size = UDim2.fromOffset(210, 46) }, gui)
	corner(coins, 12)
	stroke(coins, THEME.Gold, 2, 0.2)
	gradient(coins, rgb(255, 255, 255), rgb(170, 170, 190), 90)
	label(coins, "🪙", 26, { Position = UDim2.fromOffset(10, 0), Size = UDim2.fromOffset(34, 46) })
	refs.Coins = label(coins, "0", 24, { Font = Enum.Font.GothamBlack, Position = UDim2.fromOffset(48, 0), Size = UDim2.new(1, -56, 1, 0), TextColor3 = THEME.Gold })
	refs.CoinFrame = coins
	refs.CoinScale = new("UIScale", { Scale = 1 }, coins)
	refs.CoinValue = new("NumberValue", { Value = 0 }, coins)
	refs.CoinValue.Changed:Connect(function(value)
		refs.Coins.Text = Rules.FormatNumber(math.floor(value + 0.5))
	end)
	local points = new("Frame", { BackgroundColor3 = THEME.Panel, BackgroundTransparency = 0.1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, refs.TopY + 52), Size = UDim2.fromOffset(210, 32) }, gui)
	corner(points, 10)
	stroke(points, rgb(140, 130, 255), 1.5, 0.3)
	refs.Points = label(points, "", 14, { Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -20, 1, 0), TextColor3 = rgb(190, 180, 255) })
	refs.PointsFrame = points

	-- Док-бар справа по центру: 3D-иконка, подпись с обводкой и бейдж горячей клавиши.
	local menu = new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -16, 0.55, 0), Size = UDim2.fromOffset(84, 4 * 92) }, gui)
	refs.Menu = menu
	refs.MenuScale = new("UIScale", { Scale = 1 }, menu)
	refs.MenuLayout = new("UIListLayout", { Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Right, SortOrder = Enum.SortOrder.LayoutOrder }, menu)
	refs.DockButtons = {}
	for index, data in ipairs(DOCK) do
		local target = data.Panel
		local b = button(menu, "", data.Color, function()
			UI.Toggle(target)
		end, { Size = UDim2.fromOffset(84, 84), LayoutOrder = index })
		corner(b, 16)
		b:FindFirstChildOfClass("UIGradient").Color = ColorSequence.new(rgb(255, 255, 255), rgb(120, 120, 140))
		local glow = b:FindFirstChildOfClass("UIStroke")
		local icon = IconRenderer.Hud(b, data.Id, { Position = UDim2.fromOffset(6, 2), Size = UDim2.new(1, -12, 1, -24) })
		local caption = label(b, data.Name, 12, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -3), Size = UDim2.new(1, -4, 0, 18), TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, Font = Enum.Font.GothamBlack, ZIndex = 3 })
		new("UIStroke", { Color = rgb(12, 12, 20), Thickness = 1.6 }, caption)
		local key = new("Frame", { BackgroundColor3 = rgb(250, 250, 255), Position = UDim2.fromOffset(-6, -6), Size = UDim2.fromOffset(24, 24), ZIndex = 4 }, b)
		corner(key, 6)
		stroke(key, rgb(20, 20, 30), 2, 0)
		label(key, Config.Hotkeys[data.Id] or "", 14, { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = rgb(20, 22, 34), Font = Enum.Font.GothamBlack, ZIndex = 5 })
		b.MouseEnter:Connect(function()
			IconRenderer.Spin(icon, 1.6)
		end)
		b.MouseLeave:Connect(function()
			IconRenderer.Spin(icon, 0)
		end)
		refs.DockButtons[data.Id] = { Button = b, Glow = glow, Caption = caption }
	end

	-- ХП и опыт (снизу по центру).
	local bars = new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -18), Size = UDim2.fromOffset(420, 64) }, gui)
	local level = new("Frame", { BackgroundColor3 = THEME.Panel, Position = UDim2.fromOffset(0, 8), Size = UDim2.fromOffset(56, 56) }, bars)
	corner(level, 28)
	local ring = stroke(level, rgb(255, 255, 255), 3, 0)
	refs.LevelRing = new("UIGradient", { Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, rgb(130, 200, 255)),
		ColorSequenceKeypoint.new(0.5, rgb(190, 140, 255)),
		ColorSequenceKeypoint.new(1, rgb(130, 200, 255)),
	}) }, ring)
	refs.LevelScale = new("UIScale", { Scale = 1 }, level)
	refs.Level = label(level, "1", 22, { Font = Enum.Font.GothamBlack, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center })
	local xp = new("Frame", { BackgroundColor3 = THEME.Panel, Position = UDim2.fromOffset(64, 8), Size = UDim2.new(1, -64, 0, 14) }, bars)
	corner(xp, 7)
	stroke(xp, THEME.Stroke, 1, 0.4)
