}
-- Призрак: быстрый двойной взмах когтями, удар на 0.4 с.
CLIPS.WraithSwipe = {
 key(0.2, "Quad", "Out", { Torso = {6,-20,0}, Head = {0,14,0}, RightArm = {100,-30,60}, LeftArm = {100,30,-60} }),
