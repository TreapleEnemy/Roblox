 corner(coinBack, 10)
 gradient(coinBack, THEME.Gold, THEME.Panel, 90)
 IconRenderer.Hud(coinBack, "Shop")
 label(shop, "Магазин и поддержка", 17, { Position = UDim2.fromOffset(84, 10), Size = UDim2.new(1, -235, 0, 26), TextColor3 = THEME.Gold })
 label(shop, "Кузница на рынке Поляны: оружие, броня, зелья", 13, { Position = UDim2.fromOffset(84, 38), Size = UDim2.new(1, -235, 0, 30), TextColor3 = THEME.Muted })
 button(shop, "Открыть", THEME.Gold, function()
  UI.Open("Shop")
 end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(128, 40) })
end
local function updateBoss(dt)
 if not refs.Boss then return end
 local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
 local mobs=workspace:FindFirstChild("GladeSlayerMobs")
 local best, humanoid, distance
 if root and mobs then
  distance=120
  for _, model in ipairs(mobs:GetChildren()) do
   local h=model:FindFirstChildOfClass("Humanoid")
   if model:GetAttribute("Boss") and model.PrimaryPart and h and h.Health>0 and not model:GetAttribute("MobDead") then
    local d=(model.PrimaryPart.Position-root.Position).Magnitude
    if d<distance then best,humanoid,distance=model,h,d end
   end
  end
 end
 refs.Boss.Visible=best~=nil
 if best then
  local ratio=humanoid.Health/humanoid.MaxHealth
  bossSmoothRatio=bossSmoothRatio+(ratio-bossSmoothRatio)*math.min(1,dt*9)
  refs.BossFill.Size=UDim2.fromScale(math.clamp(bossSmoothRatio,0,1),1)
  local def=Config.Mobs[best:GetAttribute("MobId")]
  refs.BossTitle.Text=(def and def.Name or best.Name).." • Фаза "..tostring(best:GetAttribute("Phase") or 1)
  refs.BossHealth.Text=math.ceil(humanoid.Health).." / "..math.floor(humanoid.MaxHealth)
 else bossSmoothRatio=1 end
 local camera=workspace.CurrentCamera
 if camera then
  local viewport=camera.ViewportSize
  local touch=UserInputService.TouchEnabled
  refs.Bars.Size=UDim2.fromOffset(math.min(420,viewport.X-32),64)
  refs.Toasts.Size=UDim2.fromOffset(math.min(460,viewport.X-24),220)
  -- Верхний центр: на узких экранах опускаем ниже плашек монет, чтобы не перекрывать их.
  local topCenter = viewport.X < 1000 and refs.TopY + 92 or refs.TopY
  local dungeonShown = refs.DungeonBar and refs.DungeonBar.Visible
  if refs.DungeonBar then
   refs.DungeonBar.Position = UDim2.new(0.5, 0, 0, topCenter)
   refs.DungeonBar.Size = UDim2.fromOffset(math.min(460, viewport.X - 32), 68)
  end
  refs.Boss.Size=UDim2.fromOffset(math.min(470,viewport.X-32),70)
  refs.Boss.Position=UDim2.new(0.5,0,0,topCenter + (dungeonShown and 76 or 0))
  refs.Toasts.Position=UDim2.new(0.5,0,0,topCenter + (dungeonShown and 76 or 0) + ((refs.Boss.Visible) and 78 or 0) + 6)
  -- Док справа: масштаб под высоту экрана, сверху — плашки монет, снизу — место под кнопку атаки на тач-экранах.
  local dockTop = refs.TopY + 96
  local dockRoom = viewport.Y - dockTop - (touch and 200 or 30)
  local dockHeight = #DOCK * 92
  local dockScale = math.clamp(dockRoom / dockHeight, 0.5, 1)
  refs.MenuScale.Scale = dockScale
  refs.Menu.AnchorPoint = Vector2.new(1, 0)
  refs.Menu.Position = UDim2.new(1, -16, 0, dockTop + math.max(0, (dockRoom - dockHeight * dockScale) / 2))
  if touch then
   refs.Buffs.AnchorPoint = Vector2.new(1, 0)
   refs.Buffs.Position = UDim2.new(1, -16 - 84 * dockScale - 12, 0, refs.TopY + 92)
   refs.BuffLayout.VerticalAlignment = Enum.VerticalAlignment.Top
   refs.BuffLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
   refs.Tutorial.AnchorPoint = Vector2.new(0, 0)
   refs.Tutorial.Position = UDim2.new(0, 16, 0, refs.TopY + 44)
  end
  local small = viewport.X < 760 or viewport.Y < 520
  refs.TutorialScale.Scale = small and 0.8 or 1
  refs.ControlsScale.Scale = math.min(1, (viewport.X - 24) / 640)
  for _,panel in pairs(panels) do
   local base=panel.Root.Size
   panel.TargetScale=math.min(1,(viewport.X-24)/base.X.Offset,(viewport.Y-80)/base.Y.Offset)
   if panel.Root.Visible and panel.Scale.Scale>panel.TargetScale+0.01 then panel.Scale.Scale=panel.TargetScale end
  end
 end
 if dungeon and dungeon.Active and refs.DungeonTimer then
  local left = math.max(0, (dungeon.TimeLeft or 0) - (os.clock() - dungeonReceivedAt))
  refs.DungeonTimer.Text = Rules.FormatTime(left)
  refs.DungeonTimer.TextColor3 = (left < 30 and dungeon.Stage ~= "Victory") and THEME.Red or THEME.Text
 end
end

-- Публичный API -----------------------------------------------------------------------------------
function UI.Init(remoteFolder, attackCallback)
	remotes = remoteFolder
	onAttack = attackCallback
	local playerGui = player:WaitForChild("PlayerGui")
	local old = playerGui:FindFirstChild("GladeSlayerUI")
	if old then
		old:Destroy()
	end
	gui = new("ScreenGui", { Name = "GladeSlayerUI", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, playerGui)
	buildHud()
	buildStats()
	buildInventory()
	buildMerchant()
 buildBlacksmith()
 buildExpansionPanels()
 buildUpdatePanels()
 refs.ClickSound = new("Sound",{Name="UIClick",SoundId="rbxasset://sounds/electronicpingshort.wav",Volume=0.25},gui)
 -- Выезд HUD при входе.
	refs.Bars.Position = UDim2.new(0.5, 0, 1, 120)
	tween(refs.Bars, 0.7, { Position = UDim2.new(0.5, 0, 1, -18) }, Enum.EasingStyle.Back)
	refs.CoinFrame.Position = UDim2.new(1, 240, 0, refs.TopY)
	tween(refs.CoinFrame, 0.6, { Position = UDim2.new(1, -16, 0, refs.TopY) }, Enum.EasingStyle.Back)
	local connection
	connection = RunService.Heartbeat:Connect(function(dt)
		if not gui.Parent then
			connection:Disconnect()
			return
		end
		animateHud()
  updateBoss(dt)
	end)
	task.spawn(function()
		while gui.Parent do
			updateBuffs()
			task.wait(0.25)
		end
	end)
end

function UI.Refresh()
	refreshHud()
	refreshTutorial()
	refreshDungeonBar()
	if currentPanel == "Stats" then
		refreshStats()
	elseif currentPanel == "Inventory" then
		refreshInventory()
	elseif currentPanel == "Teleports" then
  refreshTravel()
	elseif currentPanel == "Dungeons" then
		refreshDungeons()
	elseif currentPanel == "Merchant" then
		refreshMerchant()
	elseif currentPanel == "Blacksmith" then
		refreshBlacksmith()
	end
end

function UI.SetState(newState)
	if type(newState) ~= "table" then
		return
	end
	state = newState
	UI.Refresh()
end

function UI.SetHealth(health, maxHealth)
	if not refs.HPFill then
		return
	end
	local ratio = maxHealth > 0 and math.clamp(health / maxHealth, 0, 1) or 0
	hpRatio = ratio
	tween(refs.HPFill, 0.15, { Size = UDim2.fromScale(ratio, 1) })
	-- Получили урон: короткая тряска полоски ХП.
	if lastHealth and health < lastHealth - 0.5 and refs.HPFrame then
		local home = UDim2.fromOffset(64, 28)
		task.spawn(function()
			for i = 1, 5 do
				refs.HPFrame.Position = home + UDim2.fromOffset((i % 2 == 0 and 1 or -1) * (6 - i), 0)
				task.wait(0.03)
			end
			refs.HPFrame.Position = home
		end)
	end
	lastHealth = health
	-- «След» урона догоняет полоску с задержкой.
	task.delay(0.35, function()
		tween(refs.HPLag, 0.5, { Size = UDim2.fromScale(ratio, 1) })
	end)
	if ratio < 0.3 then
		refs.HPGradient.Color = ColorSequence.new(rgb(255, 110, 100), rgb(190, 40, 40))
	elseif ratio < 0.6 then
		refs.HPGradient.Color = ColorSequence.new(rgb(255, 220, 90), rgb(220, 150, 40))
	else
		refs.HPGradient.Color = ColorSequence.new(rgb(110, 230, 110), rgb(40, 160, 70))
	end
	refs.HPText.Text = "❤ " .. math.floor(health + 0.5) .. " / " .. math.floor(maxHealth + 0.5)
end

function UI.Open(name)
	local panel = panels[name]
	if not panel then
		return
	end
	if currentPanel and currentPanel ~= name then
		local old = panels[currentPanel]
		old.Root.Visible = false
		old.Root.GroupTransparency = 1
	end
	currentPanel = name
	if name == "Merchant" or name == "Blacksmith" then
		currentShop = name
	else
		currentShop = nil
	end
	UI.Refresh()
	panel.Root.Visible = true
	panel.Scale.Scale = (panel.TargetScale or 1)*0.85
	tween(panel.Scale, 0.28, { Scale = panel.TargetScale or 1 }, Enum.EasingStyle.Back)
	tween(panel.Root, 0.2, { GroupTransparency = 0 })
end

function UI.Close()
	if not currentPanel then
		return
	end
	local panel = panels[currentPanel]
	currentPanel = nil
	currentShop = nil
	tween(panel.Scale, 0.15, { Scale = (panel.TargetScale or 1)*0.9 })
	tween(panel.Root, 0.15, { GroupTransparency = 1 }).Completed:Connect(function()
		if panel.Root.GroupTransparency >= 0.99 then
			panel.Root.Visible = false
		end
	end)
end

function UI.Toggle(name)
	if currentPanel == name then
		UI.Close()
	else
		UI.Open(name)
	end
end

function UI.OpenShop(kind)
	if kind == "Merchant" or kind == "Blacksmith" or kind == "Dungeons" then
		UI.Open(kind)
	end
end

-- Состояние забега в подземелье от сервера (Remotes.Dungeon). Внутри арены свет приглушается локально.
function UI.SetDungeon(payload)
	if type(payload) ~= "table" then
		return
	end
	dungeon = payload
	dungeonReceivedAt = os.clock()
	local Lighting = game:GetService("Lighting")
	local tint = Lighting:FindFirstChild("GladeDungeonTint")
	if payload.Active then
		if not tint then
			tint = new("ColorCorrectionEffect", { Name = "GladeDungeonTint", Brightness = 0, Contrast = 0, Saturation = 0 }, Lighting)
			tween(tint, 1.2, { Brightness = -0.1, Contrast = 0.18, Saturation = -0.12 })
		end
		local def = Config.Dungeons[payload.Id]
		tint.TintColor = def and Color3.new(1, 1, 1):Lerp(def.Color, 0.12) or Color3.new(1, 1, 1)
	elseif tint then
		tween(tint, 0.8, { Brightness = 0, Contrast = 0, Saturation = 0 }).Completed:Connect(function()
			tint:Destroy()
		end)
	end
	-- Состояние приходит дважды в секунду: перестраиваем только индикатор, а не открытые окна.
	refreshDungeonBar()
	refreshTutorial()
	if currentPanel == "Dungeons" and payload.Stage ~= "Wave" and payload.Stage ~= "Boss" then
		refreshDungeons()
	end
end

function UI.InDungeon()
	return dungeon ~= nil and dungeon.Active == true
end

function UI.CurrentShop()
	return currentShop
end

function UI.Toast(text, kind)
	if not refs.Toasts or type(text) ~= "string" or text == "" then
		return
	end
	local color = TOAST_COLORS[kind] or THEME.Accent
	local toasts = {}
	for _, child in ipairs(refs.Toasts:GetChildren()) do
		if child:IsA("CanvasGroup") then
			table.insert(toasts, child)
		end
	end
	if #toasts >= 4 then
		toasts[1]:Destroy()
	end
	local toast = new("CanvasGroup", { BackgroundColor3 = THEME.Panel, Size = UDim2.new(1,-20,0,58), GroupTransparency = 1, LayoutOrder = math.floor(os.clock() * 100) }, refs.Toasts)
	corner(toast, 10)
	local bar = new("Frame", { BackgroundColor3 = color, Size = UDim2.new(0, 6, 1, 0) }, toast)
	corner(bar, 3)
	label(toast, text, 15, { Position = UDim2.fromOffset(16, 0), Size = UDim2.new(1, -24, 1, 0), TextXAlignment = Enum.TextXAlignment.Center })
	local outline = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, toast)
	corner(outline, 10)
	stroke(outline, color, 1.5, 0.2)
	local toastScale = new("UIScale", { Scale = 0.7 }, toast)
	tween(toastScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	tween(toast, 0.2, { GroupTransparency = 0 })
	task.delay(3.2, function()
		if toast.Parent then
			tween(toast, 0.35, { GroupTransparency = 1 }).Completed:Connect(function()
				toast:Destroy()
			end)
		end
	end)
end

return UI
