		key(0.32, "Sine", "InOut", {
			Torso = { 0, -4, 0 }, RightLeg = { -24, 0, 0 }, LeftLeg = { 24, 0, 0 },
			RightArm = { 16, 0, 6 }, LeftArm = { -16, 0, -6 },
		}),
	},
	-- NPC
	Hammer = {
		key(0.45, "Quad", "Out", {
			Torso = { 6, 0, 0 }, Head = { -8, 0, 0 },
			RightArm = { 150, 0, 10 }, LeftArm = { 20, 0, -8 },
		}),
		key(0.14, "Quad", "In", {
			Torso = { -8, 0, 0 }, Head = { -14, 0, 0 },
			RightArm = { 55, 0, 5 }, LeftArm = { 15, 0, -8 },
