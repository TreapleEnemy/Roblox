		hold(0.12),
		key(0.5, "Quad", "InOut"),
	},
	Wave = {
		key(0.25, "Back", "Out", { RightArm = { 10, 0, 150 }, Head = { 0, 10, 0 } }),
		key(0.18, "Sine", "InOut", { RightArm = { 10, 0, 125 }, Head = { 0, 10, 0 } }),
