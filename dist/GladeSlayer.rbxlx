		key(0.18, "Sine", "InOut", { Body = { 0, 0, 0, P = V3(0, -0.08, 0) } }, V3(1.08, 0.92, 1.08)),
		key(0.22, "Sine", "InOut", { Body = { -4, 0, 0, P = V3(0, 0.22, 0) } }, V3(0.96, 1.06, 0.96)),
